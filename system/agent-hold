#!/usr/bin/env python3
# Pull ALWAYS works (break-glass, never depends on lock/helper/agents); release fails safe; `release --force` overrides.
import os, stat, sys, tempfile
from datetime import datetime, timezone
from pathlib import Path
marker = Path("/etc/agent-hold")
def write_pull(reason):
    with tempfile.NamedTemporaryFile(mode='w', dir=marker.parent, delete=False) as stream:
        stream.write(f'drain jacopo {datetime.now(timezone.utc).isoformat()}: {reason}\n')
        os.fchmod(stream.fileno(), 0o644); os.fchown(stream.fileno(), 0, 0)
    os.replace(stream.name, marker)
def locked(exclusive):
    from task_hold_lock import marker_lock
    return marker_lock(marker, exclusive=exclusive)
try:
    args = sys.argv[1:]
    if args and os.geteuid() != 0: raise OSError('Use sudo agent-hold to pull or release Jacopo\'s hold')
    if args[:1] == ['pull'] and len(args) == 2 and args[1].strip():
        try:
            with locked(True): write_pull(args[1])
        except Exception as error:
            write_pull(args[1]); print(f'{marker}: pulled WITHOUT the shared lock (break-glass): {error}', file=sys.stderr)
    elif args == ['release', '--force']: marker.unlink(missing_ok=True)
    elif args == ['release']:
        with locked(True): marker.unlink(missing_ok=True)
    elif args: raise OSError('Usage: agent-hold [pull "reason" | release [--force]]')
    with (locked(False) if not args else open(os.devnull)):
        try: mode = marker.lstat().st_mode
        except FileNotFoundError: print(f'{marker}: no hold'); sys.exit(0)
        if not stat.S_ISREG(mode): raise OSError('not a regular file')
        with os.fdopen(os.open(marker, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)) as stream:
            if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode): raise OSError('not a regular file')
            print(f'{marker}: held (drain) {stream.read().strip()}')
except (OSError, UnicodeError, ImportError) as error:
    print(f'{marker}: held / cannot inspect or change hold: {error}', file=sys.stderr); sys.exit(1)
