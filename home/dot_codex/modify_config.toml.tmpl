#!/usr/bin/env python3
"""Enforce bootstrap config while retaining Codex's locally added project entries."""
import json
import sys
import tomllib

managed = '''{{ include ".chezmoitemplates/codex-config.toml" }}'''
current = tomllib.loads(sys.stdin.read())


def value(item):
    if isinstance(item, bool):
        return str(item).lower()
    if isinstance(item, dict):
        return "{ " + ", ".join(json.dumps(k) + " = " + value(v) for k, v in item.items()) + " }"
    if isinstance(item, list):
        return "[" + ", ".join(value(v) for v in item) + "]"
    return json.dumps(item, ensure_ascii=False)


print(managed.rstrip())
for project, settings in current.get("projects", {}).items():
    print("\n[projects." + json.dumps(project, ensure_ascii=False) + "]")
    for key, setting in settings.items():
        print(json.dumps(key) + " = " + value(setting))
