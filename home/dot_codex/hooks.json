{
  "description": "Workspace and host-boundary checks for the user-level agent tools.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.local/share/bootstrap/agent-policy/pre_tool_use.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.local/share/bootstrap/agent-policy/pre_tool_use.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
