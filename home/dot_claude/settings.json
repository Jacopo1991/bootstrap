{
  "env": {
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
  },
  "enabledPlugins": {
    "design@synced": false,
    "product-management@synced": false,
    "cowork-plugin-management@synced": false,
    "desktop-commander@synced": false
  },
  "deniedMcpServers": [
    { "serverName": "plugin:engineering:slack" },
    { "serverName": "plugin:engineering:linear" },
    { "serverName": "plugin:engineering:atlassian" },
    { "serverName": "plugin:engineering:notion" },
    { "serverName": "plugin:engineering:datadog" }
  ],
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(/usr/bin/git *)",
      "Bash(/usr/bin/gh *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "excludedCommands": [
      "git",
      "gh",
      "git *",
      "gh *",
      "/usr/bin/git *",
      "/usr/bin/gh *"
    ],
    "autoAllowBashIfSandboxed": false,
    "network": {
      "allowedDomains": [
        "pypi.org",
        "files.pythonhosted.org",
        "registry.npmjs.org"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/.cache/uv",
        "~/.npm"
      ]
    }
  }
}
