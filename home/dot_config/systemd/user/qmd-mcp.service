[Unit]
Description=Shared qmd MCP server (HTTP on localhost:8181, models stay loaded)

[Service]
# qmd is a node script; the mise shims provide node. It binds localhost only.
Environment=PATH=%h/.local/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/qmd mcp --http --port 8181
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes

[Install]
WantedBy=default.target
