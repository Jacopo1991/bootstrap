[Unit]
Description=Update the cortex-core skills with gh skill (plain update, no agent runs)

[Service]
Type=oneshot
# gh-skill-update exits non-zero when the update fails, so a failure shows in
# `systemctl --user --failed` and the journal. gh reads its own login from ~/.config/gh.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/gh-skill-update
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
TimeoutStartSec=10min
