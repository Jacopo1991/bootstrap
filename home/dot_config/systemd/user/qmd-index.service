[Unit]
Description=Fast-forward clean Cortex checkouts, then refresh the qmd index (plain indexing, no agent runs)

[Service]
Type=oneshot
# qmd is a node script; the mise shims provide node. Models are downloaded by
# install.sh, never here. qmd-refresh syncs the checkouts, then runs
# qmd update and qmd embed, and exits non-zero if any step failed.
Environment=PATH=%h/.local/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/qmd-refresh
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
TimeoutStartSec=10min
