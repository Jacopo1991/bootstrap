[Unit]
Description=Refresh the qmd index of the Cortex knowledge repositories (plain indexing, no agent runs)

[Service]
Type=oneshot
# qmd is a node script; the mise shims provide node. Models are downloaded by
# install.sh, never here.
Environment=PATH=%h/.local/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/qmd update
ExecStart=%h/.local/bin/qmd embed
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
TimeoutStartSec=10min
