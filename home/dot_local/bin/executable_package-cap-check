#!/usr/bin/env python3
"""Package cap check for the shared pre-commit gate (next to gitleaks and osv-scanner).

Fails when a requirements*.txt, constraints*.txt, pyproject.toml, uv.lock, poetry.lock,
Pipfile.lock, Dockerfile or compose file names a capped package (package-caps.toml)
above its cap, without an exact pin, or by a refused image tag. Offline, no network:
it reads the policy file once and the manifests in the repository.

    package-cap-check                 check every tracked manifest in the repository
    package-cap-check PATH...         check only these files (unknown kinds are skipped)
    --policy FILE / $PACKAGE_CAPS_FILE  policy file (default: the root-owned installed copy)
"""
from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tomllib

DEFAULT_POLICY = Path("/usr/local/lib/agent-policy/package-caps.toml")
REQUIREMENTS = re.compile(r"(?:requirements|constraints)[^/]*\.txt$")
DOCKERFILE = re.compile(r"(?:^(?:Dockerfile|Containerfile)(?:\..*)?$|\.[Dd]ockerfile$)")
COMPOSE = re.compile(r"^(?:docker-)?compose(?:\..*)?\.ya?ml$")
SKIP_DIRS = {".git", ".work", ".venv", "venv", "node_modules", "__pycache__", ".worktrees"}
REQUIREMENT = re.compile(r"^(?P<name>[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?)"
                         r"(?P<extras>\[[^\]]*\])?\s*(?P<spec>.*)$")
VERSION = re.compile(
    r"^v?(?P<release>\d+(?:\.\d+)*)"
    r"(?:[-._]?(?P<pre_l>alpha|beta|preview|pre|rc|a|b|c)[-._]?(?P<pre_n>\d*))?"
    r"(?:-(?P<post_i>\d+)|[-._]?(?:post|rev|r)[-._]?(?P<post_n>\d*))?"
    r"(?:[-._]?dev[-._]?(?P<dev_n>\d*))?"
    r"(?:\+[A-Za-z0-9]+(?:[-._][A-Za-z0-9]+)*)?$", re.IGNORECASE)
PRE_RANK = {"a": 0, "alpha": 0, "b": 1, "beta": 1, "c": 2, "rc": 2, "pre": 2, "preview": 2}
INSTALL_FORMS = (("pip", "install"), ("pip3", "install"), ("uv", "pip", "install"),
                 ("uv", "add"), ("uv", "tool", "install"), ("pipx", "install"), ("poetry", "add"))


def normalize(name: str) -> str:
    return re.sub(r"[-_.]+", "-", name).lower()


def version_key(text: str) -> tuple | None:
    """PEP 440 ordering (release, pre, post, dev); None when the text is not a version."""
    match = VERSION.match(text.strip())
    if not match:
        return None
    release = [int(part) for part in match["release"].split(".")]
    while len(release) > 1 and release[-1] == 0:
        release.pop()
    post = match["post_i"] or match["post_n"]
    has_post = post is not None
    has_dev = match["dev_n"] is not None
    if match["pre_l"]:
        pre = (PRE_RANK[match["pre_l"].lower()], int(match["pre_n"] or 0))
    elif not has_post and has_dev:
        pre = (-1, 0)
    else:
        pre = (9, 0)
    return (tuple(release), pre, int(post or 0) if has_post else -1,
            int(match["dev_n"] or 0) if has_dev else float("inf"))


class Cap:
    def __init__(self, name: str, table: dict):
        self.name = normalize(name)
        self.max_version = str(table["max_version"])
        self.key = version_key(self.max_version)
        if self.key is None:
            raise ValueError(f"{name}: max_version {self.max_version!r} is not a version")
        self.images = {image_name(image)[0] for image in table.get("images", [])}
        self.reason = str(table.get("reason", ""))
        self.source = str(table.get("source", ""))

    def version_reason(self, version: str | None) -> str | None:
        if version is None:
            return f"{self.name} must be pinned exactly (==) at or below {self.max_version}"
        key = version_key(version)
        if key is None:
            return f"{self.name}=={version} is not an exact version; the cap is {self.max_version}"
        if key > self.key:
            return f"{self.name} {version} is above the cap {self.max_version}"
        return None

    def tag_reason(self, tag: str | None) -> str | None:
        if tag is None:
            return f"image {self.name} has no tag; use a version tag at or below v{self.max_version}"
        low = tag.lower()
        if low == "latest" or low == "main" or low.startswith("main-"):
            return f"image tag {tag} is refused; use a version tag at or below v{self.max_version}"
        found = re.search(r"(?<![0-9A-Za-z])v?(\d+(?:\.\d+)+)", tag)
        if not found:
            return f"image tag {tag} carries no version; use a version tag at or below v{self.max_version}"
        if version_key(found[1]) > self.key:
            return f"image tag {tag} is above the cap v{self.max_version}"
        return None


def load_policy(path: Path) -> dict[str, Cap]:
    data = tomllib.loads(path.read_text(encoding="utf-8"))
    packages = data.get("packages")
    if not isinstance(packages, dict) or not packages:
        raise ValueError("no [packages.<name>] tables")
    return {normalize(name): Cap(name, table) for name, table in packages.items()}


def image_name(reference: str) -> tuple[str, str | None]:
    """Split image[:tag][@digest] into a normalized repository name and the tag."""
    reference = reference.strip().strip("\"'")
    if "@" in reference:
        reference = reference.split("@", 1)[0]
    name, tag = reference, None
    colon = reference.rfind(":")
    if colon > reference.rfind("/"):
        name, tag = reference[:colon], reference[colon + 1:]
    name = name.lower()
    for prefix in ("docker.io/", "index.docker.io/", "registry-1.docker.io/"):
        if name.startswith(prefix):
            name = name[len(prefix):]
    if name.startswith("library/"):
        name = name[len("library/"):]
    return name, tag


def parse_requirement(text: str) -> tuple[str, str | None, bool] | None:
    """(normalized name, exact version or None, pinned) for one PEP 508 requirement."""
    text = text.split(";", 1)[0].strip().strip("\"'")
    match = REQUIREMENT.match(text)
    if not match:
        return None
    spec = match["spec"].strip().strip("()").replace(" ", "")
    exact = re.fullmatch(r"===?([^,*]+)", spec)
    if exact and version_key(exact[1]) is not None:
        return normalize(match["name"]), exact[1], True
    return normalize(match["name"]), None, False


def poetry_requirement(name: str, constraint) -> tuple[str, str | None, bool]:
    """Poetry spells an exact pin as "1.2.3" or "==1.2.3"; everything else is a range."""
    if isinstance(constraint, dict):
        constraint = constraint.get("version", "")
    text = str(constraint).strip().replace(" ", "")
    if text.startswith("=="):
        text = text[2:]
    if version_key(text) is not None:
        return normalize(name), text, True
    return normalize(name), None, False


def requirement_tokens(tokens: list[str]) -> list[str]:
    """Positional operands of a pip/uv/pipx/poetry install command, or nothing."""
    for form in INSTALL_FORMS:
        if tuple(tokens[:len(form)]) == form:
            return [token for token in tokens[len(form):] if not token.startswith("-")]
    if tokens[:1] and re.fullmatch(r"python[0-9.]*", tokens[0]) and tokens[1:3] == ["-m", "pip"]:
        return requirement_tokens(tokens[2:])
    return []


class Checker:
    def __init__(self, caps: dict[str, Cap]):
        self.caps = caps
        self.findings: list[str] = []

    def report(self, path: Path, line: int, cap: Cap, reason: str) -> None:
        self.findings.append(f"{path}:{line}: {reason} ({cap.reason}; {cap.source})")

    def requirement(self, path: Path, line: int, parsed) -> None:
        if parsed is None:
            return
        name, version, _pinned = parsed
        cap = self.caps.get(name)
        if cap is not None:
            reason = cap.version_reason(version)
            if reason:
                self.report(path, line, cap, reason)

    def image(self, path: Path, line: int, reference: str) -> None:
        if "$" in reference:
            return
        name, tag = image_name(reference)
        for cap in self.caps.values():
            if name in cap.images:
                reason = cap.tag_reason(tag)
                if reason:
                    self.report(path, line, cap, reason)

    # --- file kinds -----------------------------------------------------------------
    def check(self, path: Path) -> bool:
        name = path.name
        if REQUIREMENTS.search(name):
            self.requirements_file(path)
        elif name == "pyproject.toml":
            self.pyproject(path)
        elif name in {"uv.lock", "poetry.lock"}:
            self.toml_lock(path)
        elif name == "Pipfile.lock":
            self.pipfile_lock(path)
        elif DOCKERFILE.search(name):
            self.dockerfile(path)
        elif COMPOSE.match(name):
            self.compose(path)
        else:
            return False
        return True

    @staticmethod
    def logical_lines(path: Path) -> list[tuple[int, str]]:
        lines: list[tuple[int, str]] = []
        current, start = "", 0
        for number, raw in enumerate(path.read_text(encoding="utf-8", errors="replace").splitlines(), 1):
            if not current:
                start = number
            stripped = raw.rstrip()
            if stripped.endswith("\\"):
                current += stripped[:-1] + " "
                continue
            lines.append((start, current + stripped))
            current = ""
        if current:
            lines.append((start, current))
        return lines

    def requirements_file(self, path: Path) -> None:
        for number, text in self.logical_lines(path):
            text = re.split(r"(?:^|\s)#", text, 1)[0].strip()
            if not text:
                continue
            if text.startswith("-"):
                egg = re.search(r"[#&]egg=([A-Za-z0-9._-]+)", text)
                if egg:
                    self.requirement(path, number, (normalize(egg[1]), None, False))
                continue
            self.requirement(path, number, parse_requirement(text.split(" --")[0]))

    def pyproject(self, path: Path) -> None:
        try:
            data = tomllib.loads(path.read_text(encoding="utf-8"))
        except (tomllib.TOMLDecodeError, UnicodeDecodeError) as error:
            self.findings.append(f"{path}:1: cannot parse pyproject.toml ({error})")
            return
        text = path.read_text(encoding="utf-8")
        parsed: list[tuple[str, str | None, bool]] = []
        project = data.get("project", {})
        groups = [project.get("dependencies", []), data.get("build-system", {}).get("requires", [])]
        groups += list(project.get("optional-dependencies", {}).values())
        groups += list(data.get("dependency-groups", {}).values())
        uv = data.get("tool", {}).get("uv", {})
        groups += [uv.get(key, []) for key in ("constraint-dependencies", "override-dependencies",
                                                "dev-dependencies")]
        for group in groups:
            for item in group:
                if isinstance(item, str):
                    parsed.append(parse_requirement(item))
        poetry = data.get("tool", {}).get("poetry", {})
        tables = [poetry.get("dependencies", {}), poetry.get("dev-dependencies", {})]
        tables += [group.get("dependencies", {}) for group in poetry.get("group", {}).values()]
        for table in tables:
            for name, constraint in table.items():
                if normalize(name) != "python":
                    parsed.append(poetry_requirement(name, constraint))
        locks = {name: self.lock_versions(path.with_name(name)) for name in ("uv.lock", "poetry.lock")
                 if path.with_name(name).is_file()}
        for item in parsed:
            if item is None:
                continue
            name, version, pinned = item
            cap = self.caps.get(name)
            if cap is None:
                continue
            line = self.line_of(text, name)
            if pinned:
                reason = cap.version_reason(version)
                if reason:
                    self.report(path, line, cap, reason)
                continue
            locked = [(lock, versions[name]) for lock, versions in locks.items() if name in versions]
            if not locks:
                self.report(path, line, cap, f"{name} has a version range and no uv.lock or poetry.lock "
                            f"next to pyproject.toml pins it; pin ==<version> at or below {cap.max_version}")
            elif not locked:
                self.report(path, line, cap, f"{name} has a version range and the lock file does not "
                            f"pin it; pin ==<version> at or below {cap.max_version}")
            else:
                for lock, locked_version in locked:
                    reason = cap.version_reason(locked_version)
                    if reason:
                        self.report(path, line, cap, f"{name} has a version range and {lock} pins "
                                    f"{locked_version}, above the cap {cap.max_version}")

    @staticmethod
    def line_of(text: str, name: str) -> int:
        pattern = re.compile(r"(?i)(?<![A-Za-z0-9._-])" + re.escape(name).replace("\\-", "[-_.]"))
        for number, line in enumerate(text.splitlines(), 1):
            if pattern.search(line):
                return number
        return 1

    @staticmethod
    def lock_versions(path: Path) -> dict[str, str | None]:
        try:
            data = tomllib.loads(path.read_text(encoding="utf-8"))
        except (tomllib.TOMLDecodeError, UnicodeDecodeError):
            return {}
        versions: dict[str, str | None] = {}
        for entry in data.get("package", []):
            if isinstance(entry, dict) and isinstance(entry.get("name"), str):
                version = entry.get("version")
                versions[normalize(entry["name"])] = str(version) if version is not None else None
        return versions

    def toml_lock(self, path: Path) -> None:
        try:
            data = tomllib.loads(path.read_text(encoding="utf-8"))
        except (tomllib.TOMLDecodeError, UnicodeDecodeError) as error:
            self.findings.append(f"{path}:1: cannot parse {path.name} ({error})")
            return
        text = path.read_text(encoding="utf-8")
        for entry in data.get("package", []):
            if not isinstance(entry, dict) or not isinstance(entry.get("name"), str):
                continue
            name = normalize(entry["name"])
            if name in self.caps:
                version = entry.get("version")
                line = next((number for number, row in enumerate(text.splitlines(), 1)
                             if re.match(r'\s*name\s*=\s*"' + re.escape(entry["name"]) + '"', row)), 1)
                self.requirement(path, line, (name, str(version) if version is not None else None, version is not None))

    def pipfile_lock(self, path: Path) -> None:
        text = path.read_text(encoding="utf-8")
        try:
            data = json.loads(text)
        except json.JSONDecodeError as error:
            self.findings.append(f"{path}:1: cannot parse Pipfile.lock ({error})")
            return
        for section in ("default", "develop"):
            for name, entry in (data.get(section) or {}).items():
                if normalize(name) not in self.caps:
                    continue
                spec = entry.get("version", "") if isinstance(entry, dict) else ""
                line = self.line_of(text, f'"{name}"')
                self.requirement(path, line, parse_requirement(f"{name}{spec}"))

    def dockerfile(self, path: Path) -> None:
        for number, text in self.logical_lines(path):
            text = text.strip()
            words = text.split()
            if not words:
                continue
            verb = words[0].upper()
            if verb == "FROM":
                operands = [word for word in words[1:] if not word.startswith("--")]
                if operands:
                    self.image(path, number, operands[0])
            elif verb == "RUN":
                body = text[len(words[0]):].strip()
                if body.startswith("["):
                    try:
                        parts = json.loads(body)
                    except json.JSONDecodeError:
                        parts = []
                    segments = [[str(part) for part in parts]] if parts else []
                else:
                    segments = [segment.split() for segment in re.split(r"&&|\|\||;|\|", body)]
                for tokens in segments:
                    tokens = [token.strip("\"'") for token in tokens]
                    for operand in requirement_tokens(tokens):
                        self.requirement(path, number, parse_requirement(operand))

    def compose(self, path: Path) -> None:
        for number, line in enumerate(path.read_text(encoding="utf-8", errors="replace").splitlines(), 1):
            match = re.match(r"^\s*(?:-\s+)?image:\s*(\S+)", line)
            if match and not match[1].startswith("#"):
                self.image(path, number, match[1].split("#", 1)[0])


def repository_files(root: Path) -> list[Path]:
    try:
        listing = subprocess.run(["git", "-C", str(root), "ls-files", "-z"], check=True,
                                 capture_output=True, text=True, timeout=30).stdout
        return [root / name for name in listing.split("\0") if name]
    except (OSError, subprocess.SubprocessError):
        found: list[Path] = []
        for here, dirs, files in os.walk(root):
            dirs[:] = sorted(d for d in dirs if d not in SKIP_DIRS)
            found.extend(Path(here) / name for name in sorted(files))
        return found


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--policy", type=Path,
                        default=Path(os.environ.get("PACKAGE_CAPS_FILE") or DEFAULT_POLICY))
    parser.add_argument("--root", type=Path, default=Path.cwd())
    parser.add_argument("paths", nargs="*", type=Path)
    args = parser.parse_args(argv)
    try:
        caps = load_policy(args.policy)
    except (OSError, ValueError, tomllib.TOMLDecodeError) as error:
        print(f"package-cap-check: cannot read the policy file {args.policy}: {error}; "
              "run install.sh (bootstrap system/agent-policy/package-caps.toml)", file=sys.stderr)
        return 2
    checker = Checker(caps)
    candidates = args.paths or repository_files(args.root)
    checked = 0
    for path in candidates:
        if path.is_file() and checker.check(path):
            checked += 1
    for finding in checker.findings:
        print(finding)
    if checker.findings:
        print(f"package-cap-check: {len(checker.findings)} finding(s) against {args.policy}", file=sys.stderr)
        return 1
    print(f"package-cap-check: OK ({checked} manifest(s), {len(caps)} capped package(s))")
    return 0


if __name__ == "__main__":
    sys.exit(main())
