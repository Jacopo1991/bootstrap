#!/usr/bin/env python3
"""Sequence an approved batch using the installed task command, without a model."""
import argparse
import json
import os
import re
import shlex
import subprocess
import sys
import time
import tomllib
import threading
import signal
from concurrent.futures import ThreadPoolExecutor, wait, FIRST_COMPLETED
from datetime import datetime
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import task_usage, task_lock
from task_limits import bwrap_denial, cli_limit, lane_limit
from task_routing import TIERS, guards, lane_limits, override_problem


TASK_LINE = re.compile(
    r"(?i)^\s*(?:\d+\.|[-*])\s+([^:\s]+):\s*builder\s+(codex|claude)"
    r"(?:,\s*model\s+([^,\s]+))?(?:,\s*seed\s+([^,\s]+))?(?:,\s*after:\s*([^,\s]+))?"
    r"(?:\b.*)?$")
NO_VERIFY = re.compile(r"(?i),\s*no-verify:\s*(.*?)(?=,\s*(?:seed\s|tier\s|after:|no-verify:|override:)|$)")
OVERRIDE = re.compile(r"(?i),\s*override:\s*(.*?)(?=,\s*(?:seed\s|tier\s|after:|no-verify:|override:)|$)")
HOOK_DENIAL = ("Command blocked by PreToolUse hook: ", "Blocked by PreToolUse hook",
               "Execution stopped by PreToolUse hook")
BLOCK_INSTRUCTION = ("If a hook or sandbox denial stops a required step, end your final reply "
                     "with a line starting `BLOCKED:` and the denied command.")
FIX_SCOPE_INSTRUCTION = ("Fix only inside this task's scope. If a finding needs changes to files "
                         "the task forbids, do not make them: end your final reply with `BLOCKED:` "
                         "and the finding.")
MERGE_IN_INSTRUCTION = ("If the findings only ask for `git merge origin/main`, make no other change and skip "
                        "`task check` this round; the trusted check runs at the new head.")
OUTPUT_LOCK = threading.Lock()
LAUNCH_LOCK = threading.Lock()
HELD = 4  # `task lane` exit status: held back by usage pacing
HOLD_SECONDS = 60


def terminal_block(output):
    lines = [line for line in output.splitlines() if line.strip()]
    last = lines[-1] if lines else ""
    # The known bwrap sandbox denial (setup #11) is an environment warning, not a stop.
    return last if last.startswith(("BLOCKED:", *HOOK_DENIAL)) and not bwrap_denial(last) else ""


class Stop(Exception):
    pass


def read(path):
    return path.read_text() if path.is_file() else ""


def data(path):
    return json.loads(read(path) or "{}")


def check_output(state):
    """The latest trusted check log; a lane's advisory check.log never goes into a prompt."""
    trusted = data(state / "check.json")
    return read(Path(trusted["log"])) if trusted.get("trusted") and trusted.get("log") else ""


def name(ident):
    match = re.fullmatch(r"(?i)t?-?(\d+)", ident)
    return f"t{int(match[1])}" if match else ident.replace("/", "-")


def parse(source):
    tasks, current, in_rules = [], None, False
    for line in source.read_text().splitlines():
        if re.match(r"\s*```text\s*$", line, re.I):
            current, in_rules = None, True
            continue
        if in_rules:
            if re.fullmatch(r"\s*```\s*", line):
                in_rules = False
            continue
        override_field = OVERRIDE.search(line)
        line_rest = OVERRIDE.sub("", line)
        no_verify_field = NO_VERIFY.search(line_rest)
        tier_field = re.search(r"(?i),\s*tier\s+([^,\s]+)", line_rest)
        match = TASK_LINE.match(re.sub(r"(?i),\s*tier\s+[^,\s]+", "", NO_VERIFY.sub("", line_rest)))
        if match:
            ident, builder, model, seed, after = match.groups()
            tier = tier_field[1].lower() if tier_field else None
            if not model and not tier:
                raise Stop("runner task needs a model or tier")
            if tier is not None and tier not in TIERS:
                raise Stop(f"Invalid tier: {tier}")
            no_verify = no_verify_field[1].strip() if no_verify_field else None
            if no_verify is not None and not no_verify.strip():
                raise Stop("no-verify needs a nonempty reason")
            override = override_field[1].strip() if override_field else ""
            if override_field and (problem := override_problem(override, required=True)):
                raise Stop(problem)
            current = dict(id=ident, builder=builder.lower(), model=model, seed=seed, after=after,
                           tier=tier, no_verify=no_verify, override=override, lines=[line])
            tasks.append(current)
        elif re.match(r"(?i)^\s*(?:\d+\.|[-*])\s+[^:\s]+:\s*builder\b", line):
            raise Stop("Invalid runner task line: " + line)
        elif current is not None:
            current["lines"].append(line)
    if not tasks:
        raise Stop("No task lines found")
    for task in tasks:
        task["block"] = "\n".join(task.pop("lines")).strip()
        box = re.search(r"(?im)^\s*Time box:\s*(\d+(?:\.\d+)?)\s*min\b", task["block"])
        task["box"] = float(box[1]) if box else 90
        if task["box"] <= 0:
            raise Stop(f"{task['id']}: time box must be positive")
    return tasks


def git(repo, *args):
    command = ["git", "-C", str(repo), *args]
    result = subprocess.run(command, capture_output=True, text=True)
    if result.returncode:
        raise Stop(f"{shlex.join(command)}: {result.stderr.strip()}")
    return result.stdout.strip()


def blocking(text):
    """Keep recorded blocking evidence, excluding commit hashes and optional notes."""
    section = re.search(r"(?ims)^\s*(?:#{1,6}\s*)?(?:\*\*)?Blocking(?:\*\*)?\s*:?\s*\n"
                        r"(.*?)(?=^\s*(?:#{1,6}\s*)?(?:\*\*)?Notes\b|\Z)", text)
    if section and section[1].strip():
        return section[1].strip()
    judgments = re.findall(r"(?im)^#\d+\s+(?:fail|unclear):.*$", text)
    if judgments:
        return "\n".join(judgments)
    return re.sub(r"(?im)^Commit:.*$", "", text).strip()


def default_branch(path):
    return next((ref for ref in ("origin/HEAD", "origin/main", "main")
                 if not run_git(path, "rev-parse", "-q", "--verify", ref).returncode), None)


def run_git(path, *args):
    return subprocess.run(["git", "-C", str(path), *args], capture_output=True, text=True)


def merge_in_only(path, reviewed, head):
    """True when every commit after the reviewed head cleanly merges the default branch."""
    def run(*args):
        return run_git(path, *args)
    default = default_branch(path)
    if not default or not reviewed:
        return False
    commits = run("rev-list", "--parents", f"{reviewed}..{head}", "--not", default).stdout.splitlines()
    for line in commits:
        commit, *parents = line.split()
        if len(parents) != 2 or run("merge-base", "--is-ancestor", parents[1], default).returncode:
            return False
        merged = run("merge-tree", "--write-tree", *parents)
        if merged.returncode or merged.stdout.split()[:1] != [run("rev-parse", f"{commit}^{{tree}}").stdout.strip()]:
            return False
    return bool(commits)


def failure_key(text):
    """Ignore Git heads and timing noise when comparing consecutive failures."""
    text = re.sub(r"\b[0-9a-f]{7,40}\b", "<sha>", text)
    text = re.sub(r"\b\d+(?:\.\d+)?\s*(?:seconds?|secs?|ms|s)\b", "<duration>", text)
    return " ".join(text.split())


class Batch:
    def __init__(self, repo, source, stopping=None, ident=None, no_pace=False):
        self.no_pace = no_pace
        self.repo = repo
        self.source = source
        self.done = repo / ".work" / source.with_suffix(".done").name
        self.stopping = stopping if stopping is not None else threading.Event()
        self.ident = ident

    def stop(self):
        # Do not let a worker pass its stop check while another launches a CLI.
        with LAUNCH_LOCK:
            self.stopping.set()

    def output(self, text):
        prefix = f"[{self.ident}] " if self.ident else ""
        with OUTPUT_LOCK:
            for line in text.splitlines():
                print(prefix + line, flush=True)

    def append(self, line):
        self.done.parent.mkdir(parents=True, exist_ok=True)
        with self.done.open("a") as stream:
            stream.write(" ".join(line.split()) + "\n")
        self.output(line)

    def call(self, command, *args, retry=False):
        argv = ["task", command, str(self.repo), *map(str, args)]
        while True:
            with LAUNCH_LOCK:
                if self.stopping.is_set():
                    raise Stop("batch is stopping")
                self.output("+ " + shlex.join(argv))
                child = subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, pass_fds=task_lock.descriptors())
            with child:
                while True:
                    try:
                        output, _ = child.communicate(timeout=0.1)
                        break
                    except subprocess.TimeoutExpired:
                        if self.stopping.is_set():
                            child.terminate()
                            output, _ = child.communicate()
                            self.output(output)
                            raise Stop("batch is stopping")
                result = subprocess.CompletedProcess(argv, child.returncode, output)
            self.output(result.stdout)
            if command == "lane" and result.returncode == HELD:
                if self.stopping.wait(HOLD_SECONDS):
                    raise Stop("batch is stopping")
                continue
            if not (retry and result.returncode == 3):
                return result

    def require(self, command, *args, retry=False):
        result = self.call(command, *args, retry=retry)
        if result.returncode:
            raise Stop(f"task {command}: {result.stdout.strip()}")
        return result.stdout

    def finished(self, path, record):
        if git(path, "status", "--porcelain"):
            return False
        if git(path, "rev-parse", "HEAD") == record["base_sha"]:
            return False
        if re.match(r"(?i)WIP\b", git(path, "log", "-1", "--format=%s")):
            return False
        # `default...HEAD` is the diff from the merge-base: a merge-only head adds nothing of its own.
        default = default_branch(path)
        if default and not run_git(path, "diff", "--quiet", f"{default}...HEAD").returncode:
            return False
        report = read(path / ".work/report.md")
        headings = ["What changed", "How I verified"]
        if record.get("criteria"):
            headings += ["Criteria", "Noticed, not done"]
        return bool(report and "(fill in)" not in report.lower() and all(
            (match := re.search(rf"(?ms)^## {heading}\s*\n(.*?)(?=^## |\Z)", report))
            and match[1].strip() for heading in headings))

    def lane_outcome(self, work):
        record = data(work / "lane.json")
        if record.get("state") == "tampered": raise Stop("lane tampered with Git metadata; the PM inspects it before any further Git runs")
        try:
            started = datetime.fromisoformat(record["started_at"]).timestamp()
        except (KeyError, ValueError, TypeError):
            return
        def fresh_read(name):
            path = work / name
            return read(path) if path.is_file() and path.stat().st_mtime > started else ""
        for name in ("final.md", "lane.log"):
            limit = cli_limit(record, fresh_read(name))
            if limit:
                raise Stop(f"lane CLI: {limit}")
        denied = terminal_block(fresh_read("final.md"))
        if denied:
            raise Stop(f"lane: {denied}")

    def reviewer_outcome(self, state):
        record = data(state / "review-run.json")
        # Claude -p writes its terminal error to stdout; Codex uses stderr.
        output = state / ("review-response.md" if record.get("builder") == "claude"
                          else "review-stderr.log")
        limit = cli_limit(record, read(output))
        if limit:
            raise Stop(f"reviewer CLI: {limit}")
        denied = terminal_block(read(state / "review-response.md"))
        if denied:
            raise Stop(f"reviewer: {denied}")
        routing = data(state / "review-routing.json")
        builder = data(state / "task.json").get("builder")
        if routing.get("fallback_from") and routing.get("vendor") == builder:
            raise Stop("reviewer fallback used the builder vendor; independent review required before merge")

    def task(self, task):
        ident, box = task["id"], task["box"]
        path = self.repo / ".worktrees" / name(ident)
        work = path / ".work"
        state = Path.home() / ".local/state/task" / self.repo.name / name(ident)
        if (state / "merge.json").is_file():
            self.require("merge", ident, retry=True)
            return "merged"
        resumed = path.is_dir() and (state / "task.json").is_file()
        dispatch = ""
        if not resumed or task["seed"]:
            options = ["--builder", task["builder"]]
            if task.get("tier"):
                options += ["--tier", task["tier"]]
            if task["override"]:
                options += ["--override", task["override"]]
            if task["seed"]:
                options += ["--seed", task["seed"]]
            if task.get("no_verify"):
                options += ["--no-verify", task["no_verify"].strip()]
            dispatch = self.require("start", ident, *options)
        record = data(state / "task.json")
        # New task versions persist their dispatch instructions for resumed batches.
        dispatch = read(work / "dispatch.md") or dispatch
        if not dispatch:
            dispatch = (f"Read the pinned context in .work/context/. Work only in {path} "
                        f"on branch {record['branch']}. Commit, run task check, then fill "
                        ".work/report.md (What changed, How I verified, Criteria, Noticed, not done).")
        dispatch += ("\nBefore reporting, run `task check` (advisory, from the worktree) on the final commit "
                     "and paste its final summary line (PASS/FAIL plus the log path) under `## Check` "
                     "in `.work/report.md`. A claim like 'tests pass' without that line is not evidence.\n")
        dispatch += ("Write and edit files with your edit or apply_patch tool, never shell heredocs or cat >; "
                     "avoid backticks in shell commands. If a merge-in is needed, run `git merge origin/main`.\n")
        started = time.monotonic()
        builder, model = task["builder"], task["model"]
        tier = task.get("tier")
        tier_only = model is None
        rounds, previous, findings, check_tail = 0, None, "", ""
        # Never launch a duplicate lane or overwrite the prompt of a running lane.
        previous_limit = lane_limit(data(work / "lane.json"), work) if resumed else ""
        if resumed:
            was_running = data(work / "lane.json").get("state") in {"running", "tampered"}
            self.require("wait", ident, "--max", box, retry=True)
            if was_running:
                self.lane_outcome(work)
        run_lane = not resumed or not self.finished(path, record)
        if resumed and run_lane:
            findings = (f"Previous lane ended by usage limit: {previous_limit}. Resume, finish and commit."
                        if previous_limit else blocking(read(state / "review.md")) or
                        "Unfinished work: finish and commit.")
            check_tail = "\n".join(check_output(state).splitlines()[-80:])
        # Merge-in rounds do not count toward the cap: their time is subtracted.
        exempt, round_start, merge_in_since = 0.0, 0.0, None

        def over_cap():
            now = time.monotonic()
            return now - started - exempt - (now - merge_in_since if merge_in_since is not None else 0) >= 3 * box * 60
        while True:
            if over_cap():
                return f"parked: total time cap; last blocking findings: {findings or 'unfinished'}"
            if run_lane:
                try:
                    recorded = data(state / "task.json").get("tier", "routine")
                    guards(tier or recorded, recorded, model, task["override"])
                except ValueError as error:
                    return f"parked: {error}"
                round_start = time.monotonic()
                reviewed = data(state / "review.json").get("commit")
                prompt = task["block"] + "\n\nDispatch instructions:\n" + dispatch
                if rounds or findings:
                    prompt += ("\n\nFix round: re-measure, run the tests, finish and commit.\n"
                               f"Blocking findings:\n{findings}\nLatest trusted check result:\n{check_tail}\n")
                    if "git merge origin/main" in findings:
                        prompt += MERGE_IN_INSTRUCTION + "\n"
                prompt += "\n\n" + BLOCK_INSTRUCTION + "\n"
                if rounds or findings:
                    prompt += FIX_SCOPE_INSTRUCTION + "\n"
                (work / "prompt.md").write_text(prompt)
                options = ["--tier", tier] if tier else []
                if model:
                    options += ["--model", model]
                if task["override"]:
                    options += ["--override", task["override"]]
                self.require("lane", ident, "--builder", builder, "--timeout", box, *options)
                self.require("wait", ident, "--max", box, retry=True)
                self.lane_outcome(work)
                if (rounds or findings) and merge_in_only(path, reviewed, git(path, "rev-parse", "HEAD")):
                    merge_in_since = round_start
            if over_cap():
                return f"parked: total time cap; last blocking findings: {findings or 'unfinished'}"
            record = data(state / "task.json")
            if not self.finished(path, record):
                findings, signature = "Unfinished work: re-measure, test, finish and commit.", None
            else:
                # PM decision (round 5, .work/request.md): trusted task command
                # output is never a block signal; check/merge failures get fixes.
                # Only lane final.md and the reviewer's own reply are inspected.
                checked = self.call("check", ident, retry=True)
                if checked.returncode:
                    check_tail = "\n".join((check_output(state) or checked.stdout).splitlines()[-80:])
                    findings = "Failed task check"
                    signature = ("check", failure_key(check_tail))
                else:
                    # A passed check is still the latest trusted result the next fix prompt states.
                    check_tail = "\n".join((checked.stdout.strip().splitlines()[-1:]
                                            + [line for line in check_output(state).splitlines()
                                               if line.startswith("Gate suites finished")][-1:]))
                    review = {}
                    head = git(path, "rev-parse", "HEAD")
                    paths = git(path, "diff", "--name-only", "--no-renames", "-z",
                                f"{record.get('base_sha', 'main')}...{head}", "--").split("\0")
                    risk, _, _ = task_usage.risk_paths(self.repo.name, record, paths, task_usage.policy(Path.home())["review"])
                    if risk == "low":
                        review = {"verdict": "PASS"}
                    for _ in range(0 if risk == "low" else 2):
                        result = self.call("review", ident, "--run", "--append-prompt", BLOCK_INSTRUCTION)
                        self.reviewer_outcome(state)
                        candidate = data(state / "review.json")
                        if (result.returncode == 0 and candidate.get("commit") == git(path, "rev-parse", "HEAD")
                                and candidate.get("record_revision") == record.get("revision")
                                and candidate.get("verdict") in {"PASS", "FAIL"}):
                            review = candidate
                            break
                    if over_cap():
                        return f"parked: total time cap; last blocking findings: {findings or 'time cap'}"
                    if (review.get("verdict") == "PASS"
                            and all(v == "pass" for v in review.get("judgments", {}).values())):
                        if risk == "high":
                            brief = work / "redteam-brief.md"
                            brief.write_text(task["block"] + "\n\n" + dispatch + "\n\n" + read(work / "request.md"))
                            self.require("redteam", ident, "--brief", str(brief))
                        merged = self.call("merge", ident, retry=True)
                        if merged.returncode == 0:
                            return f"merged after {rounds} fix rounds" if rounds else "merged"
                        findings = merged.stdout.strip()
                        signature = ("merge", findings)
                    else:
                        findings = blocking(read(state / "review.md")) if review else "Review produced no verdict twice"
                        signature = ("review", failure_key(findings))
            if signature is not None and signature == previous:
                return f"parked: repeated failure; last blocking findings: {findings}; {check_tail}"
            if rounds == 3:
                return f"parked: fix rounds exhausted; last blocking findings: {findings}; {check_tail}"
            previous = signature
            rounds += 1
            if rounds == 2 and not tier_only:
                if model in {"gpt-6.1-sol", "gpt-6-astra", "opus", "claude-opus-5-5", "fable", "claude-fable-5-1"}:
                    rounds = 3
                else:
                    model = "gpt-6.1-sol" if builder == "codex" else "opus"
            if rounds == 3:
                builder = "claude" if builder == "codex" else "codex"
                if not tier_only:
                    model = "opus" if builder == "claude" else "gpt-6.1-sol"
            run_lane = True
            if merge_in_since is not None:
                exempt += time.monotonic() - merge_in_since
                merge_in_since = None

    def run_task(self, task):
        try:
            return self.task(task)
        except BaseException as error:
            task_usage.run_outcome(Path.home(), self.repo.name, data(Path.home() / ".local/state/task" / self.repo.name / name(task["id"]) / "task.json").get("id", task["id"]), f"stopped: {str(error) or 'interrupted'}")
            self.stop()
            raise

    def run(self):
        try:
            self.require("runner-check", self.source)
            tasks = parse(self.source)
            home = Path.home()
            if self.no_pace or os.environ.get("TASK_NO_PACE"):
                task_usage.log(home, f"--no-pace: batch {self.repo.name}/{self.source.name} not paced")
            else:
                reason, notes = task_usage.batch_gate(home, [task["builder"] for task in tasks])
                for note in notes:
                    self.output(note)
                if reason:
                    raise Stop(f"usage pacing: {reason} (--no-pace overrides)")
            self.schedule(tasks)
            self.append("batch: finished")
            return 0
        except (Exception, KeyboardInterrupt) as error:
            self.stop()
            self.append(f"batch: stopped: {str(error) or 'interrupted'}")
            return 1

    def gate_slots(self):
        config = Path.home() / ".config/task/gate.toml"
        slots = tomllib.loads(read(config)).get("slots", 3)
        if type(slots) is not int or slots < 1:
            raise Stop("gate slots must be a positive integer")
        return slots

    def capacity(self):
        slots = self.gate_slots()
        limits = lane_limits(Path.home(), slots)
        if not (self.no_pace or os.environ.get("TASK_NO_PACE")):  # boost never lifts the 5-hour limits
            for vendor, cap in task_usage.five_caps(Path.home()).items():
                limits[vendor] = limits[vendor] if cap is None else min(limits[vendor], cap)
        return min(slots, max(limits.values())), limits

    def schedule(self, tasks):
        pending, completed, parked = list(tasks), set(), set()
        in_file = {name(task["id"]) for task in tasks}
        consecutive = 0
        # Each worker owns its per-task state. Only this scheduler writes outcomes.
        pool = ThreadPoolExecutor(max_workers=self.gate_slots())
        try:
            running = {}
            while pending or running:
                total, limits = self.capacity()
                for task in list(pending):
                    dependency = name(task["after"]) if task["after"] else None
                    if dependency and dependency not in in_file and dependency not in completed:
                        merge_record = (Path.home() / ".local/state/task" / self.repo.name /
                                        dependency / "merge.json")
                        if merge_record.is_file():
                            completed.add(dependency)
                        else:
                            self.append(f"{task['id']}: not started: after {task['after']} (no merge record)")
                            parked.add(name(task["id"]))
                            completed.add(name(task["id"]))
                            pending.remove(task)
                            continue
                    if dependency in parked:
                        self.append(f"{task['id']}: not started: after {task['after']}")
                        parked.add(name(task["id"]))
                        completed.add(name(task["id"]))
                        pending.remove(task)
                        continue
                    if dependency and dependency not in completed:
                        continue
                    def current_builder(running_task):
                        state = (Path.home() / ".local/state/task" / self.repo.name /
                                 name(running_task["id"]) / "task.json")
                        return data(state).get("builder", running_task["builder"])
                    count = sum(current_builder(t) == task["builder"] for t in running.values())
                    limit = limits[task["builder"]]
                    if not limit and task.get("tier") in (None, "routine") and any(limits.values()):
                        limit = 1  # 5-hour exhausted: the lane gate moves a routine task to the vendor with room, or holds it
                    if len(running) >= total or count >= limit:
                        continue
                    pending.remove(task)
                    if self.stopping.is_set():
                        raise Stop("batch is stopping")
                    worker = Batch(self.repo, self.source, self.stopping, task["id"])
                    running[pool.submit(worker.run_task, task)] = task
                if not running:
                    if any(not limits[task["builder"]] for task in pending):  # waiting for a 5-hour reset
                        if self.stopping.wait(HOLD_SECONDS):
                            raise Stop("batch is stopping")
                        continue
                    if pending:
                        raise Stop("unresolved after dependencies")
                    break
                finished, _ = wait(running, return_when=FIRST_COMPLETED)
                for future in finished:
                    task = running.pop(future)
                    try:
                        outcome = future.result()
                    except Exception as error:
                        self.append(f"{task['id']}: stopped: {error}")
                        raise
                    self.append(f"{task['id']}: {outcome}")
                    completed.add(name(task["id"]))
                    if outcome.startswith("parked:"):
                        task_usage.run_outcome(Path.home(), self.repo.name, data(Path.home() / ".local/state/task" / self.repo.name / name(task["id"]) / "task.json").get("id", task["id"]), outcome)
                        parked.add(name(task["id"]))
                        consecutive += 1
                        if consecutive == 2:
                            raise Stop("two tasks parked in a row")
                    else:
                        consecutive = 0
        finally:
            self.stop()
            pool.shutdown(wait=False, cancel_futures=True)



def main():
    def interrupted(signum, frame):
        raise Stop("interrupted")
    signal.signal(signal.SIGTERM, interrupted)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("repo")
    parser.add_argument("runner_file", type=Path)
    parser.add_argument("--no-pace", action="store_true", help="start without the usage-pacing check (logged)")
    args = parser.parse_args()
    repo = Path(args.repo).expanduser()
    if not repo.is_absolute():
        repo = Path.home() / "dev_workspace" / repo
    batch = Batch(repo.resolve(), args.runner_file.resolve(), no_pace=args.no_pace)
    try:
        batch.repo = Path(git(repo, "rev-parse", "--path-format=absolute", "--git-common-dir")).parent
        batch.done = batch.repo / ".work" / batch.source.with_suffix(".done").name
    except Exception as error:
        batch.append(f"batch: stopped: {error}")
        return 1
    try:
        task_lock.atomic_write = task_usage._write
        task_lock.work(Path.home(), batch.repo)
    except task_lock.LockBusy as error:
        batch.append(f'batch: stopped: {error}'); return 1
    return batch.run()


if __name__ == "__main__":
    raise SystemExit(main())
