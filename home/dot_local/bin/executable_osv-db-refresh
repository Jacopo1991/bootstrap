#!/usr/bin/env bash
# Fetch the OSV offline vulnerability databases that the osv-scanner pre-commit hook
# reads (it never fetches at commit time). Bootstrap runs this on install and
# osv-db-refresh.timer runs it weekly; run it from a normal shell to refresh by hand.
# Only changed databases are downloaded. Every ecosystem is tried; any failure is
# reported and makes the command (and the timer's unit) fail. Only a fully successful
# run updates the .last-refresh stamp that the drift report checks.
set -uo pipefail
cache="${XDG_CACHE_HOME:-$HOME/.cache}/osv-scalibr"
failed=0

refresh() {
  local file="$cache/$1/all.zip"
  local since=()
  mkdir -p "${file%/*}" || return 1
  rm -f "$file.part"
  [ -f "$file" ] && since=(--time-cond "$file")
  curl --fail --silent --show-error --location --retry 3 --remote-time "${since[@]}" \
    "https://osv-vulnerabilities.storage.googleapis.com/$1/all.zip" -o "$file.part" || return 1
  if [ -s "$file.part" ]; then
    unzip -tq "$file.part" >/dev/null || return 1
    mv "$file.part" "$file" || return 1
    echo "ok $1: updated"
  else
    rm -f "$file.part"
    echo "ok $1: unchanged"
  fi
}

for ecosystem in PyPI npm crates.io Go Packagist RubyGems; do
  if ! refresh "$ecosystem"; then
    rm -f "$cache/$ecosystem/all.zip.part"
    echo "ERROR $ecosystem: download or zip check failed; the previous database is kept" >&2
    failed=1
  fi
done
ping() {  # Healthchecks.io ping (skipped silently without the owner-provisioned pings file)
  command -v job-ping >/dev/null 2>&1 && job-ping osv-db-refresh "$1"
  return 0
}
if [ $failed = 1 ]; then
  echo "OSV offline databases NOT fully refreshed in $cache" >&2
  ping 1
  exit 1
fi
touch "$cache/.last-refresh"
echo "OSV offline databases current in $cache"
ping 0
