#!/usr/bin/env bash
# Create a new project the standard way (slim workflow, 2026-10-04).
# Run by the founder or the PM from a normal shell as the agent user, never from inside an agent session
# (the agent policy hook blocks git init there on purpose).
#   new-project create <name> [--local-only]   code repo + cortex-kb repo, each on main with a first commit
#   new-project publish <name>                 after the PM created both GitHub repos: add origin and push
set -euo pipefail

usage() { echo "usage: new-project create <name> [--local-only] | new-project publish <name>" >&2; exit 2; }
[ $# -ge 2 ] || usage
cmd=$1 name=$2 local_only=0
[ "${3:-}" = "--local-only" ] && local_only=1
[[ $name =~ ^[a-z0-9][a-z0-9-]{1,60}$ ]] || { echo "name must be lowercase letters, digits and hyphens" >&2; exit 2; }
owner=${NEW_PROJECT_OWNER:-Jacopo1991}
code="$HOME/dev_workspace/$name"
kb="$HOME/cortex/cortex-kb-$name"
today=$(date +%Y-%m-%d)

first_commit() { git -C "$1" add -A && git -C "$1" commit -q -m "Initial project skeleton (new-project)"; }

case $cmd in
create)
  for d in "$code" "$kb"; do [ ! -e "$d" ] || { echo "$d already exists; nothing changed" >&2; exit 1; }; done
  mkdir -p "$code" "$kb"
  git -C "$code" init -q -b main
  git -C "$kb" init -q -b main

  cat > "$code/README.md" <<MD
# $name

Code repository. Project knowledge (intent, status, and the backlog of tasks and decisions) lives in \`cortex-kb-$name\`.
MD
  cat > "$code/AGENTS.md" <<MD
# Agent instructions

Follow the \`slim-workflow\` skill. Read \`~/cortex/cortex-kb-$name\` (INTENT.md, STATUS.md, your task) before working.
Commit only in this repository; report results in chat. The PM records STATUS.md, backlog tasks and decisions in the knowledge repository.
MD
  printf '.env\n.env.*\nnode_modules/\n.venv/\n__pycache__/\ndist/\nbuild/\n' > "$code/.gitignore"

  cat > "$kb/README.md" <<MD
# cortex-kb-$name

Project knowledge for \`$name\`, following the \`slim-workflow\` skill.
Code repository: \`$name\`$( [ $local_only = 1 ] && echo " (local only, no GitHub remote)" ).
MD
  cat > "$kb/AGENTS.md" <<MD
# Agent instructions

Follow the \`slim-workflow\` skill. The PM keeps STATUS.md and the backlog/ tasks and decisions current; build lanes work in the code repository and report in chat.
MD
  cat > "$kb/INTENT.md" <<MD
# Intent

## Goal

## Non-goals

## Constraints
MD
  cat > "$kb/STATUS.md" <<MD
# Status

Updated: $today

## Now
Project created.

## Next

## Open questions
MD
  # Tasks and decisions live in backlog/, managed with Backlog.md. Offline and
  # manual: no integration files, no auto commits, no remote or branch scans.
  (cd "$kb" && backlog init "$name" --defaults --integration-mode none \
    --task-prefix T --check-branches false --include-remote false >/dev/null \
    && backlog config set autoCommit false >/dev/null \
    && backlog config set remoteOperations false >/dev/null \
    && backlog config set checkActiveBranches false >/dev/null)
  first_commit "$code"
  first_commit "$kb"
  echo "Created $code and $kb on main."
  echo "Next: run chezmoi apply to add it to the qmd index."
  if [ $local_only = 0 ]; then
    echo "Next (PM): create private GitHub repos $owner/$name and $owner/cortex-kb-$name, apply the standard ruleset, then run: new-project publish $name"
  fi
  ;;
publish)
  for pair in "$code:$name" "$kb:cortex-kb-$name"; do
    dir=${pair%%:*} repo=${pair#*:}
    [ -d "$dir/.git" ] || { echo "$dir is not a repository; run create first" >&2; exit 1; }
    if git -C "$dir" remote get-url origin >/dev/null 2>&1; then
      echo "$dir already has origin; skipped"
    else
      git -C "$dir" remote add origin "https://github.com/$owner/$repo.git"
    fi
    git -C "$dir" push -q -u origin main
    echo "Pushed $repo"
  done
  ;;
*) usage ;;
esac
