class Stop(Exception):
    """A clear, expected reason to stop; printed without a traceback."""


class UsageLimit(Stop):
    """A reviewer CLI ended with a terminal usage-limit diagnostic."""


def frontmatter_title(text):
    """Read a title from the small YAML frontmatter subset used by Backlog tasks."""
    lines = text.splitlines()
    if not lines or lines[0].strip() != "---":
        return ""
    end = next((index for index in range(1, len(lines))
                if lines[index].strip() in {"---", "..."}), len(lines))
    for index, line in enumerate(lines[1:end], 1):
        match = re.match(r"^(\s*)title:[ \t]*(.*?)[ \t]*$", line)
        if not match:
            continue
        indent, scalar = match.groups()
        if scalar in {">", ">-", "|", "|-"}:
            content = []
            key_indent = len(indent)
            for continuation in lines[index + 1:end]:
                leading = len(continuation) - len(continuation.lstrip(" \t"))
                if continuation.strip() and leading <= key_indent:
                    break
                content.append(continuation)
            indents = [len(value) - len(value.lstrip(" \t")) for value in content if value.strip()]
            content_indent = min(indents) if indents else key_indent + 1
            value_lines = [value[content_indent:] if value.strip() else "" for value in content]
            value = "\n".join(value_lines)
            if scalar.startswith(">"):
                value = re.sub(r"(?<=[^\n])\n(?=[^\n])", " ", value)
            return value.rstrip("\n")
        if len(scalar) >= 2 and scalar[0] == scalar[-1] == "'":
            return scalar[1:-1].replace("''", "'")
        if len(scalar) >= 2 and scalar[0] == scalar[-1] == '"':
            try:
                return json.loads(scalar)
            except json.JSONDecodeError:
                return scalar[1:-1]
        return scalar
    return ""


def run_git(cwd, *args):
    return subprocess.run(["git", "-c", "core.quotePath=false", "-C", str(cwd), *args],
                          capture_output=True, text=True)


def git(cwd, *args):
    result = run_git(cwd, *args)
    if result.returncode:
        raise Stop(f"git {' '.join(args)} failed: {(result.stderr or result.stdout).strip()}")
    return result.stdout.rstrip("\n")


def ok(cwd, *args):
    return run_git(cwd, *args).returncode == 0


def sha(cwd, ref):
    return git(cwd, "rev-parse", "--verify", f"{ref}^{{commit}}")


def is_ancestor(cwd, older, newer):
    return ok(cwd, "merge-base", "--is-ancestor", older, newer)


# --- where things are --------------------------------------------------------------------------

def main_repo(path: Path) -> Path:
    return Path(git(path, "rev-parse", "--path-format=absolute", "--git-common-dir")).parent


def resolve_repo(name):
    path = Path(name).expanduser()
    if not path.is_absolute():
        path = WORKSPACE / name
    if not (path / ".git").exists():
        raise Stop(f"{path} is not a repository.")
    return main_repo(path)


def has_origin(repo):
    return ok(repo, "remote", "get-url", "origin")


def default_branch(repo):
    head = run_git(repo, "symbolic-ref", "--quiet", "--short", "refs/remotes/origin/HEAD").stdout.strip()
    if head.startswith("origin/"):
        return head[len("origin/"):]
    for name in ("main", "master"):
        if ok(repo, "rev-parse", "--verify", "--quiet", f"refs/heads/{name}"):
            return name
    raise Stop(f"{repo}: no main or master branch.")


def fetch(repo):
    if has_origin(repo):
        result = run_git(repo, "fetch", "-q", "origin")
        if result.returncode:
            raise Stop(f"git fetch origin failed: {result.stderr.strip()}")


def ensure_origin_head(repo):
    """Record origin's advertised default branch when a remote has no origin/HEAD yet."""
    if not has_origin(repo) or ok(repo, "symbolic-ref", "--quiet", "refs/remotes/origin/HEAD"):
        return
    fetch(repo)
    result = run_git(repo, "remote", "set-head", "origin", "--auto")
    if result.returncode:
        raise Stop(f"Could not set origin/HEAD automatically: {result.stderr.strip()}")
    head = run_git(repo, "symbolic-ref", "--quiet", "--short", "refs/remotes/origin/HEAD")
    if head.returncode or not head.stdout.strip().startswith("origin/"):
        raise Stop("git remote set-head origin --auto did not record origin/HEAD.")


def base_commit(repo, default):
    """The commit new work starts from and merges into, resolved once: origin's default branch
    when there is an origin (local unpushed commits are never carried along), else the local one."""
    if has_origin(repo) and ok(repo, "rev-parse", "--verify", "--quiet", f"refs/remotes/origin/{default}"):
        base = sha(repo, f"origin/{default}")
        local = run_git(repo, "rev-parse", "--verify", "--quiet", f"refs/heads/{default}").stdout.strip()
        if local and not is_ancestor(repo, local, base):
            print(f"note: local {default} has commits that are not on origin; they are left out.")
        return base, f"origin/{default}"
    return sha(repo, default), default


def real_worktree(repo: Path, path: Path) -> bool:
    """True only for a registered worktree of this repository whose top level is exactly path."""
    if not path.is_dir():
        return False
    top = run_git(path, "rev-parse", "--show-toplevel").stdout.strip()
    if not top or Path(top).resolve() != path.resolve():
        return False
    listed = [Path(line[len("worktree "):]).resolve()
              for line in git(repo, "worktree", "list", "--porcelain").splitlines()
              if line.startswith("worktree ")]
    return path.resolve() in listed and path.resolve() != repo.resolve()


class Task:
    """A Backlog.md task (T-32) or a plain name."""

    def __init__(self, repo: Path, ident: str):
        match = re.fullmatch(r"(?i)t?-?(\d+)", ident)
        self.repo = repo
        self.number = int(match.group(1)) if match else None
        self.kb = CORTEX / f"cortex-kb-{repo.name}"
        self.title = ""
        if self.number is not None:
            self.name = f"t{self.number}"
            self.id = f"T-{self.number}"
            if self.file:
                self.title = frontmatter_title(self.file.read_text())
        else:
            if (not re.fullmatch(r"[a-z0-9][a-z0-9._/-]{0,79}", ident)
                    or any(part in {"", ".", ".."} for part in ident.split("/"))):
                raise Stop("A task name is lowercase letters, digits, '.', '_', '-', or '/' between name parts.")
            if ident in {"main", "master", default_branch(repo)}:
                raise Stop(f"'{ident}' is the default branch, not a task name.")
            self.id = self.branch_hint = ident
            self.name = ident.replace("/", "-")
        self.path = repo / ".worktrees" / self.name

    @property
    def file(self):
        tasks = self.kb / "backlog" / "tasks"
        if self.number is None or not tasks.is_dir():
            return None
        found = sorted(tasks.glob(f"[tT]-{self.number} - *.md"))
        return found[0] if found else None

    def branch_name(self):
        if self.number is None:
            return self.branch_hint
        words = re.findall(r"[a-z0-9]+", self.title.lower())[:4]
        return "-".join([self.name, *words])[:40].rstrip("-")

    def existing_branch(self):
        """A local branch for this task, or one that exists only on origin (fetched)."""
        pattern = f"{self.name}-*" if self.number is not None else self.branch_hint
        for refs in ("refs/heads/", "refs/remotes/origin/"):
            names = git(self.repo, "for-each-ref", "--format=%(refname:short)",
                        refs + pattern, refs + self.name).split()
            if names:
                return names[0].removeprefix("origin/"), refs.startswith("refs/remotes")
        return None, False

    def worktree(self):
        if not real_worktree(self.repo, self.path):
            if self.path.exists():
                raise Stop(f"{self.path} exists but is not a worktree of {self.repo}; move it away first.")
            raise Stop(f"No worktree {self.path}; start it with `task start`.")
        return self.path


def utc_now():
    return datetime.now(timezone.utc).isoformat(timespec="microseconds")


def frontmatter_value(text, key):
    # Reuse the scalar and quoted-value handling used for Backlog titles.
    return frontmatter_title(re.sub(r"(?m)^" + re.escape(key) + r":", "title:",
                                   re.sub(r"(?m)^title:.*$", "", text)))


def plan_hash(text):
    header = re.match(r"\A---\r?\n.*?\r?\n(?:---|\.\.\.)(?:\r?\n|$)", text, re.S)
    if header:
        text = re.sub(r"(?m)^(?:signed|signed_hash):[^\n]*(?:\n|$)", "", header[0]) + text[header.end():]
    return hashlib.sha256(text.encode()).hexdigest()


def read_json_object(path):
    try:
        value = json.loads(path.read_text())
        return value if isinstance(value, dict) else {}
    except (OSError, ValueError):
        return {}


def active_boosts():
    now = datetime.now(timezone.utc)
    return {vendor: until for vendor, until in read_json_object(HOME / ".local/state/task/boost.json").items()
            if vendor in {"claude", "codex"} and plan_time(until) and now < plan_time(until)}


def boost(args):
    path = HOME / ".local/state/task/boost.json"
    if args.action != "off" and (args.claude or args.codex):
        raise Stop("--claude and --codex require boost off")
    if args.action == "off" and (args.claude_until or args.codex_until):
        raise Stop("boost off does not accept end times")
    values = read_json_object(path)
    if args.action == "off":
        for vendor in ("claude", "codex"):
            if not (args.claude or args.codex) or getattr(args, vendor):
                values.pop(vendor, None)
    else:
        for vendor in ("claude", "codex"):
            until = getattr(args, vendor + "_until")
            if until:
                when = plan_time(until)
                if not when or when <= datetime.now(timezone.utc):
                    raise Stop("Boost end time must be a future ISO datetime with offset")
                values[vendor] = when.isoformat()
    if args.action or args.claude_until or args.codex_until:
        atomic_json(path, values)
    print(boost_line() or "boost: off")


def boost_line():
    active = active_boosts()
    return "boost: " + ", ".join(f"{vendor} until {until}" for vendor, until in sorted(active.items())) if active else ""


def plan_time(value):
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
        return parsed if parsed.tzinfo else None
    except (ValueError, AttributeError):
        return None


def decision_content(text):
    """Ignore only the frontmatter status field."""
    lines = text.splitlines()
    frontmatter = bool(lines and lines[0] == "---")
    result = []
    for index, line in enumerate(lines):
        if index and line == "---":
            frontmatter = False
        if frontmatter and re.match(r"^status\s*:", line):
            continue
        result.append(line)
    return result


REPLACEMENT_MARKER = re.compile(
    r"\*Replaced\b[^*]*\*|\(replaced\b[^)]*\)|Replaced by decision-\d+\b", re.I)


def decision_line_status_only(old, new):
    """Remove inserted markers, preserving all original text and spacing."""
    if new == old:
        return True
    new = re.sub(r"~~(.+?)~~", r"\1", new)
    # Keep existing markers intact. Each inserted fragment may include one
    # separating space on either side; never normalize the surrounding prose.
    positions = {(0, 0)}
    seen = set()
    while positions:
        before, after = positions.pop()
        if (before, after) in seen:
            continue
        seen.add((before, after))
        if before == len(old) and after == len(new):
            return True
        if before < len(old) and after < len(new) and old[before] == new[after]:
            positions.add((before + 1, after + 1))
        for start in (after, after + 1) if new[after:after + 1] == " " else (after,):
            marker = REPLACEMENT_MARKER.match(new, start)
            if marker:
                positions.add((before, marker.end()))
                if start == after and new[marker.end():marker.end() + 1] == " ":
                    positions.add((before, marker.end() + 1))
    return False


def decision_status_only(old, new):
    remaining = iter(decision_content(old))
    current = next(remaining, None)
    for line in decision_content(new):
        if current is not None and decision_line_status_only(current, line):
            current = next(remaining, None)
        elif not REPLACEMENT_MARKER.fullmatch(line.strip()):
            return False
    return current is None


def decision_changed(kb, name, before="HEAD", after=None):
    try:
        old = run_git(kb, "show", f"{before}:{name}")
        if after is None:
            path = kb / name
            new = path.read_text() if path.is_file() else None
        else:
            shown = run_git(kb, "show", f"{after}:{name}")
            new = shown.stdout if shown.returncode == 0 else None
    except (OSError, ValueError):
        # Unreadable content cannot be proven to be a status-only edit.
        # ValueError includes UnicodeDecodeError from either Git or the file.
        return True
    return old.returncode != 0 or new is None or not decision_status_only(old.stdout, new)


def plan_info(repo):
    kb = CORTEX / f"cortex-kb-{repo.name}"
    path = kb / "INTENT.md"
    text = path.read_bytes().decode() if path.is_file() else ""
    current = frontmatter_value(text, "current").split(" #", 1)[0].strip()
    signed = frontmatter_value(text, "signed")
    since = plan_time(signed)
    reasons = []
    if not path.is_file():
        reasons.append("INTENT.md missing; write INTENT.md and set current first")
    if not since or not frontmatter_value(text, "signed_hash"):
        reasons.append("plan not signed")
    elif plan_hash(text) != frontmatter_value(text, "signed_hash"):
        reasons.append("changed since sign-off")
    try:
        limit = int((frontmatter_value(text, "realign_every") or "15").split(" #", 1)[0])
        if limit < 1:
            raise ValueError
    except ValueError:
        limit = 15
        reasons.append("realign_every must be positive")
    milestones = sorted((kb / "backlog/milestones").glob(f"{current} - *.md")) if current else []
    if not milestones:
        reasons.append("current must name an existing milestone")
    merged = []
    for evidence in sorted((HOME / ".local/state/task" / repo.name).glob("*/merge.json")):
        data = read_json_object(evidence)
        when = plan_time(data.get("time", ""))
        # Preserve subsecond ordering; equal timestamps are not after sign-off.
        if since and when and when > since:
            record_path = evidence.parent / "task.json"
            record = read_json_object(record_path)
            task = Task(repo, record.get("id", evidence.parent.name))
            body = task.file.read_text() if task.file else ""
            merged.append(f"{task.id}: {record.get('title', task.title)}; milestone: "
                          f"{frontmatter_value(body, 'milestone') or record.get('milestone', '')}; "
                          f"{markdown_section(body, 'Final Summary')}")
    if len(merged) >= limit:
        reasons.append("realignment due")
    decisions = set()
    for line in run_git(kb, "status", "--porcelain", "-z", "--untracked-files=all", "--", "backlog/decisions").stdout.split("\0") if kb.exists() else []:
        if line:
            name = line[3:] if line[2:3] == " " else line
            if decision_changed(kb, name):
                decisions.add(name)
    if since and kb.exists():
        # Walk the default branch when it resolves, else the checked-out branch; first-parent
        # diffs catch decisions that arrive through merge commits.
        try:
            branch = default_branch(kb)
        except Stop:
            branch = ""
        ref = branch if branch and ok(kb, "rev-parse", "--verify", "--quiet", f"refs/heads/{branch}") else "HEAD"
        for line in run_git(kb, "log", "--first-parent", "--format=%H %cI", ref).stdout.splitlines():
            commit, _, stamp = line.partition(" ")
            when = plan_time(stamp)
            if when and when > since:
                if ok(kb, "rev-parse", "--verify", "--quiet", f"{commit}^1"):
                    changed = run_git(kb, "diff", "--name-only", "-z", f"{commit}^1", commit,
                                      "--", "backlog/decisions")
                else:
                    changed = run_git(kb, "show", "--name-only", "-z", "--format=", commit,
                                      "--", "backlog/decisions")
                decisions.update(name for name in changed.stdout.split("\0") if name and
                                 decision_changed(kb, name, f"{commit}^1", commit))
    if decisions:
        reasons.append("decisions changed: " + ", ".join(sorted(decisions)))
    return dict(kb=kb, path=path, text=text, current=current, signed=signed, limit=limit,
                merged=merged, decisions=sorted(decisions), reasons=reasons,
                title=frontmatter_title(milestones[0].read_text()) if milestones else "")


def plan_verdict(info):
    return "plan: stop: " + "; ".join(info["reasons"]) if info["reasons"] else "plan: ok"


def check_plan(task, off_plan=None, *, refresh=False):
    if off_plan is not None:
        if not off_plan.strip():
            raise Stop("--off-plan needs a reason")
        return
    if (not task.kb.exists() or task.number is None or
            not refresh and real_worktree(task.repo, task.path) and (task_state(task) / "task.json").is_file()):
        return
    if not task.file:
        raise Stop(f"No Backlog.md task {task.id} in {task.kb}.")
    info = plan_info(task.repo)
    reasons = info["reasons"][:]
    if not task.file or frontmatter_value(task.file.read_text(), "milestone") != info["current"] or not info["current"]:
        reasons.append("task milestone must match current")
    if reasons:
        raise Stop("; ".join(reasons) + "; update INTENT.md and run `task plan " + task.repo.name + " --sign`, or use --off-plan with a reason.")


def plan(args):
    repo = resolve_repo(args.repo)
    info = plan_info(repo)
    if args.sign:
        if not info["current"] or not list((info["kb"] / "backlog/milestones").glob(f"{info['current']} - *.md")):
            raise Stop("current must name an existing Backlog milestone file")
        header = re.match(r"\A---\r?\n.*?\r?\n---(?:\r?\n|$)", info["text"], re.S)
        if not header:
            raise Stop("INTENT.md needs YAML frontmatter with current")
        metadata = re.sub(r"(?m)^(?:signed|signed_hash):[^\n]*(?:\n|$)", "", header[0])
        end = metadata.rfind("---")
        newline = "\r\n" if header[0].startswith("---\r\n") else "\n"
        unsigned = metadata + info["text"][header.end():]
        text = (metadata[:end] + f"signed: {utc_now()}{newline}"
                f"signed_hash: {plan_hash(unsigned)}{newline}" + metadata[end:]
                + info["text"][header.end():])
        info["path"].write_bytes(text.encode())
        info = plan_info(repo)
    print(f"current: {info['current']} {info['title']}")
    print(f"signed: {info['signed'] or 'not signed'}")
    print(f"merged since sign-off: {len(info['merged'])}/{info['limit']}")
    print("decisions newer than sign-off: " + ", ".join(info["decisions"]))
    print(plan_verdict(info))


def realign(args):
    info = plan_info(resolve_repo(args.repo))
    if not info["path"].is_file():
        raise Stop("Create INTENT.md before realignment")
    prompt = ("Read-only drift review. Answer with Verdict: on plan | drifted | plan unclear, "
              "then evidence per merged task: does it serve current and its pass test; contradictions "
              "between INTENT, STATUS and decisions; and what the founder must decide. "
              "Do not edit files or sign anything.\n")
    for name in ["INTENT.md", "STATUS.md", *info["decisions"]]:
        source = info["kb"] / name
        prompt += f"\n## {name}\n" + (source.read_text() if source.is_file() else "(missing or deleted)")
    prompt += "\n## Tasks merged since sign-off\n" + "\n".join(info["merged"])
    directory = info["kb"] / "history/realign"
    reply = directory / ("realign-" + datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S%fZ") + ".md")
    state = HOME / ".local/state/task" / info["kb"].name.removeprefix("cortex-kb-") / "realign"
    state.mkdir(parents=True, exist_ok=True)
    failed_reply = state / reply.name
    with tempfile.TemporaryDirectory(dir=state) as temporary:
        source = Path(temporary) / "prompt.md"
        source.write_text(prompt)
        run_reviewer("GIT_OPTIONAL_LOCKS=0 codex exec --sandbox read-only -m gpt-6-luna -c model_reasoning_effort=high -",
                     info["kb"], source, failed_reply)
        directory.mkdir(parents=True, exist_ok=True)
        failed_reply.replace(reply)
    print(reply.read_text(), end="")


def atomic_json(path: Path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix(path.suffix + ".tmp")
    temporary.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n")
    temporary.replace(path)


def criteria_from(text: str):
    return [{"number": int(number), "text": body.strip(), "checked": checked == "x"}
            for checked, number, body in re.findall(
                r"(?m)^- \[([ x])\] #(\d+)\s+(.+?)\s*$", text)]


def verification_from(text: str):
    return re.findall(r"(?m)^Verify:\s*`([^`]+)`\s*$", text)


def report_is_filled(path: Path):
    if not path.is_file():
        return False
    content = path.read_text()
    sections = [re.search(rf"(?ms)^## {heading}\s*\n(.*?)(?=^## |\Z)", content)
                for heading in ("What changed", "How I verified", "Criteria", "Noticed, not done")]
    return bool(all(match and match.group(1).strip() for match in sections)
                and not re.search(r"(?i)\(fill in\)", content))


def markdown_section(text: str, heading: str) -> str:
    match = re.search(rf"(?ms)^#{{1,6}} {re.escape(heading)}\s*\n(.*?)(?=^#{{1,6}} |\Z)", text)
    return match.group(1).strip() if match else ""


def brief_field(text, heading):
    section = markdown_section(text, heading) or markdown_section(text, heading + ":")
    if section:
        return section
    match = re.search(rf"(?m)^{re.escape(heading)}:[ \t]*(.*(?:\n(?:[ \t]+|[-*] ).*)*)", text)
    return match[1].strip() if match else ""


def save_check_evidence(destination, name, evidence, log):
    evidence = dict(evidence, summary_tail="\n".join(log.read_text(errors="replace").splitlines()[-20:]))
    atomic_json(destination / name, evidence)
    with (destination / "checks.jsonl").open("a") as stream:
        stream.write(json.dumps(dict(evidence, kind=name)) + "\n")


def review_check(task, path, head, record):
    # Gate and prompt share this rule: a matching trusted check is authoritative,
    # regardless of advisory timestamps. Otherwise use the newest advisory check
    # (check.json is replaced on each check; checks.jsonl retains the history).
    for directory in (task_state(task), path / ".work"):
        evidence = read_json_object(directory / "check.json")
        if evidence.get("sha") == head and evidence.get("record_revision") == record.get("revision"):
            if "summary_tail" not in evidence:
                log = directory / "check.log"
                evidence["summary_tail"] = ("\n".join(log.read_text(errors="replace").splitlines()[-20:])
                                            if log.is_file() else "(old check: no summary saved)")
            return evidence
    return {}


def save_review_history(state, meta, text):
    numbers = [int(p.stem.split("-")[1]) for p in state.glob("review-*.md")
               if re.fullmatch(r"review-\d+", p.stem)]
    number = max(numbers, default=0) + 1
    # Exclusive creation protects earlier evidence even after refresh or a repeated record.
    with (state / f"review-{number}.md").open("x") as stream:
        stream.write(f"Verdict: {meta['verdict']}\nHead: {meta['commit']}\nTime: {meta['time']}\n\n" + text)
    atomic_json(state / f"review-{number}.json", meta)


def completed_step(task: Task, step: str):
    path = task_state(task) / "run.json"
    try:
        run = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return
    done = run.setdefault("completed", [])
    if step not in done:
        done.append(step)
    atomic_json(path, run)


def task_event(task: Task, name: str):
    path = task_state(task) / "events.json"
    try:
        events = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        events = {}
    events[name] = utc_now()
    atomic_json(path, events)


def set_child_group(state: Path, pgid: int | None):
    lock = state / "run.lock"
    try:
        data = json.loads(lock.read_text())
    except (OSError, json.JSONDecodeError):
        return
    if pgid is None:
        data.pop("child_pgid", None)
    else:
        data["child_pgid"] = pgid
    atomic_json(lock, data)


def handle_interruption(signum, _frame):
    task = ACTIVE_FOREGROUND_TASK
    if task is not None:
        state = task_state(task)
        lock = state / "run.lock"
        try:
            lock_data = json.loads(lock.read_text())
            child_pgid = int(lock_data.get("child_pgid", 0))
            if child_pgid:
                os.killpg(child_pgid, signal.SIGTERM)
                time.sleep(0.1)
                try:
                    os.killpg(child_pgid, 0)
                    os.killpg(child_pgid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
        except (OSError, ValueError, json.JSONDecodeError):
            pass
        run_path = state / "run.json"
        try:
            run = json.loads(run_path.read_text())
        except (OSError, json.JSONDecodeError):
            run = {}
        if run.get("pid") == os.getpid() and run.get("state") in {"foreground", "running"}:
            run["state"] = "interrupted"
            run["ended_at"] = utc_now()
            atomic_json(run_path, run)
        lock.unlink(missing_ok=True)
    raise SystemExit(128 + signum)


def record_revision(record):
    body = {key: value for key, value in record.items() if key != "revision"}
    return hashlib.sha256(json.dumps(body, sort_keys=True, separators=(",", ":")).encode()).hexdigest()


def task_state(task: Task) -> Path:
    return HOME / ".local/state/task" / task.repo.name / task.name


def preserve_work(repo: Path, name: str, path: Path, reuse_head=None, *, strict=False):
    """Preserve evidence; list runtime data and individual copy failures."""
    source = path / ".work"
    if not source.exists() and not source.is_symlink():
        return
    archive = HOME / ".local/state/task/archive" / repo.name / name
    try:
        archive.mkdir(parents=True, exist_ok=True)
        if reuse_head:
            for manifest in archive.glob(f"{path.name}-*/manifest.json"):
                try:
                    record = json.loads(manifest.read_text())
                except (OSError, ValueError):
                    continue
                if record.get('head') == reuse_head and (manifest.parent / '.work').is_dir():
                    print(f"Reusing archive {manifest.parent} for {reuse_head}.")
                    return
        pending = Path(tempfile.mkdtemp(prefix=".pending-", dir=archive))
        saved = pending / ".work"

        entries, sizes, errors = archive_inventory(source)
        oversized, disposable = oversized_contents(entries, sizes, {source, source / 'reports'}, errors)
        skipped, special, excluded, size = [], [], set(), 0
        for item, info in entries:
            if item.parent in excluded:
                excluded.add(item)
                continue
            relative = str(item.relative_to(source))
            mode = info.st_mode
            reason = None
            if not (stat.S_ISDIR(mode) or stat.S_ISREG(mode) or stat.S_ISLNK(mode)):
                special.append(relative)
                reason = "special file"
            elif item != source and archive_runtime(item, info, errors):
                reason = "cache/runtime"
            elif item in disposable:
                reason = "directory over 200 MB"
            elif (stat.S_ISREG(mode) and item.suffix == '.log' and
                  sizes[item] >= 50 * 1024 ** 2 and not archive_evidence(item, info)):
                reason = "log over 50 MB"
            if item in errors:
                excluded.add(item)
                continue
            if reason:
                excluded.add(item)
                skipped.append({"path": relative, "size": sizes[item], "reason": reason})
                continue
            if item in oversized:
                skipped.append({"path": relative, "size": sizes[item],
                                "reason": "non-evidence contents over 200 MB"})
            target = saved / item.relative_to(source)
            try:
                if stat.S_ISDIR(mode):
                    target.mkdir(parents=True, exist_ok=True)
                elif stat.S_ISLNK(mode):
                    target.symlink_to(os.readlink(item))
                    size += info.st_size
                else:
                    shutil.copy2(item, target)
                    size += info.st_size
            except OSError as error:
                errors[item] = str(error)
        skipped.extend({"path": str(item.relative_to(source)), "size": sizes.get(item, 0),
                        "reason": error} for item, error in errors.items())
        head = run_git(path, 'rev-parse', '--verify', 'HEAD^{commit}')
        atomic_json(pending / "manifest.json", {"skipped_special_files": special, "skipped": skipped,
                                                "head": reuse_head or (head.stdout.strip()
                                                                       if not head.returncode else None)})
        if strict and errors:
            raise OSError("evidence could not be fully read or copied")
        destination = archive / f"{path.name}-{pending.name.removeprefix('.pending-')}"
        pending.rename(destination)
    except (OSError, shutil.Error) as error:
        raise Stop(f"Cannot preserve {source} in {archive}; refusing to remove {path}: {error}")
    print(f"Preserved {source} at {destination / '.work'} ({size} bytes).", flush=True)


def load_record(task: Task, required=True):
    path = task_state(task) / "task.json"
    if not path.is_file():
        if required:
            raise Stop("No pinned task record; run `task start ... --refresh --builder ...`.")
        return None
    try:
        record = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as error:
        raise Stop(f"Cannot read {path}: {error}.")
    if record.get("revision") != record_revision(record):
        raise Stop("The pinned task record is damaged; ask the PM to refresh it.")
    return record


def task_config(path: Path):
    config = path / ".task.toml"
    try:
        return tomllib.loads(config.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return {}
    except (OSError, ValueError):
        # ValueError includes UnicodeDecodeError and TOMLDecodeError. Do not echo
        # parser details: they may include configuration values.
        raise Stop(f"Cannot read {config}.") from None


def timeout_for(path: Path):
    value = task_config(path).get("check_timeout")
    if value is not None:
        if type(value) is not int or value < 1:
            raise Stop(".task.toml check_timeout must be a positive number of seconds.")
        return value
    return int(os.environ.get("TASK_CHECK_TIMEOUT", "900"))


def configured_environment(path, repo=None):
    values = task_config(path).get("env", {})
    return expand_environment(values, path, repo)


def expand_environment(values, path, repo=None):
    if not isinstance(values, dict):
        raise Stop(".task.toml [env] must be a table of plain strings.")
    for name, value in values.items():
        if stripped_agent_variable(name) or name == "TMPDIR" or name.startswith("TASK_GATE_"):
            raise Stop(f".task.toml env key {name} is reserved.")
        if any(word in name.upper() for word in ("TOKEN", "KEY", "SECRET", "PASSWORD")):
            raise Stop(f".task.toml env key {name} looks like a credential; use secretspec.")
        if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", name) or not isinstance(value, str) or "\0" in value:
            raise Stop(".task.toml [env] requires valid environment names and plain strings.")
    if not values:
        return {}
    repo = repo or main_repo(path)
    return {name: value.replace("{repo}", str(repo.resolve())).replace("{worktree}", str(path.resolve()))
            for name, value in values.items()}


def gate_variants(path):
    entries = task_config(path).get("gate_variant", [])
    if not isinstance(entries, list):
        raise Stop(".task.toml gate_variant must be an array of tables.")
    variants = {}
    for entry in entries:
        if not isinstance(entry, dict):
            raise Stop(".task.toml gate_variant must contain tables.")
        name = entry.get("name")
        if not isinstance(name, str) or not re.fullmatch(r"[A-Za-z0-9_-]+", name):
            raise Stop(".task.toml gate_variant requires a simple nonempty name.")
        if name in variants:
            raise Stop(".task.toml gate_variant names must be unique.")
        variants[name] = expand_environment(entry.get("env", {}), path)
    return variants


def exclusive_gate_enabled(path: Path, *, advisory=False) -> bool:
    values = task_config(path)
    if advisory:
        return True
    return values.get("exclusive_gate", not advisory) is True


def gate_slots():
    config = Path.home() / ".config/task/gate.toml"
    try:
        count = tomllib.loads(config.read_text()).get("slots", 3) if config.exists() else 3
    except (OSError, tomllib.TOMLDecodeError) as error:
        raise Stop(f"Cannot read {config}: {error}")
    if type(count) is not int or count < 1:
        raise Stop(f"{config}: slots must be a positive integer")
    return count


def gate_directory():
    override = os.environ.get("TASK_GATE_DIR")
    root = Path(override) if override else Path("/tmp/agent-task-gates")
    if not override:
        root.mkdir(exist_ok=True)
    return root


def gate_paths(name):
    root = gate_directory()
    stem = "agent-task-gate" if name == "slot-0" else f"agent-task-gate-{name}"
    return root / (stem + ".lock"), root / (stem + ".holder")


def gate_holders():
    root = gate_directory()
    holders = []
    for lock in sorted(root.glob("agent-task-gate*.lock")):
        try:
            pid = gate_holder_pid(lock)
            if pid is None:
                continue
            try:
                record = json.loads(lock.with_suffix(".holder").read_text())
            except (OSError, ValueError):
                record = {}
            if not isinstance(record, dict) or record.get("pid") != pid:
                record = {"repo": "holder details unavailable"}
            name = lock.stem.removeprefix("agent-task-gate-") if lock.stem != "agent-task-gate" else "slot-0"
            holders.append((name, pid, record.get("repo", "?"), record.get("task", "?"), record.get("since", "?")))
        except OSError:
            continue
    return holders


def holder_display(row, *, include_slot=True):
    name, pid, repo, task_id, since = row
    if repo == "holder details unavailable":
        return f"pid {pid} (holder details unavailable)"
    suffix = f" ({name})" if include_slot else ""
    return f"pid {pid}, {repo}/{task_id} since {since}{suffix}"


@contextmanager
def exclusive_gate_lock(task: Task, silent_unavailable=False, *, config_path=None, advisory=False):
    """Hold sorted resources and either one slot or the whole machine."""
    path = config_path if config_path is not None else task.repo
    if not exclusive_gate_enabled(path, advisory=advisory):
        yield
        return
    values = task_config(path)
    resources = values.get("gate_resources", [])
    if not isinstance(resources, list) or any(
            not isinstance(name, str) or not re.fullmatch(r"[A-Za-z0-9_-]+", name)
            for name in resources):
        raise Stop("gate_resources must be a list of resource names (letters, digits, _ or -)")
    count = gate_slots()
    exclusive = not advisory and values.get("exclusive_gate") is True
    groups = [[f"resource-{name}"] for name in sorted(set(resources))]
    slots = [f"slot-{number}" for number in range(count)]
    groups.extend([[name] for name in slots] if exclusive else [slots])
    # A gate whose isolation is required (whole machine, or named resources) must not run
    # unlocked; only a plain one-slot gate may degrade to an unlocked run with a notice.
    allow_unavailable = not resources and (silent_unavailable or not exclusive)
    notice = "running advisory check unlocked" if silent_unavailable else "running trusted gate unlocked"
    acquired = []
    held_slot = None
    metadata = {"pid": os.getpid(), "since": utc_now(), "task": task.id, "repo": task.repo.name}

    def release():
        nonlocal held_slot
        held_slot = None
        while acquired:
            descriptor, holder = acquired.pop()
            try:
                holder.unlink(missing_ok=True)
            except OSError:
                pass
            os.close(descriptor)

    deadline = time.monotonic() + GATE_LOCK_WAIT * 60
    previous = None
    try:
        while True:
            stage = "open"
            try:
                blocked = False
                for alternatives in groups:
                    for name in alternatives:
                        lock, holder = gate_paths(name)
                        stage = "open"
                        descriptor = os.open(lock, os.O_CREAT | os.O_RDWR | getattr(os, "O_NOFOLLOW", 0), 0o666)
                        try:
                            stage = "acquire"
                            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
                        except BlockingIOError:
                            os.close(descriptor)
                            continue
                        except BaseException:
                            os.close(descriptor)
                            raise
                        acquired.append((descriptor, holder))
                        if held_slot is None and name in slots:
                            held_slot = slots.index(name)
                        try:
                            atomic_json(holder, metadata)
                        except OSError:
                            pass
                        break
                    else:
                        blocked = True
                        break
                if not blocked:
                    break
                # Never wait with a partial allocation: exclusive gates cannot
                # deadlock each other or gates acquiring named resources.
                release()
                holders = [row for row in gate_holders() if not row[0].startswith("noslot-")]
                if time.monotonic() >= deadline:
                    detail = "; ".join(holder_display(row) for row in holders)
                    print(f"gate busy: held by {detail or 'another gate (holder details unavailable)'}",
                          file=sys.stderr, flush=True)
                    raise SystemExit(3)
                if holders != previous:
                    detail = "; ".join(holder_display(row) for row in holders)
                    print(f"Waiting for exclusive task gate held by {detail or 'another gate (holder details unavailable)'}.", flush=True)
                    previous = holders
                time.sleep(0.1)
            except OSError as error:
                release()
                message = f"Cannot {stage} shared gate lock: {error}"
                if not allow_unavailable:
                    raise Stop(message)
                print(f"{message}; {notice}.", flush=True)
                break
        # Only a slot lock actually held sets the slot; resource names never do.
        token = GATE_SLOT.set(held_slot)
        try:
            yield
        finally:
            GATE_SLOT.reset(token)
    finally:
        release()


@contextmanager
def gate_port_index(path: Path):
    """Yield the held slot, or reserve an index above the slots for a run that holds none."""
    slot = GATE_SLOT.get()
    if slot is not None:
        yield slot
        return
    count = gate_slots()
    try:
        repo = main_repo(path).name
    except Stop:
        repo = path.name
    metadata = {"pid": os.getpid(), "since": utc_now(), "task": path.name, "repo": repo}
    try:
        for index in range(count, GATE_PORT_INDEXES):
            lock, holder = gate_paths(f"noslot-{index - count}")
            descriptor = os.open(lock, os.O_CREAT | os.O_RDWR | getattr(os, "O_NOFOLLOW", 0), 0o666)
            try:
                fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                os.close(descriptor)
                continue
            except BaseException:
                os.close(descriptor)
                raise
            break
        else:
            raise Stop(f"No free gate port range: indexes {count}-{GATE_PORT_INDEXES - 1} are all in use.")
    except OSError as error:
        # Without a usable gate directory, two runs cannot share a reserved index, so each
        # derives its own index above the slots from its process id.
        span = max(1, GATE_PORT_INDEXES - count - 1)
        index = count + 1 + os.getpid() % span
        print(f"Cannot reserve a gate port range: {error}; using unreserved index {index} "
              f"derived from process id {os.getpid()}.", flush=True)
        yield index
        return
    try:
        try:
            atomic_json(holder, metadata)
        except OSError:
            pass
        yield index
    finally:
        try:
            holder.unlink(missing_ok=True)
        except OSError:
            pass
        os.close(descriptor)


def gate_holder_alive(lock_path):
    return gate_holder_pid(lock_path) is not None


def gate_holder_pid(lock_path):
    """Kernel lock identity survives PID namespace differences."""
    info = lock_path.stat()
    for line in Path("/proc/locks").read_text().splitlines():
        fields = line.split()
        if "->" in fields or "FLOCK" not in fields:
            continue
        for field in fields:
            match = re.fullmatch(r"([0-9a-fA-F]+):([0-9a-fA-F]+):(\d+)", field)
            if match and (int(match[1], 16), int(match[2], 16), int(match[3])) == (
                    os.major(info.st_dev), os.minor(info.st_dev), info.st_ino):
                return int(fields[4])
    return None


def run_record_path(task: Task):
    return task_state(task) / "run.json"


def pid_alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except ProcessLookupError:
        return False
    except (PermissionError, ValueError, TypeError, OSError):
        return False


def task_run_pids(run_id):
    """Find this user's processes carrying a check/gate run marker, including new sessions."""
    if not run_id:
        return []
    markers = {f"{name}={run_id}".encode() for name in ("TASK_RUN_ID", "TASK_GATE_RUN_ID")}
    found = []
    try:
        processes = Path("/proc").iterdir()
        for entry in processes:
            if not entry.name.isdecimal():
                continue
            try:
                if entry.stat().st_uid != os.getuid():
                    continue
                if markers.intersection(entry.joinpath("environ").read_bytes().split(b"\0")):
                    found.append(int(entry.name))
            except (OSError, PermissionError, ValueError):
                continue
    except OSError:
        return []
    return found


def signal_task_run(run_id, signum):
    for pid in task_run_pids(run_id):
        if pid != os.getpid():
            try:
                os.kill(pid, signum)
            except (ProcessLookupError, PermissionError, OSError):
                pass


def task_lock_status(task: Task, repair=False):
    lock = task_state(task) / "run.lock"
    if not lock.exists():
        if repair:
            run_path = run_record_path(task)
            try:
                run = json.loads(run_path.read_text())
            except (OSError, ValueError):
                return ""
            if run.get("state") in {"running", "foreground", "starting"} and not pid_alive(run.get("pid")):
                run.update(state="interrupted", ended_at=utc_now())
                atomic_json(run_path, run)
                return "interrupted"
        return ""
    try:
        lock_record = json.loads(lock.read_text())
        pid = int(lock_record["pid"])
    except (OSError, ValueError, KeyError, TypeError, json.JSONDecodeError):
        if repair and time.time() - lock.stat().st_mtime > 5:
            lock.unlink(missing_ok=True)
        return "unknown"
    if pid_alive(pid):
        return "running"
    run_path = run_record_path(task)
    try:
        run = json.loads(run_path.read_text())
    except (OSError, json.JSONDecodeError):
        run = {}
    active = run.get("state") in {"running", "foreground", "starting"}
    if active and repair:
        run["state"] = "interrupted"
        run["ended_at"] = utc_now()
        atomic_json(run_path, run)
    if repair:
        lock.unlink(missing_ok=True)
    return "interrupted" if active else ""


def detached(args, task, path):
    work = path / ".work"
    work.mkdir(exist_ok=True)
    state = task_state(task)
    state.mkdir(parents=True, exist_ok=True)
    run_path, lock = state / "run.json", state / "run.lock"
    if lock.exists() and task_lock_status(task, repair=True) == "running":
        raise Stop("A task run is already live; wait for it or use `task cancel`.")
    if lock.exists():
        raise Stop("The task run lock is unreadable; ask the PM to inspect task status.")
    try:
        fd = os.open(lock, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
        os.close(fd)
    except FileExistsError:
        raise Stop("A task run is already starting; try again shortly.")
    started = utc_now()
    atomic_json(lock, {"pid": os.getpid(), "started_at": started, "command": args.command,
                       "mode": "detached-starting"})
    command = [sys.executable, str(Path(__file__).resolve()), *sys.argv[1:]]
    command = [part for part in command if part != "--detach"]
    log = (work / "run.log").open("ab")
    archive = run_path
    run_id = secrets.token_hex(16)
    env = dict(os.environ, TASK_RUN_RECORD=str(run_path), TASK_RUN_ARCHIVE=str(archive),
               TASK_RUN_ID=run_id)
    child = subprocess.Popen(command, cwd=path, env=env, stdin=subprocess.DEVNULL,
                             stdout=log, stderr=subprocess.STDOUT, start_new_session=True,
                             close_fds=True)
    atomic_json(run_path, {"command": args.command, "pid": child.pid, "pgid": child.pid,
                           "task_run_id": run_id,
                           "state": "running", "started_at": started, "ended_at": "",
                           "completed": []})
    atomic_json(lock, {"pid": child.pid, "started_at": started, "command": args.command,
                       "mode": "detached"})
    print(f"Started detached {args.command} run (pid {child.pid}); see {work / 'run.log'}.")
    return 0


def task_state_writable(task: Task | None = None):
    state = task_state(task) if task else HOME / ".local/state/task"
    probe = None
    try:
        state.mkdir(parents=True, exist_ok=True)
        descriptor, probe_name = tempfile.mkstemp(prefix=".task-write-probe-", dir=state)
        probe = Path(probe_name)
        os.close(descriptor)
        probe.unlink()
        return True
    except OSError:
        if probe is not None:
            try: probe.unlink(missing_ok=True)
            except OSError: pass
        return False


def check_task_from_args(args):
    if args.id is None:
        top = Path(git(Path.cwd(), "rev-parse", "--show-toplevel"))
        return Task(main_repo(top), top.name)
    repo = resolve_repo(args.repo) if args.repo else main_repo(Path.cwd())
    return Task(repo, args.id)


def advisory_check_for(task: Task):
    return not task_state_writable() or not task_state_writable(task)


def require_pm(args):
    """Refuse before dispatch, locks, records or detached processes can be written."""
    if not task_state_writable():
        raise Stop("Private task state is not writable; run this from the PM shell or a batch runner.")
    if args.command in {"start", "lane", "review", "merge", "close", "cancel"}:
        task = Task(resolve_repo(args.repo), args.id)
        if not task_state_writable(task):
            raise Stop("Private task state is not writable; run this from the PM shell or a batch runner.")


def stripped_agent_variable(name):
    return name in GIT_OVERRIDE_ENV or name in {"GIT_OVERRIDE_ENV", "TASK_GATE_RUN_ID", "TASK_WORKTREE"} or name.startswith(("GIT_CONFIG", "TASK_RUN_"))


def agent_environment():
    # The hook refuses Git control-plane overrides inherited by a nested CLI.
    # Never carry a runner's detached gate ownership into an agent.
    return {name: value for name, value in os.environ.items()
            if not stripped_agent_variable(name)}


def claude_temporary_root():
    root = Path("/tmp") / f"claude-{os.getuid()}"
    root.mkdir(mode=0o700, exist_ok=True)
    info = root.lstat()
    if (not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid()
            or info.st_mode & 0o022):
        raise Stop(f"Claude temporary parent must be an owned, non-writable-by-others directory: {root}")
    return root


def cleanup_lane_temporary(temporary):
    if not temporary:
        return
    path = Path(temporary)
    # Cancellation reads a lane-controlled record; never remove arbitrary paths.
    if (path.parent != claude_temporary_root()
            or not re.fullmatch(r"lane-[0-9a-f]{8}", path.name)):
        raise Stop("Invalid Claude lane temporary directory.")
    if path.exists():
        info = path.lstat()
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid():
            raise Stop("Claude lane temporary directory must be owned by the user.")
        shutil.rmtree(path)


def lane_environment(task, builder="codex"):
    env = agent_environment()
    env.update(configured_environment(task.path, task.repo))
    state = task.path / ".work/state"
    state.mkdir(parents=True, exist_ok=True)
    env["XDG_STATE_HOME"] = str(state)
    if builder == "claude":
        temporary = claude_temporary_root() / f"lane-{secrets.token_hex(4)}"
        temporary.mkdir(mode=0o700)
    else:
        temporary = task.path / ".work/tmp"
        if not temporary.resolve().is_relative_to(task.path.resolve()):
            raise Stop("Lane TMPDIR must stay inside the task worktree.")
        temporary.mkdir(parents=True, exist_ok=True)
    env["TMPDIR"] = str(temporary.resolve())
    env["TASK_WORKTREE"] = str(task.path.resolve())
    if not env.get("SECRETSPEC_REASON", "").strip():
        env["SECRETSPEC_REASON"] = f"lane {task.repo.name}/{task.id}"
    return env


MODELS = {"codex": {"gpt-6-luna": "gpt-6-luna", "gpt-6.1-sol": "gpt-6.1-sol", "gpt-6-astra": "gpt-6-astra"},
          "claude": {"sonnet": "sonnet", "claude-sonnet-5-5": "sonnet",
                     "opus": "opus", "claude-opus-5-5": "opus",
                     "fable": "fable", "claude-fable-5-1": "fable"}}


def resolve_model(builder, model):
    if model not in MODELS[builder]:
        raise Stop(f"Model {model!r} is not available for the {builder} builder; "
                   f"choose one of: {', '.join(MODELS[builder])}.")
    return MODELS[builder][model]


GATE_LOCK_WAIT = 45


def refresh_context(task):
    destination = task.path / ".work/context"
    # Never traverse lane-controlled links, including dangling links and links
    # to directories. Clean recursively before reading or changing permissions.
    def clean(path):
        if path.is_symlink() or (path.exists() and not path.is_dir() and not path.is_file()):
            path.unlink()
        elif path.is_dir():
            for entry in path.iterdir():
                clean(entry)

    clean(destination)
    if destination.is_file():
        destination.unlink()
    destination.mkdir(parents=True, exist_ok=True)
    sources = [task.kb / "INTENT.md", task.kb / "STATUS.md"]
    if task.file:
        sources.append(task.file)
        text = task.file.read_text()
        for decision in (task.kb / "backlog/decisions").glob("*.md"):
            if decision.name in text or re.search(r"\b" + re.escape(decision.stem.split(" - ")[0]) + r"\b", text, re.I):
                sources.append(decision)
    expected = {source.relative_to(task.kb) for source in sources if source.is_file()}
    for target in destination.rglob("*"):
        if target.is_file() and target.relative_to(destination) not in expected:
            target.chmod(0o644)
            target.unlink()
            print(f"Context source removed: {target.relative_to(destination)}")
    for source in sources:
        if not source.is_file():
            continue
        target = destination / source.relative_to(task.kb)
        for parent in reversed(target.relative_to(destination).parents):
            directory = destination / parent
            if directory.is_symlink() or directory.is_file():
                directory.unlink()
            directory.mkdir(exist_ok=True)
        target.parent.mkdir(parents=True, exist_ok=True)
        content = source.read_bytes()
        if target.is_symlink():
            target.unlink()
        elif target.is_dir():
            shutil.rmtree(target)
        if not target.exists() or target.read_bytes() != content:
            if target.exists():
                target.chmod(0o644)
            fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o644)
            with os.fdopen(fd, "wb") as output:
                output.write(content)
        target.chmod(0o444)


def archive_lane_final(work):
    final, report = work / "final.md", work / "report.md"
    text = report.read_text() if report.is_file() else ""
    lines = text.rstrip().splitlines()
    blocked = lines.pop() if lines and lines[-1].startswith("BLOCKED:") else ""
    if final.exists() or blocked:
        number = 1
        while (work / f"final-{number}.md").exists():
            number += 1
        archived = work / f"final-{number}.md"
        if final.exists():
            final.rename(archived)
        if blocked:
            with archived.open("a") as stream:
                stream.write("\n" + blocked + "\n")
            report.write_text("\n".join(lines).rstrip() + "\n")


def lane(args):
    task = Task(resolve_repo(args.repo), args.id)
    path = task.worktree()
    record = load_record(task)
    refresh_context(task)
    builder = args.builder or record["builder"]
    model = args.model or ("gpt-6-luna" if builder == "codex" else "sonnet")
    cli_model = resolve_model(builder, model)
    until = active_boosts().get(builder)
    if until and not args.no_boost and not args._worker:
        upgraded = "gpt-6-astra" if builder == "codex" else "fable"
        boost_notice = f"boost: {model} -> {upgraded} (until {until})"
        model = cli_model = upgraded
    else:
        boost_notice = ""
    work = path / ".work"
    prompt = work / "prompt.md"
    if not prompt.is_file():
        raise Stop(f"Missing lane prompt: {prompt}; the PM must write it before dispatch.")
    request = work / "request.md"
    if not request.exists():
        request.write_bytes(prompt.read_bytes())
    binary = builder
    if not shutil.which(binary):
        raise Stop(f"{binary} is not installed or available on PATH.")
    final = work / "final.md"
    command = (["codex", "exec", "--sandbox", "workspace-write", "--model", cli_model,
                "--output-last-message", str(final), "-"] if builder == "codex" else
               ["claude", "-p", "--model", cli_model, "--effort", "high",
                "--permission-mode", "acceptEdits", "--allowedTools", "Bash Read Write Edit Glob Grep"])
    lane_record = work / "lane.json"
    with (work / "lane.lock").open("a") as lock:
        # The worker waits for the launcher to publish its pid before proceeding.
        fcntl.flock(lock, fcntl.LOCK_EX)
        if args._worker:
            run = json.loads(lane_record.read_text())
            if run.get("pid") != os.getpid():
                raise Stop("Lane ownership changed before the worker started.")
        else:
            try:
                previous = json.loads(lane_record.read_text())
            except (OSError, json.JSONDecodeError):
                previous = {}
            if previous.get("state") == "running" and pid_alive(previous.get("pid")):
                raise Stop(f"Lane already running (pid {previous['pid']}); see {work / 'lane.log'}.")
            if boost_notice:
                print(boost_notice)
            archive_lane_final(work)
            worker = [sys.executable, str(Path(__file__).resolve()), "lane", str(task.repo), task.id,
                      "--builder", builder, "--model", model, "--no-boost", "--_worker"]
            if args.timeout is not None:
                worker.extend(["--timeout", str(args.timeout)])
            with (work / "lane.log").open("wb") as log:
                child = subprocess.Popen(worker, cwd=path, env=agent_environment(),
                                         stdin=subprocess.DEVNULL, stdout=log,
                                         stderr=subprocess.STDOUT, start_new_session=True,
                                         close_fds=True)
            atomic_json(lane_record, {"state": "running", "pid": child.pid,
                                      "builder": builder, "model": model, "cli_model": cli_model,
                                      "started_at": utc_now(), "ended_at": ""})
            if builder != record["builder"]:
                print(f"Updating task builder from {record['builder']} to {builder}.")
                record["builder"] = builder
                record["revision"] = record_revision(record)
                atomic_json(task_state(task) / "task.json", record)
            print(f"Started sandboxed {builder} lane (pid {child.pid}); "
                  f"see {work / 'lane.log'} and {final}; track it with `task status`.")
            return 0
    code = 1
    timed_out = False
    temporary = None
    try:
        environment = lane_environment(task, builder)
        if builder == "claude":
            temporary = environment["TMPDIR"]
            run["temporary"] = temporary
            atomic_json(lane_record, run)
            settings = work / "claude-settings.json"
            atomic_json(settings, {"sandbox": {"filesystem": {"allowWrite": [
                environment["TMPDIR"], str(gate_directory().resolve()),
            ]}}})
            command.extend(["--settings", str(settings)])
        with tempfile.TemporaryFile() as source:
            source.write(b"Read the pinned task context in .work/context/ before working.\n\n" + prompt.read_bytes())
            source.seek(0)
            with final.open("wb") if builder != "codex" else contextlib.nullcontext() as output:
                child = subprocess.Popen(command, cwd=path, env=environment, stdin=source,
                                         stdout=subprocess.PIPE if output else None)
                try:
                    deadline = time.monotonic() + args.timeout * 60 if args.timeout is not None else None
                    with selectors.DefaultSelector() as reader:
                        if output:
                            reader.register(child.stdout, selectors.EVENT_READ)
                        while reader.get_map() or child.poll() is None:
                            remaining = deadline - time.monotonic() if deadline is not None else None
                            if remaining is not None and remaining <= 0:
                                raise subprocess.TimeoutExpired(command, args.timeout * 60)
                            for key, _ in reader.select(min(0.1, remaining) if remaining is not None else 0.1):
                                chunk = os.read(key.fd, 65536)
                                if not chunk:
                                    reader.unregister(key.fileobj)
                                    continue
                                output.write(chunk)
                                output.flush()
                                sys.stdout.buffer.write(chunk)
                                sys.stdout.buffer.flush()
                    code = child.wait()
                except subprocess.TimeoutExpired:
                    timed_out = True
                    run.update(state="timed_out", exit_code=None, ended_at=utc_now())
                    cleanup_lane_temporary(temporary)
                    atomic_json(lane_record, run)
                    os.killpg(os.getpgrp(), signal.SIGKILL)
    except OSError as error:
        print(f"Lane launch failed: {error}", file=sys.stderr)
    finally:
        cleanup_lane_temporary(temporary)
        run.update(state="timed_out" if timed_out else "finished", exit_code=None if timed_out else code, ended_at=utc_now())
        atomic_json(lane_record, run)
    return code


def foreground_lock(args):
    global CHECK_ADVISORY
    if args.command == "check":
        if args.id is None:
            top = Path(git(Path.cwd(), "rev-parse", "--show-toplevel"))
            task = Task(main_repo(top), top.name)
        else:
            repo = resolve_repo(args.repo) if args.repo else main_repo(Path.cwd())
            task = Task(repo, args.id)
        CHECK_ADVISORY = advisory_check_for(task)
        if CHECK_ADVISORY or os.environ.get("TASK_RUN_RECORD"):
            return None
    elif args.command == "merge" and not os.environ.get("TASK_RUN_RECORD"):
        task = Task(resolve_repo(args.repo), args.id)
    else:
        return None
    state = task_state(task)
    state.mkdir(parents=True, exist_ok=True)
    lock = state / "run.lock"
    try:
        fd = os.open(lock, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
    except FileExistsError:
        if task_lock_status(task, repair=True) == "running":
            raise Stop("A task run is already live; wait for it or use `task cancel`.")
        try:
            fd = os.open(lock, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
        except FileExistsError:
            raise Stop("A task run is already starting; try again shortly.")
    started = utc_now()
    run_id = os.environ.setdefault("TASK_RUN_ID", secrets.token_hex(16))
    with os.fdopen(fd, "w") as output:
        json.dump({"pid": os.getpid(), "started_at": started, "command": args.command,
                   "mode": "foreground", "task_run_id": run_id}, output)
    atomic_json(state / "run.json", {"command": args.command, "state": "foreground",
                                      "pid": os.getpid(), "started_at": started,
                                      "task_run_id": run_id, "completed": []})
    global ACTIVE_FOREGROUND_TASK
    ACTIVE_FOREGROUND_TASK = task
    return lock


def finish_detached(code):
    path = os.environ.get("TASK_RUN_RECORD")
    if not path:
        return
    run_path = Path(path)
    archive = Path(os.environ["TASK_RUN_ARCHIVE"]) if os.environ.get("TASK_RUN_ARCHIVE") else None
    try:
        source = run_path if run_path.is_file() else archive
        record = json.loads(source.read_text()) if source and source.is_file() else {}
        if record.get("state") == "running":
            record["state"] = "passed" if code == 0 else "failed"
            record["ended_at"] = utc_now()
            if run_path.parent.is_dir():
                atomic_json(run_path, record)
            if archive:
                atomic_json(archive, record)
        (run_path.parent / "run.lock").unlink(missing_ok=True)
    except (OSError, json.JSONDecodeError):
        pass


# --- environment for a new worktree ------------------------------------------------------------

def exclude(repo, pattern):
    """Add a pattern to the repository's local exclude file (never a tracked file)."""
    path = Path(git(repo, "rev-parse", "--path-format=absolute", "--git-common-dir")) / "info/exclude"
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        lines = path.read_text().splitlines() if path.exists() else []
        if pattern not in lines:
            with path.open("a") as handle:
                handle.write(pattern + "\n")
    except OSError:
        # Advisory checks must still run when the checkout's local Git metadata is read-only.
        pass


def editable_install(venv: Path, repo: Path) -> bool:
    """True when the venv imports the project from the main checkout (any editable backend)."""
    for site in venv.glob("lib/python*/site-packages"):
        for pth in site.iterdir():
            if pth.name.startswith(("__editable__", "_editable_impl_")):
                return True
            if pth.suffix != ".pth" or not pth.is_file():
                continue
            for line in pth.read_text(errors="replace").splitlines():
                line = line.strip()
                if line and not line.startswith(("#", "import")):
                    target = Path(line)
                    if target.is_absolute() and (target.resolve() == repo.resolve()
                                                 or repo.resolve() in target.resolve().parents):
                        return True
    return False


def prepare_environment(repo: Path, path: Path):
    """Give the worktree the main checkout's environment so `just check` runs there as well.

    node_modules and a plain .venv are shared through a symlink: tests import the worktree's own
    code first. A .venv with the project installed in editable mode would test the main checkout's
    code, so the worktree gets its own venv with the same packages (uv, from its cache)."""
    for name in ("node_modules", ".venv"):
        source, target = repo / name, path / name
        if not source.is_dir() or target.exists() or target.is_symlink():
            continue
        exclude(repo, name)
        if name == ".venv" and editable_install(source, repo):
            for pattern in (".work/", "*.egg-info/"):
                exclude(repo, pattern)
            python = source / "bin/python"
            pins = path / ".work/requirements.txt"
            pins.parent.mkdir(exist_ok=True)
            steps = [["uv", "pip", "freeze", "--python", str(python), "--exclude-editable"],
                     ["uv", "venv", "-q", "--python", str(python.resolve()), str(target)],
                     ["uv", "pip", "install", "-q", "--python", str(target / "bin/python"), "-r", str(pins)],
                     ["uv", "pip", "install", "-q", "--python", str(target / "bin/python"),
                      "--no-deps", "-e", str(path)]]
            for number, step in enumerate(steps):
                try:
                    result = subprocess.run(step, cwd=path, capture_output=True, text=True)
                except FileNotFoundError:
                    print("warning: uv is not installed; the worktree has no .venv.")
                    break
                if result.returncode:
                    print(f"warning: could not build {target} ({' '.join(step[:3])}): "
                          f"{result.stderr.strip()[-300:]}")
                    break
                if number == 0:
                    pins.write_text(result.stdout)
            else:
                print(f"Built {target} (same packages as the main checkout, project installed from the worktree).")
        else:
            target.symlink_to(source)
            print(f"Linked {target} -> {source}.")


@contextmanager
def advisory_check_lock(path: Path):
    """Protect the shared advisory log from concurrent lane checks in this worktree."""
    work = path / ".work"
    work.mkdir(exist_ok=True)
    lock_path = work / "check.lock"
    with lock_path.open("a+", encoding="utf-8") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            lock.seek(0)
            owner = lock.read().strip() or "an active check (owner details unavailable)"
            raise Stop(f"Advisory check already running: {owner}; refusing to overwrite {work / 'check.log'}.")
        owner = f"pid {os.getpid()} for {path} (branch {git(path, 'branch', '--show-current') or 'detached'})"
        lock.seek(0)
        lock.truncate()
        lock.write(owner + "\n")
        lock.flush()
        try:
            yield
        finally:
            fcntl.flock(lock, fcntl.LOCK_UN)


def check_step_environment(run_id):
    """Keep local mock traffic off the sandbox proxy without changing proxy settings."""
    child_env = dict(os.environ, TASK_RUN_ID=run_id)
    bypass = ("localhost", "127.0.0.1", "::1")
    for name in ("NO_PROXY", "no_proxy"):
        existing = child_env.get(name, "")
        child_env[name] = ",".join(part for part in (existing.rstrip(","), *bypass) if part)
    return child_env


def trusted_check_environment(path, run_id, gate_environment):
    allowed = {"PATH", "HOME", "USER", "LOGNAME", "LANG", "TERM", "SHELL"}
    environment = {key: value for key, value in os.environ.items()
                   if key in allowed or key.startswith("LC_")}
    environment.update(configured_environment(path))
    environment.update(gate_environment)
    # Keep cancellation of descendants in new sessions without inheriting TASK_RUN_*.
    environment["TASK_GATE_RUN_ID"] = run_id
    return environment


def advisory_pre_commit_environment(path: Path, child_env):
    """Give advisory pre-commit its own disposable index inside the writable worktree."""
    work = path / ".work"
    directory = Path(tempfile.mkdtemp(prefix="pre-commit-index-", dir=work))
    try:
        private_index = directory / "index"
        real_index = Path(git(path, "rev-parse", "--path-format=absolute", "--git-path", "index"))
        if real_index.is_file():
            shutil.copyfile(real_index, private_index)
        else:
            private_env = dict(child_env, GIT_INDEX_FILE=str(private_index))
            result = subprocess.run(["git", "-C", str(path), "read-tree", "HEAD"],
                                    env=private_env, capture_output=True, text=True)
            if result.returncode:
                raise Stop(f"Could not seed advisory pre-commit index: {(result.stderr or result.stdout).strip()}")
    except BaseException:
        shutil.rmtree(directory, ignore_errors=True)
        raise
    return dict(child_env, GIT_INDEX_FILE=str(private_index)), directory


# --- commands ----------------------------------------------------------------------------------

def seed_source(repo, name):
    source_root = repo / ".work"
    if not re.fullmatch(r"[A-Za-z0-9_.-]+", name) or name in {".", ".."}:
        raise Stop(f"Invalid seed name: {name!r}.")
    if source_root.is_symlink():
        raise Stop("Seed .work directories must not be symlinks.")
    source = source_root / name
    if not source.exists():
        raise Stop(f"Seed does not exist: {source}.")
    for entry in [source] + (list(source.rglob("*")) if source.is_dir() else []):
        if not entry.resolve().is_relative_to(source_root.resolve()):
            raise Stop(f"Seed symlink escapes .work: {entry}.")
    return source


def seed_worktree(repo, path, names):
    source_root = repo / ".work"
    destination_root = path / ".work"
    if destination_root.is_symlink():
        raise Stop("Seed .work directories must not be symlinks.")
    sources = [seed_source(repo, name) for name in names]
    destination_root.mkdir(parents=True, exist_ok=True)
    for source in sources:
        destination = destination_root / source.name
        if destination.exists() or destination.is_symlink():
            continue
        if source.is_dir():
            shutil.copytree(source, destination, symlinks=True)
        else:
            shutil.copy2(source, destination)


def runner_check(args):
    repo = resolve_repo(args.repo)
    problems, builders, seen_tasks = [], {}, set()
    task_lines = 0
    pending = []
    in_text_rules = False
    task_line = re.compile(
        r"(?i)^\s*(?:\d+\.|[-*])\s+([^:\s]+):\s*builder\s+(codex|claude),\s*"
        r"model\s+([^,\s]+)(?:,\s*seed\s+([^,\s]+))?(?:,\s*after:\s*([^,\s]+))?"
        r"(?:\b.*)?$"
    )
    no_verify_field = re.compile(r"(?i),\s*no-verify:\s*(.*?)(?=,\s*(?:seed\s|after:|no-verify:)|$)")
    for number, line in enumerate(Path(args.file).read_text().splitlines(), 1):
        if re.match(r"^\s*```text\s*$", line, re.IGNORECASE):
            in_text_rules = True
            continue
        if in_text_rules:
            if re.match(r"^\s*```\s*$", line):
                in_text_rules = False
            continue
        # Keep this small denylist aligned with system/agent-policy/pre_tool_use.py.
        if re.search(r"<<|\b(?:nohup|setsid|xargs|sudo)\b|\bcp\s+(?:--recursive|--archive|-[A-Za-z]*[arR])", line):
            problems.append(f"line {number}: construct blocked by the policy hook")
        no_verify_match = no_verify_field.search(line)
        parsed = task_line.match(no_verify_field.sub("", line))
        if parsed:
            task_lines += 1
            ident, builder, model, seed, after = parsed.groups()
            no_verify = no_verify_match[1].strip() if no_verify_match else None
            try:
                task = Task(repo, ident)
                check_plan(task)
                if not (task_state(task) / "merge.json").exists():
                    pending.append(task.id)
                if task.number is not None and task.file is None:
                    raise Stop(f"No Backlog.md task {task.id}")
                resolve_model(builder.lower(), model)
                if no_verify is not None:
                    if not no_verify.strip():
                        raise Stop("no-verify needs a nonempty reason.")
                    if task.file and verification_from(task.file.read_text()):
                        raise Stop("--no-verify is only valid when the task has no Verify lines.")
                if seed:
                    seed_source(repo, seed)
                if after:
                    normalized_after = Task(repo, after).id.lower()
                    if normalized_after not in seen_tasks:
                        raise Stop(f"after: {after} must name an earlier task in the file.")
                seen_tasks.add(task.id.lower())
            except Stop as error:
                problems.append(f"line {number}: {error}")
            continue
        if re.match(r"(?i)^\s*(?:\d+\.|[-*])\s+[^:\s]+:\s*builder\b", line):
            problems.append(f"line {number}: invalid runner task line")
        for match in re.finditer(r"\btask\s+(start|lane)\s+([^`\n;&|]+)", line):
            try:
                tokens = shlex.split(match.group(2))
                if len(tokens) < 2:
                    raise Stop("task command needs a repo and task id")
                model_token = (tokens[tokens.index("--model") + 1]
                               if "--model" in tokens and tokens.index("--model") + 1 < len(tokens) else "")
                if any("<" in token or ">" in token for token in (tokens[0], tokens[1], model_token)):
                    continue
                ident = tokens[1]
                task = Task(repo, ident)
                if task.number is not None and task.file is None:
                    raise Stop(f"No Backlog.md task {task.id}")
                def option(flag, default=None):
                    if flag in tokens:
                        return tokens[tokens.index(flag) + 1]
                    return default
                builder = option("--builder", builders.get(task.id))
                if match.group(1) == "start":
                    if builder not in MODELS:
                        raise Stop("task start requires --builder codex|claude")
                    builders[task.id] = builder
                else:
                    if builder not in MODELS:
                        raise Stop("lane needs a preceding start or --builder codex|claude")
                    resolve_model(builder, option("--model", "gpt-6-luna" if builder == "codex" else "sonnet"))
                    builders[task.id] = builder
            except (Stop, ValueError, IndexError) as error:
                problems.append(f"line {number}: {error}")
    if task_lines == 0:
        problems.append("no task lines found (format: N. <id>: builder <b>, model <m>[, seed <s>][, after: <id>])")
    if (CORTEX / f"cortex-kb-{repo.name}").exists():
        info = plan_info(repo)
        remaining = info["limit"] - len(info["merged"])
        if pending and len(pending) > remaining:
            print(f"warning: realignment stop at {pending[max(0, remaining)]} ({info['limit']} merged tasks)")
    if problems:
        print("\n".join(problems))
        return 1
    print(f"runner file OK ({task_lines} tasks)")
    return 0


RUNNER_WRAPPER = '''import pathlib, signal, subprocess, sys
source, done, log, executable, offset, mode, repo = sys.argv[1:]
child = None
def stop(signum, frame):
    if child is not None:
        child.terminate()
signal.signal(signal.SIGTERM, stop)
signal.signal(signal.SIGHUP, signal.SIG_IGN)
code = 1
try:
    with open(source) as stream:
        command = ([executable, 'exec', '--dangerously-bypass-approvals-and-sandbox',
                    '-m', 'gpt-6-luna', '-'] if mode == 'llm' else [executable, repo, source])
        child = subprocess.Popen(command, stdin=stream if mode == 'llm' else subprocess.DEVNULL)
        code = child.wait()
finally:
    path = pathlib.Path(done)
    content = path.read_bytes() if path.exists() else b''
    text = content.decode()
    lines = content[int(offset):].decode().splitlines()
    last = lines[-1] if lines else ''
    if last != 'batch: finished' and not last.startswith('batch: stopped:'):
        with path.open('a') as stream:
            if text and not text.endswith('\\n'):
                stream.write('\\n')
            stream.write(f'batch: stopped: runner exited (code {code}) without a final line; see {log}\\n')
sys.exit(code if code >= 0 else 128 - code)
'''


def runner_unit(repo, batch):
    if not re.fullmatch(r'[A-Za-z0-9_-]+', repo.name + batch):
        raise Stop('Runner repo and batch names must contain only letters, digits, _ or -.')
    return f'task-runner-{repo.name}-{batch}'


def runner_service(unit):
    try:
        result = subprocess.run(['systemctl', '--user', 'show', unit,
                                 '--property=ActiveState,ExecMainStartTimestamp'],
                                capture_output=True, text=True)
        return dict(line.split('=', 1) for line in result.stdout.splitlines() if '=' in line)
    except OSError:
        return {}


def runner_start(args):
    repo = main_repo(resolve_repo(args.repo))
    source = Path(args.file).resolve()
    match = re.fullmatch(r'runner-([A-Za-z0-9_-]+)\.md', source.name)
    if not match:
        raise Stop('Runner file must be named runner-<batch>.md.')
    if runner_check(args):
        return 1
    batch = match[1]
    unit = runner_unit(repo, batch)
    work = repo / '.work'
    work.mkdir(exist_ok=True)
    record = work / f'runner-{batch}.json'
    service = runner_service(unit)
    if service.get('ActiveState') in {'active', 'activating', 'deactivating', 'reloading'}:
        raise Stop(f'{unit} is already active.')
    if record.exists():
        previous = json.loads(record.read_text())
        if previous.get('backend') == 'setsid' and pid_alive(previous.get('pid')):
            raise Stop(f'{unit} is already active (setsid).')
    binary = 'codex' if args.llm else 'task-batch'
    executable = shutil.which(binary)
    if not executable:
        raise Stop(f'{binary} is unavailable.')
    wrapper = work / f'runner-{batch}-watch.py'
    wrapper.write_text(RUNNER_WRAPPER)
    log = work / f'runner-{batch}.log'
    done = work / f'runner-{batch}.done'
    done_offset = done.stat().st_size if done.exists() else 0
    command = [sys.executable, str(wrapper), str(source), str(done),
               str(log), executable, str(done_offset), 'llm' if args.llm else 'batch', str(repo)]
    launch = ['systemd-run', '--user', '--unit', unit, '--collect',
              '--working-directory', str(repo), '--property=StandardInput=null',
              '--property=KillMode=process',
              f'--property=StandardOutput=append:{log}', f'--property=StandardError=append:{log}',
              '--setenv=PATH=' + os.environ.get('PATH', ''), *command]
    try:
        result = subprocess.run(launch, capture_output=True, text=True)
    except FileNotFoundError:
        result = None
    data = dict(unit=unit, started_at=utc_now(), backend='systemd', done_offset=done_offset)
    if result is None or result.returncode:
        # A failed launch can race another caller; never duplicate an active service.
        if runner_service(unit).get('ActiveState') in {'active', 'activating'}:
            raise Stop(f'{unit} is already active.')
        with log.open('a') as output:
            process = subprocess.Popen(command, cwd=repo, stdin=subprocess.DEVNULL,
                                       stdout=output, stderr=output, start_new_session=True)
        data.update(backend='setsid', pid=process.pid)
        print('systemd-run --user unavailable; falling back to setsid (new session).')
    atomic_json(record, data)
    print(f'{unit}: log={log}')
    return 0


def start(args):
    repo = resolve_repo(args.repo)
    ensure_origin_head(repo)
    task = Task(repo, args.id)
    if args.off_plan is not None and not args.refresh and (task_state(task) / "task.json").is_file():
        raise Stop("--off-plan on a resumed task requires --refresh")
    off_plan = args.off_plan
    if args.refresh and off_plan is None:
        off_plan = read_json_object(task_state(task) / "task.json").get("off_plan") or None
    check_plan(task, off_plan, refresh=args.refresh)
    if task.number is not None and task.file is None:
        raise Stop(f"No Backlog.md task {task.id} in {task.kb}.")
    task_text = task.file.read_text() if task.file else ""
    criteria = criteria_from(task_text)
    verify = verification_from(task_text)
    if task.file and not criteria:
        raise Stop(f"{task.file} has no acceptance criteria.")
    if task.file and not verify and not args.no_verify:
        raise Stop(f"{task.file} has no `Verify: `command`` line; add one or use --no-verify \"reason\".")
    if args.no_verify and verify:
        raise Stop("--no-verify is only valid when the task has no Verify lines.")
    if not (repo / "justfile").exists() and not (repo / "Justfile").exists():
        raise Stop(f"No justfile in {repo}; the repository needs a `just check` recipe.")
    for command in verify:
        try:
            tokens = shlex.split(command)
        except ValueError as error:
            raise Stop(f"Invalid Verify command `{command}`: {error}.")
        if not tokens:
            raise Stop("A Verify line needs a command.")
        if tokens == ["just", "check"]:
            raise Stop("Verify `just check` is redundant: `task check` already runs it before the Verify commands.")
        probe = subprocess.run(["bash", "-c", 'command -v -- "$1" >/dev/null 2>&1',
                                "task-preflight", tokens[0]],
                               capture_output=True, text=True)
        if probe.returncode:
            raise Stop(f"Verification command `{tokens[0]}` is not installed or available in bash.")
    default = default_branch(repo)
    main_branch = run_git(repo, "branch", "--show-current").stdout.strip()
    if main_branch != default:
        print(f"warning: main checkout is on {main_branch or 'detached'}, not default branch {default}.")
    if has_origin(repo):
        fetch(repo)
        remote = f"origin/{default}"
        if not ok(repo, "rev-parse", "--verify", "--quiet", remote):
            print("warning: origin default branch is not fetched; preflight could not check whether it is behind.")
        else:
            local = run_git(repo, "rev-parse", "--verify", "--quiet", f"refs/heads/{default}").stdout.strip()
            upstream = sha(repo, remote)
            if local and not is_ancestor(repo, local, upstream):
                print(f"warning: main checkout {default} is not a fast-forward behind {remote}.")
            elif local and local != upstream:
                print(f"warning: main checkout {default} is behind {remote}.")
    for name in (".venv", "node_modules"):
        candidate = repo / name
        if candidate.is_symlink() and not candidate.exists():
            print(f"warning: environment link {candidate} does not resolve.")
    if task.path.exists():
        task.worktree()
        print(f"{task.path} already exists.")
    else:
        default = default_branch(repo)
        fetch(repo)
        exclude(repo, ".worktrees/")
        branch, remote_only = task.existing_branch()
        if branch and remote_only:
            git(repo, "worktree", "add", "-q", "--track", "-b", branch, str(task.path), f"origin/{branch}")
            print(f"Created {task.path} on {branch}, from origin's existing branch.")
        elif branch:
            for block in git(repo, "worktree", "list", "--porcelain").split("\n\n"):
                lines = block.splitlines()
                checked_out = next((line[len("worktree "):]
                                    for line in lines if line.startswith("worktree ")), None)
                checked_branch = next((line[len("branch refs/heads/"):]
                                       for line in lines if line.startswith("branch refs/heads/")), None)
                if checked_branch == branch and checked_out and Path(checked_out).resolve() != task.path.resolve():
                    raise Stop(f"Branch {branch} is already checked out at {checked_out}; "
                               f"move or free that worktree before `task start` can adopt it at {task.path}.")
            git(repo, "worktree", "add", "-q", str(task.path), branch)
            print(f"Created {task.path} on the existing branch {branch}.")
        else:
            base, label = base_commit(repo, default)
            branch = task.branch_name()
            git(repo, "worktree", "add", "-q", "--no-track", "-b", branch, str(task.path), base)
            print(f"Created {task.path} on {branch} from {label} {base[:7]}.")
    seed_worktree(repo, task.path, args.seed)
    prepare_environment(repo, task.path)
    exclude(task.path, ".work/")
    branch = git(task.path, "branch", "--show-current")
    default_ref = f"origin/{default}" if has_origin(repo) and ok(
        repo, "rev-parse", "--verify", "--quiet", f"origin/{default}") else default
    base = git(task.path, "merge-base", "HEAD", default_ref)
    work = task.path / ".work"
    state = task_state(task)
    record_path = state / "task.json"
    state.mkdir(parents=True, exist_ok=True)
    work.mkdir(parents=True, exist_ok=True)
    if record_path.exists() and not args.refresh:
        record = load_record(task)
        if record.get("branch") != branch:
            raise Stop("The worktree branch differs from its pinned record; use --refresh after PM review.")
    else:
        previous_seeds = read_json_object(record_path).get("seeds", []) if record_path.exists() else []
        record = {"id": task.id, "title": task.title, "branch": branch, "base_sha": base,
                  "builder": args.builder, "started_at": utc_now(), "criteria": criteria,
                  "verify": verify, "no_verify": args.no_verify or "", "off_plan": off_plan or "",
                  "milestone": frontmatter_value(task_text, "milestone"),
                  "seeds": list(dict.fromkeys(previous_seeds + args.seed))}
        record["revision"] = record_revision(record)
        atomic_json(record_path, record)
        if args.refresh:
            for stale in (state / "exception.json", state / "review.json", state / "review.md"):
                stale.unlink(missing_ok=True)
        report = work / "report.md"
        if not report.exists() or args.refresh and not report_is_filled(report):
            report.write_text("# Task report\n\n## What changed\n\n(fill in)\n\n## How I verified\n\n(fill in)\n\n## Criteria\n\n" +
                              "\n".join(f"#{item['number']} not met: (fill in)" for item in criteria) +
                              "\n\n## Check\n\n(fill in)\n\n## Noticed, not done\n\n(none)\n")
    seeds = list(dict.fromkeys(record.get("seeds", []) + args.seed))
    if seeds != record.get("seeds", []):
        record["seeds"] = seeds
        record["revision"] = record_revision(record)
        atomic_json(record_path, record)
    if args.no_verify:
        print(f"exception: verification omitted: {args.no_verify}")
    if "Verification and tools" in task_text:
        section = re.search(r"(?ms)^#{1,6} Verification and tools\s*\n(.*?)(?=^#{1,6} |\Z)", task_text)
        print("\nVerification and tools:\n" + (section.group(1).strip() if section else ""))
    if record.get("off_plan"):
        print(f"off-plan exception: {record['off_plan']}")
    title = f" - {task.title}" if task.title else ""
    print("\nDispatch prompt:\n")
    refresh_context(task)
    dispatch = ["Context: .work/context/", f"{task.id}{title}",
                f"Work only in {task.path} on branch {branch}.",
                "Write and edit files with your edit or apply_patch tool, never shell heredocs or cat >; "
                "avoid backticks in shell commands."]
    if task.file:
        dispatch.append(f"Task: {task.file}")
    brief = task_text or ((work / "request.md").read_text() if (work / "request.md").is_file() else "")
    for heading in ("Read first", "Test against"):
        dispatch.append(f"{heading}:\n{brief_field(brief, heading) or '(PM: none given)'}")
    dispatch.append("Commit on the branch, then run `task check` from that folder for advisory feedback, "
          "before reporting. Paste its final summary line (PASS/FAIL plus the log path) under `## Check` "
          "in `.work/report.md`; a claim like 'tests pass' without that line is not evidence. "
          "Check the final commit; any later commit needs a new check. The PM's `task merge` "
          "runs the trusted gate, unless a matching trusted check already passed. A PM may run "
          "`task check --detach` to prepare that evidence. In chat, reply with three lines: `changed: ...`, "
          "`verified: ...`, and `not done: ...`, followed by `report written`. "
          "For long gates, the PM can use `task merge --detach`.")
    dispatch.append(f"The PM writes the approved prompt to {work / 'prompt.md'} and launches the builder with "
          f"`task lane {args.repo} {task.id}`. Always use `task lane` so builders stay sandboxed.")
    dispatch_text = "\n".join(dispatch) + "\n"
    (work / 'dispatch.md').write_text(dispatch_text)
    print(dispatch_text, end="")


def sweep_gate_temporary(root):
    """Remove only old, owned gate directories whose recorded holder is dead."""
    cutoff = time.time() - 24 * 60 * 60
    for directory in root.glob("gate-*"):
        try:
            info = directory.lstat()
            if (not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid()
                    or info.st_mtime >= cutoff):
                continue
            holder = directory / "holder.pid"
            info = holder.lstat()
            if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
                    or info.st_size > 32):
                continue
            pid = int(holder.read_text())
            if pid <= 0:
                continue
            try:
                os.kill(pid, 0)
            except ProcessLookupError:
                shutil.rmtree(directory)
        except (OSError, ValueError, OverflowError):
            # Missing/malformed holders and inaccessible processes are not evidence of death.
            continue


def run_check(path, base, record=None, state=None, evidence_name="check.json", display_log=None,
              advisory=False, pre_commit_all_files=False, cancelled=None, variant=None):
    variants = gate_variants(path)
    configured_environment(path)  # Validate the base even when a variant overrides it.
    if variant is not None:
        if not advisory:
            raise Stop("--variant is only available for advisory lane checks.")
        if variant not in variants:
            raise Stop(f"Unknown gate variant: {variant}.")
        variants = {variant: variants[variant]}
    if variants:
        return run_check_matrix(path, base, record, state, evidence_name, display_log,
                                advisory, pre_commit_all_files, cancelled, variants)
    if advisory:
        return run_check_steps(path, base, record, state, evidence_name, display_log, advisory=True,
                               cancelled=cancelled)
    # Do not inherit TMPDIR: callers may point it inside a checkout.
    temporary_root = Path("/tmp") / f"task-gate-{os.getuid()}"
    temporary_root.mkdir(mode=0o700, exist_ok=True)
    info = temporary_root.lstat()
    if (not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid()
            or stat.S_IMODE(info.st_mode) != 0o700):
        raise Stop(f"Gate temporary parent must be an owned directory with mode 0700: {temporary_root}")
    sweep_gate_temporary(temporary_root)
    with tempfile.TemporaryDirectory(prefix="gate-", dir=temporary_root) as temporary:
        (Path(temporary) / "holder.pid").write_text(str(os.getpid()) + "\n")
        with gate_port_index(path) as slot:
            environment = {"TMPDIR": temporary, "TASK_GATE_SLOT": str(slot),
                           "TASK_GATE_PORT_BASE": str(20000 + 200 * slot)}
            return run_check_steps(path, base, record, state, evidence_name, display_log,
                                   gate_environment=environment, pre_commit_all_files=pre_commit_all_files,
                                   cancelled=cancelled)


def run_check_matrix(path, base, record, state, evidence_name, display_log,
                     advisory, pre_commit_all_files, cancelled, variants):
    work = path / ".work"
    work.mkdir(exist_ok=True)
    destination = work if advisory else (state or task_state(Task(main_repo(path), path.name)))
    destination.mkdir(parents=True, exist_ok=True)
    results = []
    logs = []
    # Reserve the port range once, including for drills without an exclusive slot.
    with gate_port_index(path) as slot:
        for name, environment in variants.items():
            # Advisory checks need a writable parent inside their lane.
            with tempfile.TemporaryDirectory(prefix="variant-", dir=work if advisory else "/tmp") as temporary:
                gate_environment = dict(environment, TMPDIR=temporary, TASK_GATE_SLOT=str(slot),
                                        TASK_GATE_PORT_BASE=str(20000 + 200 * slot))
                evidence = []
                passed = run_check_steps(
                    path, base, record, state, evidence_name, display_log, advisory=advisory,
                    gate_environment=gate_environment, pre_commit_all_files=pre_commit_all_files,
                    cancelled=cancelled, evidence_sink=evidence)
                results.append(dict(evidence[0], name=name))
                logs.append(f"=== variant {name} ===\n" + (work / "check.log").read_text())
                print(f"variant {name}: {'PASS' if passed else 'FAIL'}")
    log = work / "check.log"
    log.write_text("\n".join(logs))
    passed = all(row["result"] == "passed" for row in results)
    evidence = {key: value for key, value in results[0].items() if key not in {"name", "steps", "result"}}
    evidence.update(result="passed" if passed else "failed", variants=results,
                    steps=[step for row in results for step in row["steps"]])
    save_check_evidence(destination, evidence_name, evidence, log)
    if not advisory and evidence_name == "check.json":
        try: task_event(Task(main_repo(path), path.name), "check")
        except OSError: pass
    print(("PASS" if passed else "FAIL") + f" (log: {display_log or log})")
    return passed


def run_check_steps(path, base, record=None, state=None, evidence_name="check.json", display_log=None,
                    advisory=False, gate_environment=None, pre_commit_all_files=False, cancelled=None,
                    evidence_sink=None):
    """Run the repository's gate in <path>; return True when it passes.

    pre-commit checks the commits since <base>; with pre_commit_all_files (the drill, which
    has no base) it checks every file instead of being skipped.
    """
    if not advisory and gate_environment is None:
        return run_check(path, base, record, state, evidence_name, display_log,
                         pre_commit_all_files=pre_commit_all_files, cancelled=cancelled)
    if not (path / "justfile").exists() and not (path / "Justfile").exists():
        raise Stop(f"No justfile in {path}; the repository needs a `just check` recipe.")
    exclude(path, ".work/")
    work = path / ".work"
    work.mkdir(exist_ok=True)
    if not advisory:
        state = state or task_state(Task(main_repo(path), path.name))
        state.mkdir(parents=True, exist_ok=True)
    else:
        state = None
    log = work / "check.log"
    passed = True
    timeout = timeout_for(path)
    configured_env = configured_environment(path)
    run_id = os.environ.get("TASK_RUN_ID") or secrets.token_hex(16)
    results = []
    with log.open("w") as out:
        steps = [["just", "check"]]
        if record:
            steps.extend([["bash", "-c", command] for command in record.get("verify", [])])
        if (path / ".pre-commit-config.yaml").exists():
            if pre_commit_all_files:
                steps.append(["pre-commit", "run", "--all-files"])
            elif base:
                steps.append(["pre-commit", "run", "--from-ref", base, "--to-ref", "HEAD"])
        for step in steps:
            if cancelled and cancelled():
                raise Stop("Drill interrupted.")
            out.write(f"$ {' '.join(step)}\n")
            out.flush()
            started = time.monotonic()
            private_index_directory = None
            try:
                child_env = (check_step_environment(run_id) if advisory else
                             trusted_check_environment(path, run_id, gate_environment))
                if advisory:
                    child_env.update(configured_env)
                    child_env.update(gate_environment or {})
                if advisory and step[0] == "pre-commit":
                    child_env, private_index_directory = advisory_pre_commit_environment(path, child_env)
                process = subprocess.Popen(step, cwd=path, env=child_env, stdout=out,
                                           stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                                           start_new_session=True)
                if state:
                    set_child_group(state, process.pid)
                try:
                    if cancelled is None:
                        code = process.wait(timeout=timeout)
                    else:
                        deadline = time.monotonic() + timeout
                        while True:
                            if cancelled():
                                try:
                                    os.killpg(process.pid, signal.SIGTERM)
                                    time.sleep(0.2)
                                    # Descendants may survive even if the leader exits.
                                    os.killpg(process.pid, signal.SIGKILL)
                                except ProcessLookupError:
                                    pass
                                process.wait()
                                if state:
                                    set_child_group(state, None)
                                raise Stop("Drill interrupted.")
                            try:
                                code = process.wait(timeout=min(0.1, max(0, deadline - time.monotonic())))
                                break
                            except subprocess.TimeoutExpired:
                                if time.monotonic() >= deadline:
                                    raise
                except subprocess.TimeoutExpired:
                    try:
                        os.killpg(process.pid, signal.SIGKILL)
                    except ProcessLookupError:
                        pass
                    process.wait()
                    if state:
                        set_child_group(state, None)
                    out.write(f"\nTIMEOUT after {timeout}s\n")
                    out.flush()
                    results.append({"command": step, "exit": None, "duration": round(time.monotonic()-started, 3),
                                    "timeout": True})
                    evidence = {"sha": sha(path, "HEAD"), "base_sha": base or "",
                                "record_revision": record.get("revision") if record else "",
                                "result": "failed", "steps": results, "time": utc_now(),
                                "trusted": state is not None, "advisory": state is None}
                    if evidence_sink is not None:
                        evidence_sink.append(evidence)
                    elif evidence_name == "check.json" and state is None:
                        save_check_evidence(work, "check.json", evidence, log)
                    if state and evidence_sink is None:
                        save_check_evidence(state, evidence_name, evidence, log)
                        if evidence_name == "check.json":
                            try: task_event(Task(main_repo(path), path.name), "check")
                            except OSError: pass
                    print(f"NOT FINISHED: `{' '.join(step)}` ran over {timeout}s; see {display_log or log}")
                    print(f"FAIL (log: {display_log or log})")
                    return False
            except subprocess.TimeoutExpired:
                raise
            except FileNotFoundError:
                raise Stop(f"`{step[0]}` is not installed.")
            finally:
                if private_index_directory is not None:
                    shutil.rmtree(private_index_directory, ignore_errors=True)
            if state:
                set_child_group(state, None)
            out.write(f"exit {code}\n")
            results.append({"command": step, "exit": code, "duration": round(time.monotonic()-started, 3)})
            if code:
                passed = False
                break
    evidence = {"sha": sha(path, "HEAD"), "base_sha": base or "",
                "record_revision": record.get("revision") if record else "",
                "result": "passed" if passed else "failed", "steps": results,
                "time": utc_now(), "trusted": state is not None, "advisory": state is None}
    if evidence_sink is not None:
        evidence_sink.append(evidence)
    elif evidence_name == "check.json" and state is None:
        save_check_evidence(work, "check.json", evidence, log)
    if state and evidence_sink is None:
        save_check_evidence(state, evidence_name, evidence, log)
        if evidence_name == "check.json":
            try: task_event(Task(main_repo(path), path.name), "check")
            except OSError: pass
    lines = log.read_text(errors="replace").splitlines()
    summary = [line for line in lines if SUMMARY.match(line.strip())][-4:]
    for line in summary if passed else lines[-20:]:
        print("  " + line)
    print(("PASS" if passed else "FAIL") + f" (log: {display_log or log})")
    return passed


def untracked(path):
    return git(path, "status", "--porcelain", "--untracked-files=all").splitlines()


def check(args):
    global CHECK_ADVISORY
    if args.id is None:
        top = Path(git(Path.cwd(), "rev-parse", "--show-toplevel"))
        repo = main_repo(top)
        if top.resolve() == repo.resolve():
            raise Stop("Run `task check` inside the task's worktree, or name the task.")
        path = top
    else:
        repo = resolve_repo(args.repo) if args.repo else main_repo(Path.cwd())
        path = Task(repo, args.id).worktree()
    task = Task(repo, path.name)
    advisory = CHECK_ADVISORY if CHECK_ADVISORY is not None else advisory_check_for(task)
    tracked_work = git(path, "ls-files", "--", ".work")
    if tracked_work:
        raise Stop(
            f"Tracked files under .work/ ({tracked_work}): run `git rm --cached -r .work` "
            "and commit, then rerun `task check`. Never `git add -f` under .work/."
        )
    record = load_record(task, required=False)
    if task.number is not None and record is None:
        raise Stop("This worktree has no pinned task record; PM must run `task start ... --refresh --builder ...` first.")
    base, label = base_commit(repo, default_branch(repo))
    branch = git(path, "branch", "--show-current")
    print(f"{path}: {branch or 'detached'} at {sha(path, 'HEAD')[:7]}")
    changes = untracked(path)
    if changes:
        raise Stop("Uncommitted or untracked files; commit them (or delete them) first:\n" + "\n".join(changes))
    if not is_ancestor(path, base, "HEAD"):
        print(f"note: {label} has commits this branch lacks; `task merge` brings them in.")
    prepare_environment(repo, path)
    if record and record.get("no_verify"):
        print(f"exception: verification omitted: {record['no_verify']}")
    if advisory:
        print("advisory lane check (not evidence for merge)")
        with advisory_check_lock(path):
            if exclusive_gate_enabled(path, advisory=True):
                with exclusive_gate_lock(task, silent_unavailable=True, config_path=path, advisory=True):
                    passed = run_check(path, base, record, None, advisory=True, variant=args.variant)
            else:
                passed = run_check(path, base, record, None, advisory=True, variant=args.variant)
    elif exclusive_gate_enabled(path):
        with exclusive_gate_lock(task, config_path=path):
            passed = run_check(path, base, record, task_state(task), advisory=False, variant=args.variant)
    else:
        passed = run_check(path, base, record, task_state(task), advisory=False, variant=args.variant)
    return 0 if passed else 1


def ignored_leftovers(path):
    """Ignored files a removal would delete that are not disposable caches or tool folders."""
    entries = git(path, "status", "--porcelain", "--ignored", "--untracked-files=all").splitlines()
    kept = []
    for entry in entries:
        if not entry.startswith("!! "):
            continue
        parts = Path(entry[3:].strip('"')).parts
        if not any(part in DISPOSABLE or part.endswith(".egg-info") for part in parts):
            kept.append(entry[3:])
    return kept


def rebasing(gitdir: Path, branch: str) -> bool:
    for folder in ("rebase-merge", "rebase-apply"):
        head = gitdir / folder / "head-name"
        if head.is_file() and head.read_text().strip() == f"refs/heads/{branch}":
            return True
    return False


def update_local_default(repo, default, commit, *, allow_plan_changes=False):
    """Bring the local default branch to commit without touching anyone's work; report, never raise."""
    old = run_git(repo, "rev-parse", "--verify", "--quiet", f"refs/heads/{default}").stdout.strip()
    if old == commit:
        return f"local {default} is up to date"
    if old and not is_ancestor(repo, old, commit):
        return f"local {default} not updated: it has commits of its own"
    holder = None
    for block in git(repo, "worktree", "list", "--porcelain").split("\n\n"):
        lines = block.splitlines()
        if not lines:
            continue
        path = Path(lines[0][len("worktree "):])
        gitdir = run_git(path, "rev-parse", "--absolute-git-dir").stdout.strip() if path.is_dir() else ""
        if gitdir and rebasing(Path(gitdir), default):
            return f"local {default} not updated: {path} is rebasing it"
        if f"branch refs/heads/{default}" in lines:
            holder = path
    if holder is None:
        result = run_git(repo, "update-ref", f"refs/heads/{default}", commit, old or "")
        return f"local {default} updated" if result.returncode == 0 else \
            f"local {default} not updated: {result.stderr.strip()}"
    dirty = knowledge_checkout_dirty(holder) if allow_plan_changes else git(holder, "status", "--porcelain")
    if dirty:
        return f"local {default} not updated in {holder}: it has uncommitted changes"
    result = run_git(holder, "merge", "-q", "--ff-only", commit)
    if result.returncode:
        return f"local {default} not updated in {holder}: {result.stderr.strip()}"
    return f"{holder} fast-forwarded"


def sync_dependencies_after_merge(repo: Path, old_head: str, new_head: str, update_message: str):
    """Run only the repository's explicit sync recipe after an updated main changes dependencies."""
    if "not updated" in update_message or "up to date" in update_message or not old_head or old_head == new_head:
        return
    changed = git(repo, "diff", "--name-only", old_head, new_head).splitlines()
    dependency_names = {"pyproject.toml", "uv.lock", "package.json", "package-lock.json", "pnpm-lock.yaml"}
    dependencies = [name for name in changed
                    if Path(name).name in dependency_names
                    or (Path(name).name.startswith("requirements")
                        and Path(name).suffix in {".txt", ".in"})]
    if not dependencies:
        return
    files = ", ".join(dependencies)
    try:
        recipe = subprocess.run(["just", "--show", "sync"], cwd=repo, capture_output=True,
                                text=True, timeout=30)
    except FileNotFoundError:
        print(f"WARNING: dependency files changed ({files}) but `just` is not installed; "
              "the main checkout's environment is now out of date.")
        return
    except subprocess.TimeoutExpired:
        print(f"WARNING: could not determine whether `just sync` exists after dependency changes ({files}); "
              "the main checkout's environment is now out of date.")
        return
    if recipe and recipe.returncode == 0:
        try:
            result = subprocess.run(["just", "sync"], cwd=repo, capture_output=True,
                                    text=True, timeout=timeout_for(repo))
        except (FileNotFoundError, subprocess.TimeoutExpired) as error:
            result = None
            detail = str(error)
        else:
            detail = (result.stderr or result.stdout).strip()
        if result and result.returncode == 0:
            print(f"Ran `just sync` after dependency changes: {files}")
            return
        print(f"WARNING: `just sync` failed after dependency changes ({files}); "
              f"the main checkout's environment may be out of date. {detail}")
        return
    print(f"WARNING: dependency files changed ({files}) and this repository has no `just sync` recipe; "
          "the main checkout's environment is now out of date.")


def on_github(repo):
    return has_origin(repo) and "github" in git(repo, "remote", "get-url", "origin")


def gh(repo, *args):
    try:
        result = subprocess.run(["gh", *args], cwd=repo, capture_output=True, text=True, timeout=120)
    except FileNotFoundError:
        raise Stop("gh is not installed.")
    except subprocess.TimeoutExpired:
        raise Stop(f"gh {args[0]} {args[1]} did not answer; run `task merge` again.")
    if result.returncode:
        raise Stop(f"gh {' '.join(args[:2])} failed: {(result.stderr or result.stdout).strip()}")
    return result.stdout.strip()


def open_pr(repo, branch):
    """The open PR number for branch, "" when none; Stop when GitHub cannot be asked."""
    try:
        result = subprocess.run(["gh", "pr", "list", "--head", branch, "--state", "open",
                                 "--json", "number", "--jq", ".[0].number"],
                                cwd=repo, capture_output=True, text=True, timeout=60)
    except FileNotFoundError:
        raise Stop("gh is not installed; cannot tell whether the branch has an open PR.")
    except subprocess.TimeoutExpired:
        raise Stop("gh did not answer; run `task merge` again.")
    if result.returncode:
        raise Stop(f"gh could not list PRs: {(result.stderr or result.stdout).strip()}")
    return result.stdout.strip()


class ReviewParseError(ValueError):
    """A review reply is malformed or contains ambiguous criterion judgments."""


def normalize_review_line(line):
    """Remove common Markdown presentation while preserving review text and list numbering."""
    line = line.rstrip()
    line = re.sub(r"^\s{0,3}#{1,6}\s+", "", line)
    table_number = None
    table_judgment = None
    table_evidence = None
    if "|" in line:
        cells = [part.strip() for part in line.strip().strip("|").split("|")]
        first = re.fullmatch(r"#?(\d+)", cells[0]) if cells else None
        table_number = int(first.group(1)) if first else None
        if table_number is not None and len(cells) > 1:
            judgment = re.fullmatch(r"(pass|fail|unclear)", cells[1], re.I)
            if judgment:
                table_judgment = judgment.group(1).lower()
                table_evidence = " ".join(cells[2:]).strip()
        line = " ".join(cells)
    numbered = re.match(r"^\s*(\d+)[.)]\s+", line)
    line = re.sub(r"^\s*(?:[-*+]\s+)+", "", line)
    line = re.sub(r"^\s*\d+[.)]\s+", "", line)
    line = line.replace("`", "").replace("**", "").replace("__", "")
    line = line.replace("*", "")
    line = re.sub(r"(?<!\w)_|_(?!\w)", "", line)
    return (line.strip(), int(numbered.group(1)) if numbered else None, table_number,
            table_judgment, table_evidence)


def parse_review_block(block, criteria):
    """Parse the exact plain-text fields in a fenced `review` block."""
    lines = [line.strip() for line in block.splitlines() if line.strip()]
    if len(lines) < 2:
        raise ReviewParseError("review block must contain verdict and commit lines")
    verdict_match = re.fullmatch(r"Verdict: (PASS|FAIL)", lines[0])
    commit_match = re.fullmatch(r"Commit: ([0-9a-f]{40})", lines[1])
    if not verdict_match:
        raise ReviewParseError("review block must start with `Verdict: PASS` or `Verdict: FAIL`")
    if not commit_match:
        raise ReviewParseError("review block must contain a full 40-character Commit SHA")
    reviewer = None
    judgment_lines = lines[2:]
    reviewer_match = (re.fullmatch(r"Reviewer:\s*(.*)", judgment_lines[0], re.I)
                      if judgment_lines else None)
    if reviewer_match:
        words = reviewer_match.group(1).split(None, 1)
        reviewer = (words[0], words[1] if len(words) > 1 else "") if words else ("", "")
        judgment_lines = judgment_lines[1:]
    required = set(criteria)
    judgments = {}
    for line in judgment_lines:
        match = re.fullmatch(r"#(\d+) (pass|fail|unclear): (.+)", line)
        if not match:
            raise ReviewParseError("review block contains a malformed or Markdown criterion line")
        number, judgment, evidence = int(match.group(1)), match.group(2), match.group(3)
        if number in judgments:
            raise ReviewParseError(f"duplicate judgment for criterion #{number}")
        if number not in required:
            raise ReviewParseError(f"review block includes unpinned criterion #{number}")
        if not evidence.strip():
            raise ReviewParseError(f"review block has no evidence for criterion #{number}")
        judgments[number] = (judgment, evidence)
    if required != set(judgments):
        raise ReviewParseError("every pinned criterion must have exactly one judgment")
    return verdict_match.group(1), commit_match.group(1), reviewer, judgments


def review_block(text):
    """Return the first review block, or None only when no review fence was supplied."""
    opening = re.search(r"(?m)^```review[ \t]*\r?\n", text)
    if not opening:
        return None
    closing = re.search(r"(?m)^```[ \t]*$", text[opening.end():])
    if not closing:
        raise ReviewParseError("review block is missing its closing fence")
    return text[opening.end():opening.end() + closing.start()]


def parse_review_reply(text, criteria):
    """Prefer a strict fenced block; otherwise parse common Markdown reviewer replies."""
    block = review_block(text)
    if block is not None:
        return parse_review_block(block, criteria)
    lines = [normalize_review_line(line) for line in text.splitlines()]
    verdict = next((match.group(1).upper() for line, _, _, _, _ in lines
                    if (match := re.match(r"Verdict\s*:\s*(PASS|FAIL)\b", line, re.I))), None)
    commit = next((match.group(1) for line, _, _, _, _ in lines
                   if (match := re.fullmatch(r"Commit\s*:\s*([0-9a-f]{7,40})", line, re.I))), None)
    reviewer = None
    for line, _, _, _, _ in lines:
        reviewer = re.fullmatch(r"Reviewer\s*:\s*(.*)", line, re.I)
        if reviewer:
            words = reviewer.group(1).split(None, 1)
            reviewer = (words[0], words[1] if len(words) > 1 else "") if words else ("", "")
            break
    judgments = {}
    required = set(criteria)
    has_hash_criterion_lines = any(re.match(r"#\d+\b", line) for line, _, _, _, _ in lines)
    for line, number, table_number, table_judgment, table_evidence in lines:
        explicit = re.fullmatch(r"#(\d+)\s*:?[\s|]+(pass|fail|unclear)\s*:?\s*(.*)", line, re.I)
        if explicit:
            n, verdict_value, evidence = int(explicit.group(1)), explicit.group(2), explicit.group(3)
            if n in required:
                if n in judgments:
                    raise ReviewParseError(f"duplicate judgment for criterion #{n}")
                judgments[n] = (verdict_value.lower(), evidence.strip())
            continue
        criterion_number = (number or table_number) if not has_hash_criterion_lines else None
        if criterion_number in required:
            if table_number is not None:
                if table_judgment is not None:
                    if criterion_number in judgments:
                        raise ReviewParseError(f"duplicate judgment for criterion #{criterion_number}")
                    judgments[criterion_number] = (table_judgment, table_evidence or "")
                continue
            item = re.fullmatch(
                r"(?:\d+\s+)?(pass|fail|unclear)(?=$|:|,|\s+[-—]\s)(.*)", line, re.I)
            if item:
                remainder = item.group(2)
                if remainder.startswith((":", ",")):
                    evidence = remainder[1:].strip()
                else:
                    dash = re.match(r"\s+[—–-]\s+(.*)", remainder)
                    evidence = dash.group(1).strip() if dash else remainder.strip()
                if criterion_number in judgments:
                    raise ReviewParseError(f"duplicate judgment for criterion #{criterion_number}")
                judgments[criterion_number] = (item.group(1).lower(), evidence)
    return verdict, commit, reviewer, judgments


def run_reviewer(command, path, prompt_file, reply_file):
    try:
        timeout = int(os.environ.get("TASK_REVIEW_TIMEOUT", "900"))
    except ValueError:
        raise Stop("TASK_REVIEW_TIMEOUT must be a positive number of seconds.")
    if timeout < 1:
        raise Stop("TASK_REVIEW_TIMEOUT must be a positive number of seconds.")
    env = agent_environment()
    argv = shlex.split(command)
    if argv[0] == "GIT_OPTIONAL_LOCKS=0":
        env["GIT_OPTIONAL_LOCKS"] = "0"
        argv.pop(0)
    run_file = reply_file.with_name("review-run.json")
    stderr_file = reply_file.with_name("review-stderr.log")
    run = {"builder": argv[0], "state": "running", "exit_code": None}
    atomic_json(run_file, run)
    try:
        with prompt_file.open() as prompt, reply_file.open("w") as reply, stderr_file.open("w") as errors:
            process = subprocess.Popen(argv, cwd=path, env=env, stdin=prompt, stdout=reply,
                                       stderr=errors, start_new_session=True)
            try:
                code = process.wait(timeout=timeout)
                run.update(state="finished", exit_code=code)
            except subprocess.TimeoutExpired:
                try:
                    os.killpg(process.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                process.wait()
                run.update(state="timed_out")
                raise Stop(f"Reviewer timed out after {timeout}s; no review recorded. Reply: {reply_file}")
    except OSError as error:
        run.update(state="launch_failed")
        raise Stop(f"Cannot run reviewer: {error}; no review recorded.")
    finally:
        atomic_json(run_file, run)
        if stderr_file.is_file():
            print(stderr_file.read_text(), end="", file=sys.stderr)
    if code:
        output = reply_file if run["builder"] == "claude" else stderr_file
        limit = cli_limit(run, output.read_text(errors="replace"))
        if limit:
            raise UsageLimit(f"Reviewer ended by usage limit ({limit}); no review recorded. Reply: {reply_file}")
        raise Stop(f"Reviewer exited with status {code}; no review recorded. Reply: {reply_file}")


def review(args):
    repo = resolve_repo(args.repo)
    task = Task(repo, args.id)
    path = task.worktree()
    record = load_record(task)
    head = sha(path, "HEAD")
    state = task_state(task)
    checked = review_check(task, path, head, record)
    if args.no_check is not None and not args.no_check.strip():
        raise Stop("--no-check needs a nonempty reason")
    if args.run and checked.get("result") != "passed" and not args.no_check:
        raise Stop("No passing check for the current head; run `task check` first, or use --no-check \"reason\".")
    if args.no_check:
        with (state / "review-overrides.jsonl").open("a") as stream:
            stream.write(json.dumps(dict(head=head, time=utc_now(), reason=args.no_check)) + "\n")
    task_text = task.file.read_text() if task.file else ""
    request_text = ""
    request_label = "Original request:"
    lane_prompt = path / ".work/prompt.md"
    original = path / ".work/request.md"
    latest_text = lane_prompt.read_text() if lane_prompt.is_file() else ""
    if args.request:
        try:
            request_text = Path(args.request).read_text()
        except OSError as error:
            raise Stop(f"Cannot read request file {args.request}: {error}.")
    else:
        request_text = original.read_text() if original.is_file() else latest_text
    outcome = markdown_section(task_text, "Outcome") or record.get("title") or f"Direct request for branch {task.id}"
    scope = markdown_section(task_text, "Scope") or task.id
    if not args.record:
        reviewer_route = (("claude", "haiku") if record["builder"] == "codex"
                          else ("codex", "gpt-6-luna"))
        if reviewer_route[0] in active_boosts():
            reviewer_route = (reviewer_route[0], "opus" if reviewer_route[0] == "claude" else "gpt-6.1-sol")
        if reviewer_route[0] == record["builder"]:
            raise Stop("reviewer vendor must differ from builder")
        prompt = ["You are the REVIEWER of another agent's work. Do not edit, run builds or tests, or commit. Read the diff and report, then give the verdict block.",
                  f"Task: {task.file or '(no Backlog task file)'}", f"Worktree: {path}",
                  f"Outcome: {outcome}", f"Scope: {scope}"]
        if checked:
            prompt.extend(["Recorded check (trusted if present, otherwise advisory):",
                           f"Verdict: {'PASS' if checked['result'] == 'passed' else 'FAIL'}; "
                           f"head: {checked['sha']}; trusted: {checked.get('trusted', False)}",
                           "Summary tail:", checked['summary_tail']])
        else:
            prompt.append("Recorded check: missing for the reviewed head.")
        if args.no_check:
            prompt.append(f"Check override: {args.no_check}")
        previous = read_json_object(state / "review.json")
        previous_file = state / "review.md"
        if not previous.get("commit"):
            history = sorted((p for p in state.glob("review-*.json")
                              if re.fullmatch(r"review-\d+", p.stem)),
                             key=lambda p: int(p.stem.split('-')[1]), reverse=True)
            for file in history:
                previous = read_json_object(file)
                if previous.get("commit"):
                    previous_file = file.with_suffix('.md')
                    break
        if previous.get("commit"):
            previous_text = previous_file.read_text() if previous_file.is_file() else ""
            blocking = re.search(r"(?ims)^(?:#{1,6}\s+)?(?:\*\*)?Blocking(?:\*\*)?:?\s*\n"
                                 r"(.*?)(?=^(?:#{1,6}\s+)?(?:\*\*)?Notes\b|\Z)", previous_text)
            prompt.extend(["Previous review Blocking list:", blocking[1].strip() if blocking else
                           "(old review has no Blocking section)"])
            delta = run_git(path, "diff", "--no-ext-diff", "--no-textconv", previous['commit'], head, "--")
            prompt.extend([f"Diff since previously reviewed head {previous['commit']}:",
                           delta.stdout if delta.returncode == 0 else "(previous head unavailable)",
                           "In a re-review, new non-defect findings on code unchanged since the previous "
                           "review are Notes only."])
        if request_text:
            prompt.extend([request_label, request_text.rstrip()])
        if latest_text and latest_text != request_text:
            prompt.extend(["Latest fix-round instructions to the builder (context only; judge the whole change against the original request):",
                           latest_text.rstrip()])
        if record.get("verify"):
            prompt.append("Pinned verification commands: " + " ; ".join(record["verify"]))
        if record["criteria"]:
            prompt.append("Criteria:")
            for item in record["criteria"]:
                prompt.append(f"#{item['number']} {item['text']}")
        else:
            prompt.append("Criteria: none; judge the stated request above against the diff.")
        review_base = sha(task.repo, f"origin/{default_branch(task.repo)}" if has_origin(task.repo)
                          else default_branch(task.repo))
        review_base = git(task.repo, "merge-base", review_base, head)
        prompt.append(f"Diff range: {review_base}...{head}")
        prompt.append(f"Reviewer instructions: read {path / '.work/report.md'} alongside the diff; "
                      "read-only review; use `git --no-optional-locks diff`, "
                      "`git --no-optional-locks log`, and `git --no-optional-locks show` to inspect changes.")
        if record["criteria"]:
            prompt.append("Reviewer brief: what is missing; how will this fail in real use; will people actually use it?")
        else:
            prompt.append("Reviewer brief: judge the stated request above against the diff; explain whether the change meets it.")
        prompt.append("Return exactly this final fenced block, with plain text only inside it:")
        prompt.append(
            "Verdict FAIL only when a criterion above, or the stated request, is not met, "
            "or the change breaks something that worked. Everything else is a non-blocking "
            "note: list it under 'Notes', never as a reason to FAIL."
        )
        prompt.append("Split findings into 'Blocking' (each tied to a criterion or a breakage) and 'Notes'.")
        prompt.append("```review")
        prompt.append("Verdict: PASS|FAIL")
        prompt.append("Commit: <full sha>")
        for item in record["criteria"]:
            prompt.append(f"#{item['number']} pass|fail|unclear: <one line of evidence>")
        prompt.append("```")
        prompt.append(
            "After the fenced block, list findings under 'Blocking' and 'Notes'. Every "
            "Blocking finding must identify a named requested criterion or a concrete defect or regression, "
            "with file:line. Put all other "
            "observations under Notes."
        )
        if args.append_prompt:
            prompt.append(args.append_prompt)
        prompt_text = "\n".join(prompt) + "\n"
        state = task_state(task)
        state.mkdir(parents=True, exist_ok=True)
        atomic_json(state / "review-routing.json", {"vendor": reviewer_route[0], "model": reviewer_route[1]})
        prompt_file = state / "review-prompt.md"
        reply_file = state / "review-response.md"
        prompt_file.write_text(prompt_text)
        reply_file.unlink(missing_ok=True)
        add_dir = f"--add-dir {shlex.quote(str(task.kb))} " if task.file else ""
        if record["builder"] == "codex":
            command = (f"claude -p {add_dir}--permission-mode dontAsk --model {reviewer_route[1]} --effort high "
                       "--allowedTools Read Grep Glob 'Bash(git --no-optional-locks:*)'")
        else:
            command = (f"GIT_OPTIONAL_LOCKS=0 codex exec --sandbox read-only {add_dir}"
                       f"-m {reviewer_route[1]} -c model_reasoning_effort=high -")
        if not args.run:
            print(prompt_text, end="")
            print("Headless reviewer command (run from the task worktree):")
            print(f"  {command} < {shlex.quote(str(prompt_file))} > {shlex.quote(str(reply_file))}")
            print(f"Then record it: task review {shlex.quote(args.repo)} {shlex.quote(args.id)} --record {shlex.quote(str(reply_file))}")
            return 0
        used_fallback = False
        for attempt in range(2):
            try:
                run_reviewer(command, path, prompt_file, reply_file)
            except UsageLimit:
                if reviewer_route != ("claude", "opus"):
                    raise
                print("Boosted Claude reviewer hit a usage limit; retrying once with claude haiku.")
                used_fallback = True
                reviewer_route = ("claude", "haiku")
                atomic_json(state / "review-routing.json", {"vendor": "claude", "model": "haiku",
                                                            "fallback_from": "opus"})
                command = command.replace("--model opus ", "--model haiku ", 1)
                run_reviewer(command, path, prompt_file, reply_file)
            head = sha(path, "HEAD")
            try:
                verdict, commit, _, _ = parse_review_reply(
                    reply_file.read_text(), {item["number"] for item in record["criteria"]})
                if verdict and commit:
                    matches = run_git(path, "rev-parse", "--verify", f"{commit}^{{commit}}")
                    if (matches.returncode == 0 and matches.stdout.strip().startswith(commit)
                            and matches.stdout.strip() == head):
                        break
            except ReviewParseError:
                pass
            if attempt or used_fallback:
                raise Stop("review produced no verdict; rerun `task review`")
        args.record = str(reply_file)
        head = sha(path, "HEAD")
    try:
        text = Path(args.record).read_text()
    except OSError as error:
        raise Stop(f"Cannot read review file {args.record}: {error}.")
    if args.run:
        print("--- reviewer reply ---")
        print(text, end="" if text.endswith("\n") else "\n")
    required = {item["number"] for item in record["criteria"]}
    try:
        verdict, commit, reviewer, judgments = parse_review_reply(text, required)
    except ReviewParseError as error:
        raise Stop(f"Review rejected: {error}.")
    problems = []
    if not verdict: problems.append("missing Verdict: PASS|FAIL")
    state = task_state(task)
    try:
        route = json.loads((state / "review-routing.json").read_text())
        routed_reviewer = (route["vendor"], route["model"])
    except (OSError, json.JSONDecodeError, KeyError, TypeError):
        routed_reviewer = None
    if routed_reviewer is None:
        routed_reviewer = tuple(args.reviewer) if args.reviewer else None
        if not routed_reviewer:
            problems.append("no stored reviewer routing; provide --reviewer <vendor> <model>")
        elif routed_reviewer[0].lower() not in {"claude", "codex"} or not routed_reviewer[1].strip():
            problems.append("--reviewer must be <claude|codex> <model>")
        else:
            routed_reviewer = (routed_reviewer[0].lower(), routed_reviewer[1])
    if routed_reviewer and routed_reviewer[0].lower() == record["builder"]:
        problems.append("reviewer vendor must differ from builder")
    if reviewer and reviewer[0].lower() == record["builder"]:
        print(f"WARNING: reply Reviewer: line names builder vendor '{reviewer[0]}'; using routed reviewer identity.")
    resolved_review = None
    if commit:
        matches = run_git(path, "rev-parse", "--verify", f"{commit}^{{commit}}")
        if matches.returncode == 0 and matches.stdout.strip().startswith(commit):
            resolved_review = matches.stdout.strip()
    if resolved_review != head: problems.append("Commit does not match the current lane head")
    if required != set(judgments): problems.append("every pinned criterion must have exactly one judgment")
    if any(not evidence for _, evidence in judgments.values()): problems.append("every judgment needs evidence")
    if problems:
        raise Stop("Review rejected: " + "; ".join(problems) + ".")
    (state / "review.md").write_text(text)
    meta = {"verdict": verdict, "commit": head, "reviewer": routed_reviewer[0].lower(),
            "model": routed_reviewer[1], "judgments": {str(k): v[0].lower() for k, v in judgments.items()},
            "record_revision": record["revision"], "time": utc_now()}
    if args.no_check:
        meta["no_check"] = args.no_check
    save_review_history(state, meta, text)
    atomic_json(state / "review.json", meta)
    task_event(task, "review")
    print(f"Recorded {meta['verdict']} review for {head[:7]}.")
    if args.run:
        print(f"Review recorded: {meta['verdict']}")
    return 0


def merge_gate(task, path, head):
    missing = []
    record = load_record(task)
    state = task_state(task)
    try:
        review = json.loads((state / "review.json").read_text())
    except (OSError, json.JSONDecodeError):
        review = {}
    reviewed_head = review.get("commit")
    if (review.get("verdict") != "PASS" or reviewed_head != head
            or review.get("record_revision") != record["revision"]
            or any(v != "pass" for v in review.get("judgments", {}).values())
            or review.get("reviewer") == record["builder"]):
        missing.append("recorded PASS review for lane head with every criterion pass by the other vendor")
    report = path / ".work/report.md"
    if not report.is_file() or re.search(r"(?i)\(fill in\)|^\s*$", report.read_text(), re.M):
        # Blank headings and explanatory placeholders mean the lane has not completed its report.
        content = report.read_text() if report.is_file() else ""
        headings = (("What changed", "How I verified", "Criteria", "Noticed, not done")
                    if record["criteria"] else ("What changed", "How I verified"))
        sections = [re.search(rf"(?ms)^## {heading}\s*\n(.*?)(?=^## |\Z)", content)
                    for heading in headings]
        if not all(match and match.group(1).strip() for match in sections) or "(fill in)" in content:
            missing.append("filled .work/report.md")
    if report.is_file():
        content = report.read_text()
        section = re.search(r"(?ms)^## Criteria\s*\n(.*?)(?=^## |\Z)", content)
        criteria_text = section.group(1) if section else ""
        if any(not re.search(rf"(?m)^\s*(?:(?:[-*]|\d+\.)\s+)?#?{item['number']}\s+(?:met|not met):\s*\S.+$",
                             criteria_text, re.I) for item in record["criteria"]):
            missing.append("criterion evidence in .work/report.md")
    if missing:
        error = Stop("Merge refused; missing: " + "; ".join(missing) + ". Use --override \"reason\" only for an explicit exception.")
        error.missing_steps = missing
        raise error
    return record


def can_reuse_lane_check(task: Task, repo: Path, lane_head: str, base: str, record) -> bool:
    """Reuse check evidence only when it passed for this head and revision against this base."""
    try:
        checked = json.loads((task_state(task) / "check.json").read_text())
    except (OSError, json.JSONDecodeError):
        return False
    return (checked.get("trusted") is True and checked.get("result") == "passed"
            and checked.get("sha") == lane_head
            and checked.get("record_revision") == record.get("revision")
            and checked.get("base_sha") == base and is_ancestor(repo, base, lane_head))


def overlap_files(repo: Path, lane_head: str, base: str):
    common = git(repo, "merge-base", lane_head, base)
    lane_files = set(git(repo, "diff", "--name-only", common, lane_head).splitlines())
    main_files = set(git(repo, "diff", "--name-only", common, base).splitlines())
    return sorted(lane_files & main_files)


def overlap_message(files):
    names = ", ".join(files) if files else "files with merge conflicts"
    return (f"main changed {names} that this task also changed; ask the lane to run `git merge origin/main` "
            "on its branch, then `task check` and a new review")


def gate_worktree_match(name):
    # Split the PID greedily so numeric task-name components stay in the task.
    match = re.fullmatch(r"\.task-gate-(.+)-(\d+)", name)
    if match:
        return match
    # Archived snapshots append a random component after the original gate name.
    original, _separator, _suffix = name.rpartition("-")
    return re.fullmatch(r"\.task-gate-(.+)-(\d+)", original)


def prune_stale_gate_worktrees(repo: Path):
    worktrees = repo / ".worktrees"
    if not worktrees.is_dir():
        return
    for gate in worktrees.glob(".task-gate-*"):
        match = gate_worktree_match(gate.name)
        if not match or pid_alive(match.group(2)):
            continue
        remove_gate_worktree(Task(repo, match.group(1)), gate)
        print(f"Removed stale gate worktree {gate}.")


def remove_gate_worktree(task, gate):
    try:
        preserve_work(task.repo, task.name, gate)
    except Stop as error:
        print(f"Gate archive warning: {error}", file=sys.stderr)
    finally:
        result = run_git(task.repo, 'worktree', 'remove', '--force', str(gate))
        if result.returncode and gate.exists():
            try:
                shutil.rmtree(gate)
            except OSError as error:
                print(f"Gate cleanup warning: {gate}: {error}", file=sys.stderr)
            run_git(task.repo, 'worktree', 'prune')


def gate_merge_result(task: Task, repo: Path, lane_head: str, base: str, record):
    gate = repo / ".worktrees" / f".task-gate-{task.name}-{os.getpid()}"
    if gate.exists():
        raise Stop(f"Temporary gate worktree already exists: {gate}")
    exclude(repo, ".worktrees/")
    git(repo, "worktree", "add", "-q", "--detach", str(gate), base)
    try:
        result = run_git(gate, "merge", "--no-edit", "--no-ff", lane_head)
        if result.returncode:
            conflicts = git(gate, "diff", "--name-only", "--diff-filter=U").splitlines()
            run_git(gate, "merge", "--abort")
            raise Stop(overlap_message(conflicts))
        prepare_environment(repo, gate)
        seeds = task_config(gate).get("drill_seeds", [])
        if not isinstance(seeds, list) or not all(isinstance(name, str) for name in seeds):
            raise Stop(".task.toml drill_seeds must be a list of seed names.")
        seed_worktree(repo, gate, list(dict.fromkeys(record.get("seeds", []) + seeds)))
        gated_head = sha(gate, "HEAD")
        archived_log = task_state(task) / "gate-check.log"
        if exclusive_gate_enabled(gate):
            with exclusive_gate_lock(task, config_path=gate):
                passed = run_check(gate, base, record, task_state(task),
                                   evidence_name="gate-check.json", display_log=archived_log)
        else:
            passed = run_check(gate, base, record, task_state(task),
                               evidence_name="gate-check.json", display_log=archived_log)
        shutil.copy2(gate / ".work/check.log", archived_log)
        completed_step(task, "gate")
        return git(gate, "rev-parse", f"{gated_head}^{{tree}}"), passed
    finally:
        remove_gate_worktree(task, gate)


def merge(args):
    repo = resolve_repo(args.repo)
    prune_stale_gate_worktrees(repo)
    task = Task(repo, args.id)
    print(f"For long gates, use `task merge {args.repo} {task.id} --detach` and track it with `task status`.")
    default = default_branch(repo)
    fetch(repo)
    base, label = base_commit(repo, default)
    archive = task_state(task)
    if not task.path.exists():
        try:
            checked = json.loads((archive / "check.json").read_text())
            lane_head = checked.get("sha")
        except (OSError, json.JSONDecodeError):
            lane_head = None
        if lane_head and is_ancestor(repo, lane_head, base):
            print(f"{task.id} is already merged in {label}; archive is resumable and complete.")
            return 0
        raise Stop(f"No worktree {task.path}; start it with `task start`.")
    path = task.worktree()
    branch = git(path, "branch", "--show-current")
    if not branch:
        raise Stop(f"{path} is not on a branch.")
    changes = untracked(path)
    if changes:
        raise Stop("The worktree has uncommitted or untracked files; the lane commits or deletes "
                   "them first:\n" + "\n".join(changes))
    lane_head = sha(path, "HEAD")
    record = load_record(task)
    if lane_head != record.get('base_sha') and is_ancestor(repo, lane_head, base):
        repair_published(task, base)
        return 0
    try:
        record = merge_gate(task, path, lane_head)
    except Stop as error:
        if not args.override:
            raise
        atomic_json(archive / "exception.json", {"reason": args.override, "time": utc_now(),
                                                   "missing_gate": True,
                                                   "waived": [{"step": item, "reason": args.override}
                                                              for item in error.missing_steps]})
        for item in json.loads((archive / "exception.json").read_text())["waived"]:
            print(f"exception: {item['step']} waived: {args.override}")
    task_event(task, "merge")
    if is_ancestor(repo, lane_head, base):
        commit = base
        print(f"{branch} is already in {label}.")
    else:
        title = f": {task.title}" if task.title else ""
        for _attempt in range(3):
            fetch(repo)
            base, label = base_commit(repo, default)
            overlap = overlap_files(repo, lane_head, base)
            if overlap:
                raise Stop(overlap_message(overlap))
            if can_reuse_lane_check(task, repo, lane_head, base, record):
                print("main unchanged since the lane's check; reusing it")
                completed_step(task, "gate")
                tree = git(repo, "rev-parse", f"{lane_head}^{{tree}}")
            else:
                tree, gate_passed = gate_merge_result(task, repo, lane_head, base, record)
                if not gate_passed:
                    if not args.override:
                        raise Stop("Gate check failed on the would-be merge result; nothing was published.")
                    try:
                        exception = json.loads((archive / "exception.json").read_text())
                    except (OSError, ValueError):
                        exception = {"waived": []}
                    gate_check = json.loads((archive / "gate-check.json").read_text())
                    for step in gate_check.get("steps", []):
                        if step.get("exit") or step.get("timeout"):
                            name = "check:" + " ".join(step["command"])
                            exception.setdefault("waived", []).append({"step": name, "reason": args.override})
                            print(f"exception: {name} waived: {args.override}")
                    exception.update(reason=args.override, time=utc_now(), gate_failed=True, missing_gate=True)
                    atomic_json(archive / "exception.json", exception)
            if sha(path, "HEAD") != lane_head:
                raise Stop("The lane branch changed while the gate ran; nothing was published. Run `task check` and obtain a new review.")
            fetch(repo)
            latest, _ = base_commit(repo, default)
            if latest != base:
                print(f"{label} moved during the gate; re-gating against the new tip.")
                continue
            if on_github(repo):
                git(repo, "push", "-q", "origin", f"{lane_head}:refs/heads/{branch}")
                pr = open_pr(repo, branch)
                if not pr:
                    gh(repo, "pr", "create", "--head", branch, "--base", default,
                       "--title", f"{task.id}{title}" if task.title else task.id,
                       "--body", (path / ".work/report.md").read_text())
                    pr = open_pr(repo, branch)
                    if not pr:
                        raise Stop("Opened a PR but could not find it again; rerun `task merge`.")
                    print(f"Opened PR #{pr}.")
                fetch(repo)
                latest, _ = base_commit(repo, default)
                if latest != base:
                    print(f"{label} moved before PR merge; re-gating against the new tip.")
                    continue
                gh(repo, "pr", "merge", pr, "--merge", "--match-head-commit", lane_head)
                completed_step(task, "published")
                try:
                    merge_info = json.loads(gh(repo, "pr", "view", pr, "--json", "mergeCommit"))
                    pr_merge_commit = (merge_info.get("mergeCommit") or {}).get("oid")
                except (json.JSONDecodeError, AttributeError):
                    pr_merge_commit = None
                if not pr_merge_commit:
                    raise Stop(f"GitHub merged PR #{pr} but did not report its merge commit; inspect it before continuing.")
                fetch(repo)
                commit = sha(repo, f"origin/{default}")
                first_parent = sha(repo, f"{pr_merge_commit}^1")
                if first_parent != base:
                    reason = (f"GitHub merged PR #{pr} on {first_parent[:7]}, not the gated base "
                              f"{base[:7]}; publication did not match the gate.")
                    atomic_json(archive / "exception.json", {"reason": reason, "time": utc_now(),
                                                               "publication_mismatch": True,
                                                               "gated_base": base,
                                                               "actual_first_parent": first_parent})
                    print(f"WARNING: {reason} Exception recorded; the published merge was not reverted.")
                print(f"Merged PR #{pr} ({pr_merge_commit[:7]}) from reviewed head {lane_head[:7]}.")
            else:
                commit = git(repo, "commit-tree", tree, "-p", base, "-p", lane_head,
                             "-m", f"Merge {task.id}{title}\n\nBranch {branch}, checked with `task merge`.")
                if has_origin(repo):
                    pushed = run_git(repo, "push", "-q", "origin", f"{commit}:refs/heads/{default}")
                    if pushed.returncode:
                        fetch(repo)
                        latest, _ = base_commit(repo, default)
                        if latest != base:
                            print(f"{label} moved before publication; re-gating against the new tip.")
                            continue
                        raise Stop(f"Push to {default} was refused: {pushed.stderr.strip()}\n"
                                   "Rerun `task merge`; the lane branch is unchanged and will be gated again.")
                    fetch(repo)
                    commit = sha(repo, f"origin/{default}")
                completed_step(task, "published")
                print(f"Merged {branch} into {default} as {commit[:7]} from reviewed head {lane_head[:7]}.")
            break
        else:
            raise Stop(f"{default} kept moving during three gate attempts; rerun `task merge`.")
    atomic_json(archive / "merge.json", {"head": lane_head, "commit": commit,
                                        "time": datetime.now(timezone.utc).isoformat()})
    try:
        review = json.loads((archive / "review.json").read_text())
    except (OSError, json.JSONDecodeError):
        review = {}
    if review:
        print(f"Recorded review: {review.get('reviewer', '?')} {review.get('model', '?')} at "
              f"{review.get('time', '?')} for {review.get('commit', '?')[:7]}.")
    local_default_before = run_git(repo, "rev-parse", "--verify", "--quiet",
                                   f"refs/heads/{default}").stdout.strip()
    update_message = update_local_default(repo, default, commit)
    print(update_message)
    sync_dependencies_after_merge(repo, local_default_before, commit, update_message)
    completed_step(task, "main updated")
    report_path = path / ".work/report.md"
    if report_path.is_file():
        shutil.copy2(report_path, archive / "report.md")
    check_log = path / ".work/check.log"
    if check_log.is_file():
        shutil.copy2(check_log, archive / "check.log")
    completed_step(task, "archived")
    if args.keep:
        return 0
    leftovers = untracked(path) + ignored_leftovers(path)
    if leftovers:
        print(f"Kept {path}: it holds files that are not in the merge:\n" + "\n".join(leftovers))
        return 0
    preserve_work(task.repo, task.name, path)
    git(repo, "worktree", "remove", "--force", str(path))
    completed_step(task, "cleaned")
    if is_ancestor(repo, lane_head, commit) and ok(repo, "branch", "-D", branch):
        print(f"Removed {path} and branch {branch}.")
    else:
        print(f"Removed {path}; branch {branch} kept (not fully in local {default}).")
    task_event(task, "merge")
    return 0


def flatten_review_links(review):
    link = re.compile(r"(?P<image>!)?\[(?P<label>[^\]]*)\]\(\s*(?P<target><[^>]*>|[^\s)]+)(?:\s+[^)]*)?\)")
    definition = re.compile(r"(?m)^(?P<prefix>\s*\[[^\]]+\]:\s*)(?P<target><[^>]*>|\S+)")
    autolink = re.compile(r"<(?P<target>file:[^>]+)>", re.IGNORECASE)

    def local_target(target):
        target = target.strip("<>")
        return (target.startswith("/") and not target.startswith("//")
                or re.match(r"^[A-Za-z]:[\\/]", target)
                or target.startswith("\\\\")
                or target.lower().startswith("file:"))

    def local_basename(target):
        target = target.strip("<>")
        if target.lower().startswith("file:"):
            target = re.sub(r"(?i)^file:(//)?", "", target)
        return re.split(r"[\\/]", target.rstrip("\\/"))[-1]

    def flatten_local_link(match):
        if not local_target(match.group("target")):
            return match.group(0)
        return match.group("label")

    review = link.sub(flatten_local_link, review)
    review = definition.sub(
        lambda match: match.group("prefix") + local_basename(match.group("target"))
        if local_target(match.group("target")) else match.group(0), review)
    return autolink.sub(lambda match: local_basename(match.group("target")), review)


def apply_close_update(kb, task, before, archive, criteria, status, summary):
    """Apply only this task's close records in the supplied knowledge checkout."""
    before = kb / before.relative_to(task.kb)
    command = ["backlog", "task", "edit", task.id, "-s", status, "--final-summary", summary]
    for number in criteria:
        command += ["--check-ac", number]
    result = subprocess.run(command, cwd=kb, capture_output=True, text=True)
    if result.returncode:
        raise Stop(f"backlog failed: {(result.stderr or result.stdout).strip()}")
    task_number = re.fullmatch(r"(?i)t?-?(\d+)", task.id)
    after = next(iter(sorted((kb / "backlog/tasks").glob(
        f"[tT]-{task_number.group(1)} - *.md"))), None)
    if after is None:
        raise Stop(f"Backlog task {task.id} disappeared from {kb} while closing.")
    recorded_review = archive / "review.md"
    if recorded_review.is_file():
        text = after.read_text()
        if "## Review evidence" not in text:
            review = recorded_review.read_text().strip()
            review = flatten_review_links(review)
            text += "\n\n## Review evidence\n\n" + review + "\n"
            after.write_text(text)
    noticed = []
    report = archive / "report.md"
    if report.exists():
        active = False
        fence = None
        existing_path = kb / "improvements.md"
        existing = existing_path.read_text() if existing_path.exists() else ""
        for line in report.read_text().splitlines():
            stripped = line.strip()
            if stripped.startswith(("```", "~~~")):
                marker = stripped[:3]
                fence = None if fence == marker else marker if fence is None else fence
                continue
            if fence:
                continue
            if line.startswith("## "):
                active = bool(re.match(r"## Noticed(?:, not done)?\s*$", line, re.I))
                continue
            line = re.sub(r"\[([^\]]*)\]\(<?((?:/|file://)[^)>]+)>?\)",
                          lambda match: "`" + re.sub(r"^file://", "", match[2]) + "`", line)
            item = re.match(r"^\s*(?:[-*+]|\d+[.)])\s+(.+)$", line) if active else None
            if item and item[1] not in noticed and f"| {item[1]} |" not in existing:
                noticed.append(item[1])
    if noticed:
        with (kb / "improvements.md").open("a") as out:
            for item in noticed:
                out.write(f"\n- {utc_now()[:10]} | {task.id} | report | {item} | open\n")
    paths = sorted({str(p.relative_to(kb)) for p in (before, after) if p})
    if noticed:
        paths.append("improvements.md")
    git(kb, "add", "-A", "--", *paths)
    if ok(kb, "diff", "--cached", "--quiet", "--", *paths):
        return False
    git(kb, "commit", "-q", "-m", f"Close {task.id}: {task.title}", "--", *paths)
    return True


def close_pr(repo, branch):
    output = gh(repo, "pr", "list", "--head", branch, "--state", "all",
                "--json", "number,state,mergeCommit,headRefName,baseRefName", "--limit", "1")
    try:
        entries = json.loads(output or "[]")
    except json.JSONDecodeError:
        raise Stop(f"gh returned invalid PR data for close branch {branch}; rerun `task close` to resume.")
    return entries[0] if entries else None


def close_worktree_path(repo, branch):
    digest = hashlib.sha256(f"{repo.resolve()}:{branch}".encode()).hexdigest()[:12]
    return repo.resolve() / ".worktrees" / f"task-close-{digest}"


def close_worktree(repo, branch, default):
    path = close_worktree_path(repo, branch)
    if path.exists():
        if not real_worktree(repo, path) or git(path, "branch", "--show-current") != branch:
            raise Stop(f"Close worktree path {path} exists but is not the expected task-close worktree.")
        return path
    exclude(repo, ".worktrees/")
    path.parent.mkdir(parents=True, exist_ok=True)
    if ok(repo, "show-ref", "--verify", "--quiet", f"refs/heads/{branch}"):
        for block in git(repo, "worktree", "list", "--porcelain").split("\n\n"):
            lines = block.splitlines()
            checked = next((line[len("branch refs/heads/"):] for line in lines
                            if line.startswith("branch refs/heads/")), None)
            if checked == branch:
                location = next(line[len("worktree "):] for line in lines if line.startswith("worktree "))
                raise Stop(f"Close branch {branch} is already checked out at {location}; rerun after it is free.")
        git(repo, "worktree", "add", "-q", str(path), branch)
    elif ok(repo, "rev-parse", "--verify", "--quiet", f"refs/remotes/origin/{branch}"):
        git(repo, "worktree", "add", "-q", "--track", "-b", branch, str(path), f"origin/{branch}")
    else:
        git(repo, "worktree", "add", "-q", "--no-track", "-b", branch, str(path), f"origin/{default}")
    return path


def remove_completed_close_worktree(repo, branch, remove_parent=False, *, task):
    path = close_worktree_path(repo, branch)
    if not path.exists():
        pass
    elif not real_worktree(repo, path) or git(path, "branch", "--show-current") != branch:
        return
    else:
        # This deterministic path is owned by task close; after a verified merge, remove it
        # even if files were left behind in the temporary worktree.
        preserve_work(task.repo, task.name, path)
        removed = run_git(repo, "worktree", "remove", "--force", str(path))
        if removed.returncode:
            print(f"Close worktree kept at {path}: {removed.stderr.strip()}")
            return
    if remove_parent:
        try:
            path.parent.rmdir()
        except OSError:
            pass


def close_commit_present(path, task):
    return git(path, "log", "-1", "--format=%s") == f"Close {task.id}: {task.title}"


def delete_merged_close_branch(repo, branch):
    if branch.startswith("task-close-") and ok(repo, "show-ref", "--verify", "--quiet", f"refs/heads/{branch}"):
        result = run_git(repo, "branch", "-D", branch)
        if result.returncode:
            print(f"Close branch {branch} remains locally: {result.stderr.strip()}")


def knowledge_checkout_dirty(repo):
    tracked = git(repo, "status", "--porcelain", "--untracked-files=no",
                  "--", ".", ":(top,exclude)INTENT.md")
    untracked = git(repo, "ls-files", "--others", "--exclude-standard", "-z",
                    "--", ".", ":(top,exclude)INTENT.md", ":(top,exclude)history/realign/**")
    return bool(tracked or untracked)


def update_closed_knowledge_checkout(repo, default):
    if knowledge_checkout_dirty(repo):
        return f"local {default} not updated in {repo}: checkout has uncommitted changes"
    return update_local_default(repo, default, sha(repo, f"origin/{default}"), allow_plan_changes=True)


def close_with_pr(task, before, archive, args, criteria, status, summary):
    repo = task.kb
    ensure_origin_head(repo)
    default = default_branch(repo)
    branch = f"task-close-{task.name.replace('/', '-')}"
    close_path = close_worktree_path(repo, branch)
    # .worktrees counts as ours when it is absent, or when only a kept close worktree from an earlier run is in it.
    kept_alone = {close_path} if close_path.exists() else None
    worktree_parent_existed = close_path.parent.exists() and set(close_path.parent.iterdir()) != kept_alone
    fetch(repo)
    existing = close_pr(repo, branch)
    if existing and str(existing.get("state", "")).upper() == "MERGED":
        merge_commit = (existing.get("mergeCommit") or {}).get("oid")
        if not merge_commit:
            raise Stop(f"Close PR #{existing.get('number')} is merged but has no reported merge commit.")
        fetch(repo)
        if not is_ancestor(repo, merge_commit, f"origin/{default}"):
            raise Stop(f"Close PR #{existing.get('number')} reports merge {merge_commit[:7]}, not present on origin/{default}.")
        print(f"Close PR #{existing['number']} is already merged ({merge_commit[:7]}).")
        print(update_closed_knowledge_checkout(repo, default))
        remove_completed_close_worktree(repo, branch, remove_parent=not worktree_parent_existed, task=task)
        delete_merged_close_branch(repo, branch)
        current = task.file
        if args.partial or current and re.search(r"(?m)^status: [\"']?Done", current.read_text()):
            return 0
        branch += "-final"
        existing = close_pr(repo, branch)
    if existing and str(existing.get("state", "")).upper() != "OPEN":
        raise Stop(f"Close PR #{existing.get('number')} is {existing.get('state')}; branch {branch} is preserved for inspection.")
    if existing and (existing.get("headRefName") != branch or existing.get("baseRefName") != default):
        raise Stop(f"Close PR #{existing.get('number')} does not target {branch} into {default}; branch is preserved for inspection.")

    path = close_worktree(repo, branch, default)
    head = sha(path, "HEAD")
    base = sha(repo, f"origin/{default}")
    if not close_commit_present(path, task) or head == base:
        if head != base:
            raise Stop(f"Close branch {branch} at {head[:7]} has an unexpected commit; preserved at {path}.")
        if git(path, "status", "--porcelain", "--untracked-files=all"):
            preserve_work(task.repo, task.name, path)
            git(path, "reset", "--hard", "HEAD")
            git(path, "clean", "-fd")
        changed = apply_close_update(path, task, before, archive, criteria, status, summary)
        if not changed:
            # Nothing was committed, so there is no state to resume from: do not leave the folder behind.
            remove_completed_close_worktree(repo, branch, remove_parent=not worktree_parent_existed, task=task)
            print(f"{task.id} was already closed.")
            return 0
        head = sha(path, "HEAD")

    kept = f" Close worktree kept at {path} for the resume."
    pushed = run_git(path, "push", "-q", "-u", "origin", branch)
    if pushed.returncode:
        raise Stop(f"Close branch {branch} at {head[:7]} remains locally at {path}; push failed: {pushed.stderr.strip()}. Rerun `task close` to resume.")
    readback = run_git(repo, "ls-remote", "origin", f"refs/heads/{branch}")
    remote_head = readback.stdout.split()[0] if readback.returncode == 0 and readback.stdout.split() else ""
    if remote_head != head:
        raise Stop(f"Close branch push read back as {remote_head[:7] or 'missing'}, expected {head[:7]}; branch {branch} remains for resume.{kept}")

    existing = close_pr(repo, branch)
    if not existing:
        try:
            gh(repo, "pr", "create", "--head", branch, "--base", default,
               "--title", f"Close {task.id}: {task.title}", "--body", summary)
        except Stop as error:
            raise Stop(f"Close branch {branch} is pushed at {head[:7]}, but PR creation failed: {error}. Rerun `task close` to resume.{kept}")
        existing = close_pr(repo, branch)
        if (not existing or str(existing.get("state", "")).upper() != "OPEN"
                or existing.get("headRefName") != branch or existing.get("baseRefName") != default):
            raise Stop(f"Close branch {branch} is pushed at {head[:7]}, but no open PR could be read back; rerun `task close` to resume.{kept}")
        print(f"Opened close PR #{existing['number']}.")
    pr = str(existing["number"])
    try:
        gh(repo, "pr", "merge", pr, "--merge", "--match-head-commit", head)
    except Stop as error:
        raise Stop(f"Close PR #{pr} for branch {branch} at {head[:7]} remains open; merge failed: {error}. Rerun `task close` to resume.{kept}")
    try:
        merged = json.loads(gh(repo, "pr", "view", pr, "--json", "state,mergeCommit"))
        merge_commit = (merged.get("mergeCommit") or {}).get("oid")
        if str(merged.get("state", "")).upper() != "MERGED" or not merge_commit:
            raise Stop(f"Close PR #{pr} merge was not verified; branch {branch} at {head[:7]} is preserved. Rerun `task close` to resume.{kept}")
    except (json.JSONDecodeError, AttributeError) as error:
        raise Stop(f"Close PR #{pr} merged but its read-back was invalid ({error}); rerun `task close` to resume.")
    fetch(repo)
    if not is_ancestor(repo, merge_commit, f"origin/{default}"):
        raise Stop(f"Close PR #{pr} merge {merge_commit[:7]} is not present on origin/{default}; branch {branch} remains for inspection.")
    parents = git(repo, "rev-list", "--parents", "-n", "1", merge_commit).split()
    if len(parents) != 3 or parents[2] != head:
        raise Stop(f"Close PR #{pr} did not create a two-parent merge commit for head {head[:7]}; "
                   f"merge {merge_commit[:7]} remains on origin for inspection.")
    print(f"Merged close PR #{pr} with merge commit {merge_commit[:7]}.")
    print(update_closed_knowledge_checkout(repo, default))
    remove_completed_close_worktree(repo, branch, remove_parent=not worktree_parent_existed, task=task)
    delete_merged_close_branch(repo, branch)
    return 0


def close(args):
    repo = resolve_repo(args.repo)
    task = Task(repo, args.id)
    before = task.file
    if before is None:
        raise Stop(f"No Backlog.md task {args.id} in {task.kb}.")
    archive = task_state(task)
    try:
        record = json.loads((archive / "task.json").read_text())
    except (OSError, json.JSONDecodeError):
        raise Stop("Close requires the pinned task record from `task start`.")
    exception_path = archive / "exception.json"
    try:
        review = json.loads((archive / "review.json").read_text())
    except (OSError, json.JSONDecodeError):
        if exception_path.is_file() or args.no_merge:
            review = {}
        else:
            raise Stop("Close requires a recorded review, or an explicit merge exception.")
    passed = {int(n) for n, verdict in review.get("judgments", {}).items() if verdict == "pass"}
    criteria = [str(item["number"]) for item in record.get("criteria", []) if item["number"] in passed]
    not_passed = [str(item["number"]) for item in record.get("criteria", []) if item["number"] not in passed]
    if not_passed and not args.partial and not exception_path.is_file() and not args.no_merge:
        raise Stop("Cannot mark Done: criteria not passed in review: #" + ", #".join(not_passed) + ". Use --partial to keep In Progress.")
    exception = exception_path.exists() or bool(record.get("no_verify"))
    try:
        failed_check = json.loads((archive / "check.json").read_text()).get("result") == "failed"
    except (OSError, json.JSONDecodeError):
        failed_check = False
    exception = exception or failed_check
    notes = HOME / ".local/state/task/notes.jsonl"
    if notes.is_file():
        exception = exception or any(
            (item := json.loads(line)).get("repo") == repo.name and item.get("task") == task.id
            and item.get("source") == "intervention"
            for line in notes.read_text().splitlines() if line.strip())
    if (exception or args.partial) and len(re.findall(
            r"(?i)went well\s*[:/].*went wrong\s*[:/].*change\s*[:/]", args.retro)) == 0:
        raise Stop("This task needs a three-part retro: went well / went wrong / change.")
    status = "In Progress" if args.partial else "Done"
    try:
        merge_evidence = json.loads((archive / "merge.json").read_text())
    except (OSError, ValueError):
        merge_evidence = {}
    head = sha(task.path, "HEAD") if real_worktree(repo, task.path) else review.get("commit")
    if not args.partial and (not head or merge_evidence.get("head") != head):
        if not args.no_merge:
            print("Notice: merge not recorded for the task head.")
    summary = args.message + "\n\nRetro: " + args.retro
    if args.no_merge or (not args.partial and (not head or merge_evidence.get("head") != head)):
        summary += "\n\nMerge: " + (f"not merged: {args.no_merge}" if args.no_merge else 'merge not recorded')
    if exception_path.is_file():
        try:
            exception_reason = json.loads(exception_path.read_text()).get("reason", "unspecified override")
        except (OSError, json.JSONDecodeError):
            exception_reason = "unspecified override"
        summary += f"\n\nException: merge override — {exception_reason}"
    if has_origin(task.kb):
        return close_with_pr(task, before, archive, args, criteria, status, summary)
    changed = apply_close_update(task.kb, task, before, archive, criteria, status, summary)
    if not changed:
        print(f"{task.id} was already closed.")
        return 0
    print(f"Closed {task.id} ({len(criteria)} criteria ticked) in {task.kb}.")
    return 0


def read_setup_events(path, warnings=None):
    if not path.is_file():
        return []
    entries = []
    for number, line in enumerate(path.read_bytes().splitlines(), 1):
        if not line.strip():
            continue
        try:
            item = json.loads(line)
        except (json.JSONDecodeError, UnicodeDecodeError) as error:
            message = f"setup request log line {number} is invalid JSON; skipped"
            if warnings is None:
                detail = error.msg if isinstance(error, json.JSONDecodeError) else error.reason
                raise Stop(f"Setup request log line {number} is invalid JSON: {detail}.")
            warnings.append(message)
            continue
        if not isinstance(item, dict):
            message = f"setup request log line {number} is not an object; skipped"
            if warnings is None:
                raise Stop(f"Setup request log line {number} is not an object.")
            warnings.append(message)
            continue
        entries.append(item)
    return entries


def open_setup_requests(path, repo_name=None, events=None):
    if events is None:
        events = read_setup_events(path)
    done = {item.get("id") for item in events
            if item.get("action") == "setup-done" and isinstance(item.get("id"), int)}
    return [item for item in events if item.get("action") == "setup"
            and (repo_name is None or item.get("repo") == repo_name)
            and item.get("id") not in done]


def note(args):
    if args.kind == "setup-done":
        if args.repo != "-" or args.id != "-" or len(args.text) != 1 or not args.text[0].isdigit():
            raise Stop("Usage: task note - - setup-done <n>.")
        request_id = int(args.text[0])
        if request_id < 1:
            raise Stop("Setup request number must be positive.")
        path = HOME / ".local/state/task/setup-requests.jsonl"
        events = read_setup_events(path)
        entries = {item["id"]: item for item in events
                   if item.get("action") == "setup" and isinstance(item.get("id"), int)}
        request = entries.get(request_id)
        if not request or request.get("action") != "setup":
            raise Stop(f"No setup request #{request_id}.")
        if any(item.get("action") == "setup-done" and item.get("id") == request_id for item in events):
            raise Stop(f"Setup request #{request_id} is already done.")
        with path.open("a", encoding="utf-8") as out:
            out.write(json.dumps({"time": utc_now(), "action": "setup-done", "id": request_id},
                                 separators=(",", ":")) + "\n")
        print(f"Marked setup request #{request_id} done.")
        return 0

    repo = resolve_repo(args.repo)
    task = Task(repo, args.id) if args.id != "-" else None
    if args.kind == "setup":
        path = HOME / ".local/state/task/setup-requests.jsonl"
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open("a", encoding="utf-8") as out:
            fcntl.flock(out, fcntl.LOCK_EX)
            entries = read_setup_events(path)
            request_id = max((item.get("id", 0) for item in entries
                              if item.get("action") == "setup" and isinstance(item.get("id"), int)),
                             default=0) + 1
            entry = {"time": utc_now(), "action": "setup", "id": request_id, "repo": repo.name,
                     "task": task.id if task else "-", "text": args.text}
            out.write(json.dumps(entry, ensure_ascii=False, separators=(",", ":")) + "\n")
        print(f"Recorded setup request #{request_id} for {repo.name}.")
        return 0

    if task is None:
        raise Stop("An improvement or intervention note needs a task id.")
    if args.kind == "improve":
        path = task.kb / "improvements.md"
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open("a") as out:
            out.write(f"\n- {utc_now()[:10]} | {task.id} | note | {args.text} | open\n")
        print(f"Added improvement to {path}.")
    else:
        path = HOME / ".local/state/task/notes.jsonl"
        path.parent.mkdir(parents=True, exist_ok=True)
        entry = {"time": utc_now(), "repo": repo.name, "task": task.id,
                 "source": "intervention", "category": args.category or "", "text": args.text}
        with path.open("a") as out:
            out.write(json.dumps(entry, separators=(",", ":")) + "\n")
        print(f"Recorded intervention note in {path}.")
    return 0


def quality_summary(repo):
    roots = [HOME / ".local/state/task" / repo.name,
             HOME / ".local/state/task/archive" / repo.name]
    tasks = {}
    for root in roots:
        for file in root.rglob("review-*.md"):
            if not re.fullmatch(r"review-\d+\.md", file.name):
                continue
            # Numbered Markdown is the durable history; legacy review.md/json
            # only holds the latest verdict and cannot establish a first pass.
            header = file.read_text(errors="replace").split("\n\n", 1)[0]
            meta = {key.lower(): value for key, value in
                    re.findall(r"(?m)^(Verdict|Head|Time): (.+)$", header)}
            when = plan_time(meta.get("time"))
            if not when or meta.get("verdict") not in {"PASS", "FAIL"}:
                continue
            ident = file.relative_to(root).parts[0]
            entry = tasks.setdefault(ident, {"reviews": {}, "merges": []})
            # Latest pointer and archive copies do not count as additional reviews.
            entry['reviews'][(file.name, meta.get('head'), meta['time'])] = meta
        for file in root.rglob("*.json"):
            if file.name not in {"merge.json", "events.json"}:
                continue
            key = "time" if file.name == "merge.json" else "merge"
            when = plan_time(read_json_object(file).get(key))
            if when:
                ident = file.relative_to(root).parts[0]
                tasks.setdefault(ident, {"reviews": {}, "merges": []})['merges'].append(when.timestamp())
    dates = [plan_time(meta['time']) for entry in tasks.values()
             for meta in entry['reviews'].values()]
    since = min(dates) if dates else None
    date = since.date().isoformat() if since else "unknown"
    first, merged = [], []
    for entry in tasks.values():
        reviews = sorted(entry['reviews'].values(), key=lambda item: plan_time(item['time']))
        if reviews:
            first.append(reviews[0]['verdict'] == 'PASS')
        if reviews and any(when >= since.timestamp() for when in entry['merges']):
            merged.append(len(reviews))
    passed, total = sum(first), len(first)
    if total < 5:
        return f"quality: collecting ({total} tasks with review history since {date})"
    percent = round(100 * passed / total) if total else 0
    average = f"{sum(merged) / len(merged):.1f}" if merged else "n/a"
    return (f"quality (since {date}): first-review pass {passed}/{total} ({percent}%), "
            f"reviews per merged task {average}")


def status(args):
    active = boost_line()
    if active:
        print(active)
    print(f"Gate slots: {gate_slots()}")
    for row in gate_holders():
        print(f"gate {row[0]}: {holder_display(row, include_slot=False)}")
    repos = [resolve_repo(args.repo)] if args.repo else sorted(p for p in WORKSPACE.iterdir() if (p / ".git").exists())
    setup_path = HOME / ".local/state/task/setup-requests.jsonl"
    setup_warnings = []
    setup_events = read_setup_events(setup_path, setup_warnings)
    for repo in repos:
        for gate in (repo / ".worktrees").glob(".task-gate-*"):
            print(f"repair available: inspect stale gate worktree {gate}")
        print(f"{repo.name}:")
        try:
            keys = ", ".join(sorted(configured_environment(repo))) or "(none)"
        except Stop as error:
            keys = f"unavailable ({error})"
        except (OSError, ValueError):
            keys = f"unavailable (Cannot read environment for {repo}.)"
        print("  env keys: " + keys)
        try:
            names = ", ".join(gate_variants(repo)) or "(none)"
        except (Stop, OSError, ValueError) as error:
            names = f"unavailable ({error})"
        print("  gate variants: " + names)
        print("  " + quality_summary(repo))
        if (CORTEX / f"cortex-kb-{repo.name}").exists():
            print("  " + plan_verdict(plan_info(repo)))
        for record in sorted((repo / '.work').glob('runner-*.json')):
            data = json.loads(record.read_text())
            unit = data['unit']
            service = runner_service(unit) if data['backend'] == 'systemd' else {}
            active = (service.get('ActiveState') == 'active' if data['backend'] == 'systemd'
                      else pid_alive(data.get('pid')))
            done = record.with_suffix('.done')
            content = done.read_bytes() if done.exists() else b''
            lines = content[data.get('done_offset', 0):].decode().splitlines()
            print(f"  {unit}: {'active' if active else 'inactive'} "
                  f"started={service.get('ExecMainStartTimestamp') or data['started_at']} "
                  f"last={lines[-1] if lines else '(no .done line)'}")
        attention = []
        state_root = HOME / ".local/state/task" / repo.name
        for path in sorted((repo / ".worktrees").glob("*")) if (repo / ".worktrees").is_dir() else []:
            if path.name.startswith("."):
                continue
            if not real_worktree(repo, path):
                continue
            task = Task(repo, path.name)
            state = task_state(task)
            try:
                record = load_record(task, required=False)
            except Stop as error:
                print(f"  {path.name}: {error}")
                record = None
            head = sha(path, "HEAD")
            branch = git(path, "branch", "--show-current")
            check = {}
            review_data = {}
            for key, file in (("check", state / "check.json"), ("review", state / "review.json")):
                try:
                    data = json.loads(file.read_text())
                except (OSError, json.JSONDecodeError):
                    data = {}
                if key == "check": check = data
                else: review_data = data
            lane_check = {}
            try: lane_check = json.loads((path / ".work/check.json").read_text())
            except (OSError, json.JSONDecodeError): pass
            run = {}
            try: run = json.loads((state / "run.json").read_text())
            except (OSError, json.JSONDecodeError): pass
            run_state = run.get("state", "")
            lock_state = task_lock_status(task)
            if lock_state == "interrupted":
                run_state = "interrupted"
                print(f"repair available: interrupted run lock {state}")
            elif lock_state == "running" and run_state in {"foreground", "running"}:
                run_state = "running"
            if run_state == "running":
                if run.get("state") == "running":
                    try: os.killpg(int(run["pgid"]), 0)
                    except (ProcessLookupError, OSError, KeyError, ValueError): run_state = "interrupted"
            check_state = run_state if run_state in {"running", "interrupted"} else check.get("result", "missing")
            run_label = (f"merge {run_state}" if run.get("command") == "merge" and run_state
                         else f"check={check_state}@{check.get('sha', '?')[:7]}")
            report = (path / ".work/report.md").is_file()
            last = int(git(path, "log", "-1", "--format=%ct", "HEAD") or os.stat(path).st_mtime)
            try:
                events = json.loads((state / "events.json").read_text())
            except (OSError, json.JSONDecodeError):
                events = {}
            for stamp in events.values():
                try: last = max(last, int(datetime.fromisoformat(stamp).timestamp()))
                except (ValueError, TypeError): pass
            idle = max(0, int(time.time() - last))
            idle_label = f"{idle // 3600}h" if idle >= 3600 else f"{idle // 60}m"
            print(f"  {path.name}: builder={record.get('builder', '?') if record else '?'} head={head[:7]} "
                  f"{run_label} "
                  f"review={review_data.get('verdict', 'missing')} "
                  f"{'matches' if review_data.get('commit') == head else 'stale'} "
                  f"report={'present' if report else 'missing'} idle={idle_label} branch={branch}")
            if lane_check.get("advisory"):
                lane_result = lane_check.get("result", "unknown")
                current = (lane_check.get("sha") == head and record
                           and lane_check.get("record_revision") == record.get("revision"))
                freshness = "" if current else ", stale"
                print(f"    lane check: {lane_result} (advisory{freshness})")
            try:
                lane_run = json.loads((path / ".work/lane.json").read_text())
            except (OSError, json.JSONDecodeError):
                lane_run = {}
            if lane_run:
                lane_state = lane_run.get("state", "unknown")
                if lane_state == "running" and not pid_alive(lane_run.get("pid")):
                    lane_state = "interrupted"
                result = f" (exit {lane_run['exit_code']})" if "exit_code" in lane_run else ""
                limit = lane_limit(lane_run, path / ".work")
                if limit:
                    lane_state, result = "ended by usage limit", f" ({limit})"
                print(f"    lane: {lane_state}{result} pid={lane_run.get('pid', '?')} "
                      f"log={path / '.work/lane.log'} final={path / '.work/final.md'}")
                if lane_state in {"interrupted", "timed_out"} or lane_run.get("exit_code", 0) != 0:
                    attention.append(f"{path.name}: lane {lane_state}{result}")
            if (state / "exception.json").is_file():
                attention.append(f"{path.name}: exception")
            if check.get("result") == "failed":
                attention.append(f"{path.name}: failed check")
            if review_data.get("verdict") == "FAIL":
                attention.append(f"{path.name}: FAIL review")
            elif review_data and review_data.get("commit") != head:
                attention.append(f"{path.name}: stale review")
            if run_state == "interrupted":
                attention.append(f"{path.name}: interrupted run (log: {path / '.work/run.log'})")
            elif run_state in {"failed", "cancelled"}:
                attention.append(f"{path.name}: {run.get('command', 'check')} {run_state} "
                                 f"(log: {path / '.work/run.log'})")
        if state_root.is_dir():
            for state in sorted(item for item in state_root.iterdir() if item.is_dir()):
                pinned = state / "task.json"
                if pinned.is_file():
                    exception = read_json_object(pinned).get("off_plan")
                    if exception:
                        attention.append(f"{state.name}: off-plan exception: {exception}")
                if (state / "exception.json").is_file() and not any(state.name in entry for entry in attention):
                    attention.append(f"{state.name}: exception")
        for request in open_setup_requests(setup_path, repo.name, setup_events):
            attention.append(f"setup request #{request['id']} (task {request.get('task') or '-'}): "
                             f"{request.get('text', '')}")
        improvements = CORTEX / f"cortex-kb-{repo.name}" / "improvements.md"
        open_count = 0
        if improvements.is_file():
            open_count = sum(bool(re.search(r"\|\s*open\s*$", line, re.I))
                             for line in improvements.read_text().splitlines())
        print("  Needs attention:")
        for item in attention:
            print(f"    {item}")
        print(f"    open improvements: {open_count}")
    if args.repo is None:
        visible_repos = {repo.name for repo in repos}
        unlisted = [item for item in open_setup_requests(setup_path, events=setup_events)
                    if item.get("repo") not in visible_repos]
        if unlisted:
            print("Needs attention (setup requests outside dev_workspace):")
            for item in unlisted:
                print(f"  setup request #{item['id']} ({item.get('repo', '?')}, task "
                      f"{item.get('task') or '-'}): {item.get('text', '')}")
    for warning in setup_warnings:
        print(f"warning: {warning}", file=sys.stderr)
    return 0


def denials(args):
    path = HOME / ".local/state/agent-policy/denials.jsonl"
    cutoff = time.time() - args.days * 86400
    totals = {}
    if path.is_file():
        for line in path.read_text().splitlines():
            try:
                item = json.loads(line)
                stamp = datetime.fromisoformat(item["time"]).timestamp()
                if item.get("test") or item.get("is_test") or item.get("session_type") == "test":
                    continue
                rule = item.get("rule_id", "unknown")
                repo = item.get("repo", "")
                if stamp < cutoff or (args.rule and rule != args.rule):
                    continue
                if args.repo and args.repo not in (repo, Path(repo).name):
                    continue
                commands = totals.setdefault(rule, {})
                command = item.get("command", "")
                commands[command] = commands.get(command, 0) + 1
            except (ValueError, KeyError, TypeError, AttributeError):
                continue
    for rule, commands in sorted(totals.items()):
        print(f"{rule}: {sum(commands.values())}")
        for command, count in sorted(commands.items(), key=lambda pair: (-pair[1], pair[0]))[:3]:
            print(f"  {count}: {command}")
    if not totals: print("No denials in range.")
    return 0


def cancel(args):
    repo = resolve_repo(args.repo)
    if args.id.startswith('runner-'):
        record = repo / '.work' / f'{args.id}.json'
        if record.exists():
            data = json.loads(record.read_text())
            if data['backend'] == 'systemd':
                subprocess.run(['systemctl', '--user', 'stop', data['unit']], check=True)
            elif pid_alive(data.get('pid')):
                os.killpg(data['pid'], signal.SIGTERM)
            print(f"Cancelled {data['unit']}")
            return 0
    prune_stale_gate_worktrees(repo)
    task = Task(repo, args.id)
    lane_path = task.path / ".work/lane.json"
    try:
        lane_run = json.loads(lane_path.read_text())
    except (OSError, json.JSONDecodeError):
        lane_run = {}
    if lane_run.get("state") == "running" and pid_alive(lane_run.get("pid")):
        try:
            os.killpg(int(lane_run["pid"]), signal.SIGKILL)
        except (ProcessLookupError, PermissionError) as error:
            lane_run.update(state="interrupted", ended_at=utc_now())
            atomic_json(lane_path, lane_run)
            reason = "could not stop (permission denied)" if isinstance(error, PermissionError) else "already stopped"
            print(f"Lane process group {lane_run['pid']} {reason}; kept {task.path}.")
            return 0
        lane_run.update(state="cancelled", ended_at=utc_now())
        cleanup_lane_temporary(lane_run.get("temporary"))
        atomic_json(lane_path, lane_run)
        print(f"Cancelled lane process group {lane_run['pid']}; kept {task.path}.")
        return 0
    run_path = task_state(task) / "run.json"
    try: run = json.loads(run_path.read_text())
    except (OSError, json.JSONDecodeError): raise Stop("No detached run to cancel.")
    lock = run_path.parent / "run.lock"
    lock_state = task_lock_status(task)
    if run.get("state") in {"running", "foreground"} and not lock_state:
        pid = run.get("pid") or run.get("pgid")
        if not pid_alive(pid):
            run["state"] = "interrupted"
            run["ended_at"] = run.get("ended_at") or utc_now()
            atomic_json(run_path, run)
    if run.get("state") == "interrupted" or lock_state == "interrupted":
        lock.unlink(missing_ok=True)
        run["state"] = "interrupted"
        run["ended_at"] = run.get("ended_at") or utc_now()
        atomic_json(run_path, run)
        prune_stale_gate_worktrees(repo)
        print("Cleared interrupted run lock.")
        return 0
    if run.get("state") not in {"running", "foreground"} or lock_state != "running":
        raise Stop(f"Run is {run.get('state', 'unknown')}; nothing is running to cancel.")
    child_pgid = 0
    try:
        lock_record = json.loads(lock.read_text())
        child_pgid = int(lock_record.get("child_pgid", 0))
        if child_pgid:
            os.killpg(child_pgid, signal.SIGTERM)
        if run.get("state") == "running":
            os.killpg(int(run["pgid"]), signal.SIGTERM)
        else:
            os.kill(int(run["pid"]), signal.SIGTERM)
    except (ProcessLookupError, OSError, KeyError, ValueError): pass
    run_id = run.get("task_run_id")
    signal_task_run(run_id, signal.SIGTERM)
    deadline = time.monotonic() + 1
    while time.monotonic() < deadline:
        live_group = False
        try:
            if run.get("state") == "running":
                os.killpg(int(run["pgid"]), 0)
                live_group = True
            elif pid_alive(run.get("pid")):
                live_group = True
        except (ProcessLookupError, OSError, KeyError, ValueError):
            pass
        if not live_group and not task_run_pids(run_id):
            break
        time.sleep(0.05)
    else:
        try:
            if child_pgid:
                os.killpg(child_pgid, signal.SIGKILL)
            if run.get("state") == "running":
                os.killpg(int(run["pgid"]), signal.SIGKILL)
            else:
                os.kill(int(run["pid"]), signal.SIGKILL)
        except (ProcessLookupError, OSError, KeyError, ValueError): pass
    signal_task_run(run_id, signal.SIGKILL)
    run["state"] = "cancelled"
    run["ended_at"] = utc_now()
    atomic_json(run_path, run)
    (run_path.parent / "run.lock").unlink(missing_ok=True)
    prune_stale_gate_worktrees(repo)
    print("Cancelled task run.")
    return 0


def prune_archive(repo, dry_run=False):
    root = HOME / '.local/state/task/archive' / repo.name
    entries, sizes, errors = archive_inventory(root)
    known = {item: info for item, info in entries}
    allocated = {item: info.st_blocks * 512 for item, info in entries}
    for item, _info in reversed(entries):
        if item != root:
            allocated[item.parent] = allocated.get(item.parent, 0) + allocated[item]
    # Temporary snapshots are handled whole, before finished-archive filtering.
    try:
        live_gate = bool(gate_holders())
    except FileNotFoundError:
        live_gate = False
    temporary, freed, finishing = set(), 0, {}
    for item, info in entries:
        if item.parent in temporary:
            temporary.add(item)
            continue
        if not stat.S_ISDIR(info.st_mode):
            continue
        pending = item.name.startswith('.pending-')
        gate = gate_worktree_match(item.name)
        if not pending and not gate:
            continue
        if any(path == item or item in path.parents for path in errors):
            continue
        if gate and live_gate:
            temporary.add(item)
            continue
        if pending and not any(
                sibling.parent == item.parent and stat.S_ISDIR(sibling_info.st_mode) and
                not sibling.name.startswith('.') and
                stat.S_ISREG(known[sibling / 'manifest.json'].st_mode)
                for sibling, sibling_info in entries if sibling / 'manifest.json' in known):
            destination = item.with_name(f"{item.parent.name}-{item.name.removeprefix('.pending-')}")
            print(f"{'Would finish' if dry_run else 'Finishing'} {item} as {destination}")
            finishing[item] = destination
            if not dry_run:
                contents, content_sizes, content_errors = archive_inventory(item)
                manifest = item / 'manifest.json'
                record = json.loads(manifest.read_text()) if manifest in known else {}
                record.setdefault('note', 'finished by repair')
                record.setdefault('contents', [{'path': str(path.relative_to(item)),
                                  'size': content_sizes.get(path, 0)}
                                 for path, _info in contents if path != item])
                record.setdefault('skipped', []).extend(
                    {'path': str(path.relative_to(item)), 'reason': error}
                    for path, error in content_errors.items())
                atomic_json(manifest, record)
            continue
        temporary.add(item)
        freed += allocated.get(item, 0)
        print(f"{'Would remove' if dry_run else 'Removing'} {item} ({allocated.get(item, 0)} bytes)")
        if not dry_run:
            shutil.rmtree(item)
    removed = set()
    pruned = {}
    containers = {item.parent for item, _info in entries
                  if item.name == 'manifest.json' and
                  '.work' not in item.relative_to(root).parts} | set(finishing)
    protected = {root} | containers
    for container in containers:
        protected.update({container / '.work', container / 'reports', container / '.work/reports'})
        protected.update(container.parents)
    _oversized, disposable = oversized_contents(entries, sizes, protected, errors)
    for item, info in entries:
        if item in temporary:
            continue
        if item.parent in removed:
            removed.add(item)
            continue
        container = next((parent for parent in item.parents if parent in containers), None)
        if container is None:
            continue
        runtime = archive_runtime(item, info, errors)
        if any(path == item or item in path.parents for path in errors):
            continue
        large_log = (stat.S_ISREG(info.st_mode) and item.suffix == '.log' and
                     info.st_size >= 50 * 1024 ** 2 and not archive_evidence(item, info))
        # Named runtime trees are removed whole; generic contents preserve evidence.
        if not (runtime or item in disposable or large_log):
            continue
        removed.add(item)
        freed += allocated.get(item, 0)
        print(f"{'Would remove' if dry_run else 'Removing'} {item} ({allocated.get(item, 0)} bytes)")
        if not dry_run:
            if not stat.S_ISDIR(info.st_mode):
                item.unlink()
            else:
                shutil.rmtree(item)
            pruned.setdefault(container, []).append(
                f"pruned: {item.relative_to(container)} {allocated.get(item, 0)}")
    skipped = {}
    for item, error in errors.items():
        print(f"Skipped {item}: {error}")
        container = next((parent for parent in item.parents if parent in containers), None)
        if container is not None:
            skipped.setdefault(container, []).append(
                {'path': str(item.relative_to(container)), 'reason': error})
    for container in (set(pruned) | set(skipped)) if not dry_run else ():
        manifest = container / 'manifest.json'
        record = json.loads(manifest.read_text())
        record.setdefault('pruned', []).extend(pruned.get(container, []))
        existing = record.setdefault('skipped', [])
        existing.extend(entry for entry in skipped.get(container, []) if entry not in existing)
        atomic_json(manifest, record)
    if not dry_run:
        for pending, destination in finishing.items():
            pending.rename(destination)
    print(f"{'Would free' if dry_run else 'Freed'} {freed} bytes.")


def repair_published(task, base):
    if task.path.exists() and not real_worktree(task.repo, task.path):
        print(f"{task.path}: not a worktree; left as is")
        return
    state = task_state(task)
    head = sha(task.path, 'HEAD') if task.path.exists() else None
    try:
        pinned = json.loads((state / 'task.json').read_text())
    except (OSError, ValueError):
        pinned = {}
    # A freshly started lane at its original base has not published any work.
    if head and head == pinned.get('base_sha') and not (state / 'merge.json').exists():
        return
    if task.path.exists():
        try:
            lane = json.loads((task.path / '.work/lane.json').read_text())
        except (OSError, ValueError):
            lane = {}
        if lane.get('state') == 'running' and pid_alive(lane.get('pid')):
            return
    if not head:
        for filename, key in (('merge.json', 'head'), ('check.json', 'sha')):
            try:
                head = json.loads((state / filename).read_text()).get(key)
            except (OSError, ValueError):
                continue
            if head:
                break
    if not head or not is_ancestor(task.repo, head, base):
        return
    try:
        old_run = json.loads((state / 'run.json').read_text())
    except (OSError, ValueError):
        old_run = {}
    if ((state / 'merge.json').exists() and not task.path.exists() and
            not (old_run.get('command') == 'merge' and old_run.get('state') != 'passed')):
        return
    merges = git(task.repo, 'rev-list', '--merges', '--ancestry-path', '--reverse',
                 f'{head}..{base}').splitlines()
    commit = merges[0] if merges else base
    merged_at = read_json_object(state / 'merge.json').get('time') or git(task.repo, 'show', '-s', '--format=%cI', commit)
    atomic_json(state / 'merge.json', {'head': head, 'commit': commit, 'time': merged_at})
    print(update_local_default(task.repo, default_branch(task.repo), base))
    if task.path.exists():
        for name in ('report.md', 'check.log'):
            source = task.path / '.work' / name
            if source.is_file():
                shutil.copy2(source, state / name)
        if not (untracked(task.path) + ignored_leftovers(task.path)):
            preserve_work(task.repo, task.name, task.path, reuse_head=head)
            branch = git(task.path, 'branch', '--show-current')
            git(task.repo, 'worktree', 'remove', '--force', str(task.path))
            if branch:
                run_git(task.repo, 'branch', '-D', branch)
    run_path = state / 'run.json'
    try:
        record = json.loads(run_path.read_text())
    except (OSError, ValueError):
        record = {}
    if record.get('command') == 'merge' or record.get('kind') == 'merge':
        record.update(state='passed', ended_at=utc_now())
        atomic_json(run_path, record)
    print(f"Repaired published merge: {task.repo.name}/{task.id}")


def repair(args):
    repos = [resolve_repo(args.repo)] if args.repo else sorted(
        p for p in WORKSPACE.iterdir() if (p / ".git").exists())
    for repo in repos:
        if getattr(args, 'prune_archive', False):
            prune_archive(repo, args.dry_run)
            continue
        prune_stale_gate_worktrees(repo)
        try:
            fetch(repo)
        except Stop:
            print(f"Repair warning: fetch failed for {repo.name}; using the local default branch.",
                  file=sys.stderr)
            base = sha(repo, default_branch(repo))
        else:
            base, _label = base_commit(repo, default_branch(repo))
        names = {p.name for p in (repo / ".worktrees").glob("*") if not p.name.startswith(".")}
        names.update(p.name for p in (HOME / ".local/state/task" / repo.name).glob("*") if p.is_dir())
        for name in sorted(names):
            task = Task(repo, name)
            lane_path = task.path / ".work/lane.json"
            try:
                lane_run = json.loads(lane_path.read_text())
            except (OSError, ValueError):
                lane_run = {}
            if lane_run.get("state") == "running" and not pid_alive(lane_run.get("pid")):
                lane_run.update(state="interrupted", ended_at=utc_now())
                atomic_json(lane_path, lane_run)
                print(f"Repaired interrupted lane: {repo.name}/{task.id}")
            lock = task_state(task) / "run.lock"
            had_lock = lock.exists()
            result = task_lock_status(task, repair=True)
            if result == "interrupted" or had_lock and not lock.exists():
                print(f"Repaired interrupted run lock: {repo.name}/{task.id}")
            repair_published(task, base)
    return 0


def wait_task(args):
    task = Task(resolve_repo(args.repo), args.id)
    deadline = time.monotonic() + args.max * 60
    while True:
        runs = []
        labels = []
        for file in (task.path / ".work/lane.json", run_record_path(task)):
            try:
                run = json.loads(file.read_text())
            except (OSError, json.JSONDecodeError):
                continue
            if run.get("state") in {"running", "foreground", "starting"} and not pid_alive(run.get("pid")):
                run["state"] = "interrupted"
            runs.append(run)
            limit = lane_limit(run, task.path / ".work") if file.name == "lane.json" else ""
            labels.append(f"lane: ended by usage limit ({limit})" if limit else run.get("state", "unknown"))
        if not any(r.get("state") in {"running", "foreground", "starting"} for r in runs):
            print("; ".join(labels) or "not started")
            return 0
        if time.monotonic() >= deadline:
            print("still running")
            return 3
        time.sleep(min(10, max(0, deadline - time.monotonic())))


def prune_drill_worktrees(repo):
    for path in (repo / ".worktrees").glob(".*drill-*"):
        old = re.fullmatch(r"\.task-drill-\d{19}-(\d+)-\d+-(concurrent|solo)", path.name)
        new = re.fullmatch(r"\.drill-[0-9a-f]{6}-\d+-(group|solo)", path.name)
        if not old and not new:
            continue
        owner = path / ".work/drill.pid"
        pid = old.group(1) if old else owner.read_text().strip() if owner.is_file() else ""
        if pid.isdigit() and pid_alive(pid):
            continue
        result = run_git(repo, "worktree", "remove", "--force", str(path))
        if result.returncode:
            raise Stop(f"Cannot remove drill worktree {path}: {result.stderr}")


def gate_drill(args):
    """Measure real cross-repository clashes without consuming gate slots."""
    repos = list(dict.fromkeys(resolve_repo(name) for name in args.repos))
    for repo in repos:
        prune_drill_worktrees(repo)
    cli_seeds = {repo: [] for repo in repos}
    for value in args.seed:
        repo_name, separator, name = value.partition(":")
        if not separator or not name:
            raise Stop("gate-drill --seed requires <repo>:<name>.")
        repo = resolve_repo(repo_name)
        if repo not in cli_seeds:
            raise Stop(f"Seed repository {repo_name} is not in this drill.")
        cli_seeds[repo].append(name)
    archive = HOME / ".local/state/task/gate-drill" / (str(time.time_ns()) + f"-{os.getpid()}")
    archive.mkdir(parents=True)
    run_name = secrets.token_hex(3)
    worktrees = []
    interrupted = False

    def interrupt(signum, frame):
        nonlocal interrupted
        interrupted = True

    previous_handlers = {sig: signal.signal(sig, interrupt)
                         for sig in (signal.SIGTERM, signal.SIGINT)}

    def prepare(repo, index, phase):
        parent = repo / ".worktrees"
        parent.mkdir(exist_ok=True)
        mode = "solo" if phase == "solo" else "group"
        path = parent / f".drill-{run_name}-{index}-{mode}"
        base, _ = base_commit(repo, default_branch(repo))
        git(repo, "worktree", "add", "-q", "--detach", str(path), base)
        worktrees.append((repo, path))
        (path / ".work").mkdir(exist_ok=True)
        (path / ".work/drill.pid").write_text(str(os.getpid()))
        prepare_environment(repo, path)
        names = task_config(path).get("drill_seeds", [])
        if not isinstance(names, list) or any(not isinstance(name, str) for name in names):
            raise Stop(".task.toml drill_seeds must be a list of seed names.")
        names = list(dict.fromkeys(names + cli_seeds[repo]))
        for name in names:
            try:
                seed_source(repo, name)
            except Stop as error:
                if str(error).startswith("Seed does not exist:"):
                    raise Stop(f"missing seed {name}") from None
                raise
        seed_worktree(repo, path, names)
        return path

    def prepare_measure(repo, index, phase):
        try:
            if interrupted:
                raise Stop("Drill interrupted.")
            return measure(prepare(repo, index, phase), index, phase)
        except (Stop, OSError) as error:
            return {"result": "failed", "duration": 0, "error": str(error)}
        except ValueError:
            return {"result": "failed", "duration": 0, "error": f"Cannot read drill inputs for {repo}."}

    def measure(path, index, phase):
        # Drill runs hold no slot; run_check reserves a free port index above the slots.
        # The full default gate runs: `just check`, then pre-commit over all files when the
        # repository has a pre-commit config (a drill has no base range to check).
        token = GATE_SLOT.set(None)
        started = time.monotonic()
        try:
            passed = run_check(path, "", state=archive / f"{index}-{phase}",
                               evidence_name="drill-check.json", pre_commit_all_files=True,
                               cancelled=lambda: interrupted)
            return {"result": "passed" if passed else "failed",
                    "duration": round(time.monotonic() - started, 3)}
        except (Stop, OSError) as error:
            return {"result": "failed", "duration": round(time.monotonic() - started, 3),
                    "error": str(error)}
        except ValueError:
            return {"result": "failed", "duration": round(time.monotonic() - started, 3),
                    "error": f"Cannot read drill inputs in {path}."}
        finally:
            log = path / ".work/check.log"
            if log.is_file():
                destination = archive / f"{index}-{phase}"
                destination.mkdir(exist_ok=True)
                shutil.copy2(log, destination / "check.log")
            GATE_SLOT.reset(token)

    rows = []
    try:
        with ThreadPoolExecutor(max_workers=len(repos)) as pool:
            futures = [pool.submit(prepare_measure, repo, index, "concurrent")
                       for index, repo in enumerate(repos)]
            concurrent = [future.result() for future in futures]
        if interrupted:
            raise Stop("Drill interrupted.")
        for index, (repo, result) in enumerate(zip(repos, concurrent)):
            row = {"repo": repo.name, "concurrent": result,
                   "solo": prepare_measure(repo, index, "solo"), "verdict": "ok"}
            if row["solo"]["result"] != "passed":
                row["verdict"] = "failing-alone"
            elif result["result"] != "passed":
                row["verdict"] = "clash"
            rows.append(row)
            if interrupted:
                raise Stop("Drill interrupted.")
        table = ["repo | concurrent (seconds) | solo (seconds) | verdict"]
        for row in rows:
            def cell(result):
                return f"{result['result']} ({result['duration']})" if result else "-"
            table.append(f"{row['repo']} | {cell(row['concurrent'])} | {cell(row['solo'])} | {row['verdict']}")
            for phase in ("concurrent", "solo"):
                if row[phase] and row[phase].get("error"):
                    table.append(f"  {phase}: {row[phase]['error']}")
        table.append("Summary:")
        for row in rows:
            solo = "PASS" if row["solo"]["result"] == "passed" else "FAIL"
            together = "PASS" if row["concurrent"]["result"] == "passed" else "FAIL"
            note = " (pre-existing failure, not a concurrency clash)" if row["verdict"] == "failing-alone" else ""
            table.append(f"{row['repo']}: solo: {solo}, together: {together}, verdict: {row['verdict']}{note}")
        atomic_json(archive / "results.json", rows)
        (archive / "results.txt").write_text("\n".join(table) + "\n")
        print("\n".join(table), flush=True)
        print(f"Drill evidence: {archive}")
        return int(any(row["verdict"] != "ok" for row in rows))
    finally:
        try:
            errors = []
            for repo, path in reversed(worktrees):
                result = run_git(repo, "worktree", "remove", "--force", str(path))
                if result.returncode:
                    errors.append(f"Cannot remove drill worktree {path}: {result.stderr}")
            if errors:
                raise Stop("\n".join(errors))
            if interrupted:
                raise Stop("Drill interrupted.")
        finally:
            for sig, handler in previous_handlers.items():
                signal.signal(sig, handler)


def main(argv=None):
    global ACTIVE_FOREGROUND_TASK
    parser = argparse.ArgumentParser(prog="task", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    commands = parser.add_subparsers(dest="command", required=True)
    sub = commands.add_parser("gate-drill", help="PM-only concurrent full-gate clash drill")
    sub.add_argument("repos", nargs="+")
    sub.add_argument("--seed", action="append", default=[], metavar="REPO:NAME",
                     help="copy main checkout .work/NAME into each drill worktree; adds to .task.toml drill_seeds")
    for name in ("start", "lane", "merge", "close", "review", "cancel", "wait"):
        sub = commands.add_parser(name)
        sub.add_argument("repo")
        sub.add_argument("id")
        if name == "wait":
            sub.add_argument("--max", type=float, default=30, help="maximum wait in minutes (default 30)")
        if name == "start":
            sub.add_argument("--builder", choices=("codex", "claude"), required=True)
            sub.add_argument("--refresh", action="store_true")
            sub.add_argument("--seed", action="append", default=[], metavar="NAME")
            sub.add_argument("--no-verify", metavar="REASON")
            sub.add_argument("--off-plan", metavar="REASON")
        if name == "lane":
            sub.add_argument("--no-boost", action="store_true")
            sub.add_argument("--timeout", type=float, help="stop the lane process group after this many minutes")
            sub.add_argument("--builder", choices=("codex", "claude"))
            sub.add_argument("--model", help="Claude aliases sonnet|opus|fable or full claude-*-5-* ids; Codex gpt-6-luna|gpt-6.1-sol|gpt-6-astra")
            sub.add_argument("--_worker", action="store_true", help=argparse.SUPPRESS)
        if name == "merge":
            sub.add_argument("--lock-wait", type=float, default=45, help="gate lock wait in minutes (default 45)")
            sub.add_argument("--keep", action="store_true", help="keep the worktree and branch")
            sub.add_argument("--override", metavar="REASON")
            sub.add_argument("--detach", action="store_true")
        if name == "close":
            sub.add_argument("--no-merge", metavar="REASON", help="record why Done has no merge evidence")
            sub.add_argument("-m", "--message", required=True, help="final summary")
            sub.add_argument("--retro", required=True)
            sub.add_argument("--partial", action="store_true")
        if name == "review":
            mode = sub.add_mutually_exclusive_group()
            mode.add_argument("--run", action="store_true",
                              help="run the routed reviewer, print its reply, and record the verdict")
            mode.add_argument("--record", metavar="FILE")
            sub.add_argument("--request", metavar="FILE")
            sub.add_argument("--no-check", metavar="REASON", help="record an override of the passing-check prerequisite")
            sub.add_argument("--append-prompt", metavar="TEXT", help="append an instruction to the reviewer prompt")
            sub.add_argument("--reviewer", nargs=2, metavar=("VENDOR", "MODEL"),
                             help="reviewer identity for manually supplied reviews")
    sub = commands.add_parser("boost")
    sub.add_argument("action", nargs="?", choices=("off",))
    sub.add_argument("--claude-until")
    sub.add_argument("--codex-until")
    sub.add_argument("--claude", action="store_true")
    sub.add_argument("--codex", action="store_true")
    sub = commands.add_parser("plan")
    sub.add_argument("repo")
    sub.add_argument("--sign", action="store_true")
    sub = commands.add_parser("realign")
    sub.add_argument("repo")
    sub = commands.add_parser("runner-check", help="validate a runner file without launching it")
    sub.add_argument("repo")
    sub.add_argument("file")
    sub = commands.add_parser("runner-start", help="launch a validated, detached batch runner")
    sub.add_argument("repo")
    sub.add_argument("file")
    sub.add_argument("--llm", action="store_true", help="use the legacy Codex runner for this release")
    sub = commands.add_parser("check", help="task check | task check <id> | task check <repo> <id>")
    sub.add_argument("--variant", metavar="NAME", help="run one variant in an advisory lane check")
    sub.add_argument("args", nargs="*")
    sub.add_argument("--detach", action="store_true")
    sub.add_argument("--lock-wait", type=float, default=45, help="gate lock wait in minutes (default 45)")
    sub = commands.add_parser("note")
    sub.add_argument("repo")
    sub.add_argument("id")
    sub.add_argument("kind", choices=("improve", "intervention", "setup", "setup-done"))
    sub.add_argument("text", nargs="+")
    sub = commands.add_parser("status")
    sub.add_argument("repo", nargs="?")
    sub = commands.add_parser("repair", help="explicitly repair stale task state and gate worktrees")
    sub.add_argument("repo", nargs="?")
    sub.add_argument("--prune-archive", action="store_true")
    sub.add_argument("--dry-run", action="store_true")
    sub = commands.add_parser("denials")
    sub.add_argument("--days", type=int, default=30)
    sub.add_argument("--rule")
    sub.add_argument("--repo")
    args = parser.parse_args(argv)
    if args.command == "lane" and args.timeout is not None and not args.timeout > 0:
        parser.error("--timeout must be greater than zero minutes")
    global GATE_LOCK_WAIT
    GATE_LOCK_WAIT = getattr(args, "lock_wait", 45)
    if args.command == "check":
        if len(args.args) > 2:
            parser.error("usage: task check [[<repo>] <id>]")
        args.repo, args.id = ([None, None] + args.args)[-2:]
    if args.command in {"start", "lane", "review", "merge", "close", "cancel", "note", "repair", "realign", "runner-start", "gate-drill"} or args.command == "plan" and args.sign or args.command == "boost" and (args.action or args.claude_until or args.codex_until):
        try:
            require_pm(args)
        except Stop as stop:
            print(f"task {args.command}: {stop}", file=sys.stderr)
            return 1
    try:
        if args.command == "note":
            if args.kind != "setup-done":
                if args.kind == "intervention" and args.text[0] in "ABCDEFGH" and len(args.text) > 1:
                    args.category = args.text.pop(0)
                else:
                    args.category = ""
                args.text = " ".join(args.text)
        if args.command in {"check", "merge"} and args.detach:
            if args.command == "check" and advisory_check_for(check_task_from_args(args)):
                args.detach = False
            else:
                if args.command == "check":
                    if args.id is None:
                        path = Path(git(Path.cwd(), "rev-parse", "--show-toplevel"))
                        repo = main_repo(path)
                        task = Task(repo, path.name)
                    else:
                        repo = resolve_repo(args.repo) if args.repo else main_repo(Path.cwd())
                        task = Task(repo, args.id)
                        path = task.worktree()
                else:
                    repo = resolve_repo(args.repo)
                    task = Task(repo, args.id)
                    path = task.worktree()
                return detached(args, task, path)
        # A visible lock can prompt cancellation before run.json and the
        # handlers exist. Defer termination until startup is fully recorded.
        previous_mask = signal.pthread_sigmask(signal.SIG_BLOCK, {signal.SIGHUP, signal.SIGTERM})
        try:
            lock = foreground_lock(args)
            if lock:
                signal.signal(signal.SIGHUP, handle_interruption)
                signal.signal(signal.SIGTERM, handle_interruption)
        finally:
            signal.pthread_sigmask(signal.SIG_SETMASK, previous_mask)
        if not lock and os.environ.get("TASK_RUN_RECORD") and args.command in {"check", "merge"}:
            if args.command == "merge":
                ACTIVE_FOREGROUND_TASK = Task(resolve_repo(args.repo), args.id)
            elif args.id is not None:
                repo = resolve_repo(args.repo) if args.repo else main_repo(Path.cwd())
                ACTIVE_FOREGROUND_TASK = Task(repo, args.id)
            else:
                top = Path(git(Path.cwd(), "rev-parse", "--show-toplevel"))
                ACTIVE_FOREGROUND_TASK = Task(main_repo(top), top.name)
            signal.signal(signal.SIGHUP, handle_interruption)
            signal.signal(signal.SIGTERM, handle_interruption)
        result = 1
        try:
            result = {"start": start, "lane": lane, "check": check, "merge": merge, "close": close,
                      "review": review, "cancel": cancel, "note": note, "status": status,
                      "denials": denials, "runner-check": runner_check, "runner-start": runner_start, "repair": repair,
                      "wait": wait_task, "plan": plan, "realign": realign, "boost": boost,
                      "gate-drill": gate_drill}[args.command](args) or 0
        finally:
            if lock:
                run_path = lock.parent / "run.json"
                try: run = json.loads(run_path.read_text())
                except (OSError, json.JSONDecodeError): run = {}
                if run.get("pid") == os.getpid() and run.get("state") == "foreground":
                    run["state"] = "passed" if result == 0 else "failed"
                    run["ended_at"] = utc_now()
                    atomic_json(run_path, run)
                lock.unlink(missing_ok=True)
                ACTIVE_FOREGROUND_TASK = None
        finish_detached(result)
        return result
    except SystemExit as stop:
        finish_detached(stop.code or 0)
        raise
    except Stop as stop:
        finish_detached(1)
        print(f"task {args.command}: {stop}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
