def archive_exclusion(item, info, size=None, errors=None, *, hash_files=True):
    """Shared no-follow copy/prune rule; hashes are streamed, never buffered whole."""
    mode = info.st_mode
    record = {"size": info.st_size if size is None else size}
    if stat.S_ISLNK(mode):
        return None
    if archive_runtime(item, info, errors) or (stat.S_ISREG(mode) and item.suffix == '.pyc'):
        return dict(record, reason="cache/runtime")
    if not stat.S_ISREG(mode):
        return None
    name = item.name.lower()
    base = re.sub(r'-(wal|shm|journal)$', '', name)
    reason = "database" if base.endswith(('.sqlite', '.sqlite3', '.db', '.duckdb')) else None
    if reason is None and info.st_size > 50 * 1024 ** 2:
        reason = "file over 50 MB"
    try:
        with os.fdopen(os.open(item, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK), 'rb') as stream:
            if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
                raise OSError("file type changed")
            header = stream.read(16)
            if header == b'SQLite format 3\0':
                reason = "database"
            if reason:
                if not hash_files:
                    return dict(record, reason=reason)
                digest = hashlib.sha256(header)
                for chunk in iter(lambda: stream.read(1024 * 1024), b''):
                    digest.update(chunk)
                return dict(record, reason=reason, sha256=digest.hexdigest())
    except OSError as error:
        if reason is None:
            raise
        return dict(record, reason=reason, **({'sha256': None} if hash_files else {}), error=str(error))
    return None


def prune_evidence_archive(root, apply, report, *, snapshots=None):
    """Prune archive snapshots, including legacy ones without manifests; never traverse links."""
    if any(item.is_symlink() for item in (root, *root.parents)) or not root.is_dir():
        return
    entries, _, _ = archive_inventory(root)
    total = 0
    for snapshot, info in entries:
        repair = snapshots is not None
        if (not stat.S_ISDIR(info.st_mode) or
                (snapshot not in snapshots if repair else len(snapshot.relative_to(root).parts) != 3) or
                (any(part.startswith('.pending-') for part in snapshot.relative_to(root).parts)
                 and not (repair and not apply))):
            continue
        manifest = snapshot / 'manifest.json'
        if manifest.is_symlink():
            report.append(f"archive: cannot prune {snapshot}: symlink manifest")
            continue
        try:
            record = json.loads(manifest.read_text()) if manifest.exists() else {}
            if not isinstance(record, dict) or not isinstance(record.get('pruned', []), list):
                raise ValueError("manifest must be an object with a pruned list")
            contents, sizes, errors = archive_inventory(manifest.parent)
            protected = {snapshot, snapshot / '.work', snapshot / 'reports', snapshot / '.work/reports'}
            _, disposable = oversized_contents(contents, sizes, protected, errors) if repair else (set(), set())
            for item, error in errors.items():
                report.append(f"Skipped {item}: {error}")
            if apply and errors:
                skipped = record.setdefault('skipped', [])
                for item, error in errors.items():
                    entry = {'path': str(item.relative_to(snapshot)), 'reason': error}
                    if entry not in skipped:
                        skipped.append(entry)
                atomic_json(manifest, record)
            excluded = set()
            for item, meta in contents:
                if item == manifest or item == manifest.parent:
                    continue
                if item.parent in excluded:
                    excluded.add(item)
                    continue
                try:
                    removal = archive_exclusion(item, meta, sizes[item], hash_files=apply)
                except OSError as error:
                    report.append(f"archive: kept {item}: {error}")
                    continue
                if removal is None and item in disposable:
                    removal = {'size': sizes[item], 'reason': 'directory over 200 MB'}
                if removal is None or any(path == item or item in path.parents for path in errors):
                    continue
                excluded.add(item)
                total += removal['size']
                removal.update(path=str(item.relative_to(manifest.parent)), date=utc_now())
                report.append(f"archive: {'remove' if apply else 'would remove'} {item} ({removal['size']} bytes): {removal['reason']}")
                if apply:
                    try:
                        if stat.S_ISDIR(meta.st_mode):
                            shutil.rmtree(item)
                        else:
                            item.unlink()
                    except OSError as error:
                        report.append(f"archive: cannot remove {item}: {error}")
                        continue
                    record.setdefault('pruned', []).append(removal)
                    atomic_json(manifest, record)
            if apply:
                for item, meta in reversed(contents):
                    if stat.S_ISDIR(meta.st_mode) and item != manifest.parent:
                        try:
                            item.rmdir()
                        except OSError:
                            pass
        except (OSError, ValueError, TypeError) as error:
            report.append(f"archive: cannot prune {manifest.parent}: {error}")
    report.append(f"archive: {'removed' if apply else 'would remove'} {total} bytes total")


def archive_runtime(item, info, errors=None):
    try:
        if stat.S_ISLNK(info.st_mode):
            return False
        if item.name in WORK_CACHES or item.name.endswith('.sock') or stat.S_ISSOCK(info.st_mode):
            return True
        if stat.S_ISDIR(info.st_mode):
            try:
                return stat.S_ISREG((item / 'pyvenv.cfg').lstat().st_mode)
            except FileNotFoundError:
                pass
        return False
    except OSError as error:
        if errors is not None:
            errors[item] = f"cannot inspect: {error}"
        return False


def archive_inventory(root):
    """Iterative, no-follow inventory: runtime trees may be deep or disappearing."""
    entries, sizes, errors = [], {}, {}
    stack = [root]
    while stack:
        item = stack.pop()
        try:
            info = item.lstat()
            entries.append((item, info))
            sizes[item] = info.st_size if not stat.S_ISDIR(info.st_mode) else 0
            if stat.S_ISDIR(info.st_mode):
                stack.extend(item.iterdir())
        except OSError as error:
            errors[item] = str(error)
    for item, info in reversed(entries):
        if item != root:
            sizes[item.parent] = sizes.get(item.parent, 0) + sizes[item]
    return entries, sizes, errors


def archive_evidence(item, info):
    name = item.name.lower()
    return (item.suffix.lower() in {'.md', '.json', '.jsonl', '.txt', '.html',
                                    '.toml', '.yaml', '.yml', '.csv'} or
            (item.suffix.lower() == '.log' and info.st_size < 50 * 1024 ** 2) or
            any(word in name for word in ('report', 'prompt', 'request', 'check', 'review',
                                          'merge', 'manifest', 'run', 'task', 'exception', 'gate')))


def oversized_contents(entries, sizes, protected, errors):
    """Select non-evidence contents, retaining directories needed by evidence."""
    roots, retained, covered, runtime = set(), set(), set(), set()
    for item, info in entries:
        if item.parent in runtime or archive_runtime(item, info, errors):
            runtime.add(item)
        if (stat.S_ISDIR(info.st_mode) and item not in protected and
                sizes.get(item, 0) > 200 * 1024 ** 2):
            roots.add(item)
        if item in roots or item.parent in covered:
            covered.add(item)
        if item not in runtime and not stat.S_ISDIR(info.st_mode) and archive_evidence(item, info):
            retained.add(item)
            retained.update(item.parents)
    for item in errors:
        retained.add(item)
        retained.update(item.parents)
    return roots, covered - retained
