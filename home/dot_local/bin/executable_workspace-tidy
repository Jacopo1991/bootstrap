#!/usr/bin/env python3
"""workspace-tidy: keep every project to its two repositories (code and cortex-kb).

Removes only what is provably finished and nothing else:
- hand-made worktrees inside a repository (<repo>/.worktrees/<name>, <repo>/.claude/worktrees/<name>)
  that are clean, unlocked, not in use, idle for a day, and whose every commit (HEAD and its
  reflog) is already in the default branch. Ignored rebuildable caches are discarded, their files
  neither scanned nor copied; .work and other ignored evidence are archived first, with
  relative paths preserved, under ~/.local/state/task/archive/<repo>/<worktree>/. An ignored
  file that looks like a secret (.env, .env.*, *.pem, *.key, id_rsa*, id_ed25519*, anything
  under secrets/), anywhere including .work and .claude, is never copied and keeps the
  worktree in place. Databases, files over 50 MB and caches are skipped and recorded;
  existing archives are also pruned with --apply (otherwise removals are reported);
- local branches whose commits, including their reflog, are all in the default branch.
- Codex app worktrees under `$CODEX_HOME/worktrees` that are clean and whose branch is merged
  or whose detached commit is reachable from a default branch.
Everything else is reported for the PM, never changed: worktrees elsewhere, ~/project-data,
plain folders, second checkouts. Finished, clean Codex app worktrees in $CODEX_HOME/worktrees are
reported and removed only with --apply; unfinished or dirty Codex worktrees are retained, and
ignored non-cache files still block them.
Unmerged worktrees idle for more than 7 days, Codex app worktrees included, are reported and listed by `task status` under
"Needs attention" (finish, adopt or delete), locked ones too with their lock reason; they are
never removed.

Usage: workspace-tidy            report only
       workspace-tidy --apply    also remove finished worktrees and merged branches
The report is also written to ~/.local/state/workspace-tidy/report.txt.
"""
import argparse
import fnmatch
import json
import os
import runpy
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

HOME = Path(os.environ.get("HOME", "/home/agent"))
WORKSPACE = HOME / "dev_workspace"
CORTEX = HOME / "cortex"
PROJECT_DATA = HOME / "project-data"
CODEX_WORKTREES = Path(os.environ.get("CODEX_HOME") or HOME / ".codex") / "worktrees"
STATE = HOME / ".local/state/workspace-tidy"
DECLARATION = ".project-data"
GRACE = 24 * 3600          # never touch anything created, moved or changed in the last day
STALE_DAYS = 7             # report open worktrees idle longer than this
DEFAULT_REFS = ("refs/heads/main", "refs/heads/master",
                "refs/remotes/origin/main", "refs/remotes/origin/master")
TIDY_DIRS = (".worktrees", ".claude/worktrees")      # the only places removal may happen
# Ignored content that is safe to lose because a build or install recreates it.
REBUILDABLE = {"node_modules", ".venv", "venv", "__pycache__", ".pytest_cache", ".mypy_cache",
               ".ruff_cache", ".cache", "dist", "build", ".next", ".astro", ".turbo", "coverage",
               ".tox", ".parcel-cache", "target"}
# Ignored files that look like secrets are never copied; any path part may match.
SECRET_PATTERNS = (".env", ".env.*", "*.pem", "*.key", "id_rsa*", "id_ed25519*", "secrets")
IN_PROGRESS = ("MERGE_HEAD", "rebase-merge", "rebase-apply", "CHERRY_PICK_HEAD", "REVERT_HEAD",
               "BISECT_LOG")


def git(repo: Path, *args: str) -> subprocess.CompletedProcess:
    query = args[:1] in [('show-ref',), ('rev-list',), ('log',), ('ls-files',), ('rev-parse',), ('for-each-ref',)]
    query |= args[:2] in [('reflog', 'show'), ('worktree', 'list'), ('remote', 'get-url')]
    query |= args == ('config', '--bool', 'core.sparseCheckout') or args[:4] == ('--no-optional-locks', '-c', 'status.showUntrackedFiles=all', 'status')
    if not query: admit()
    return subprocess.run(["git", "-C", str(repo), *args], capture_output=True, text=True,
                          timeout=120, stdin=subprocess.DEVNULL)


def admit(): subprocess.run([str(HOME / '.local/bin/task'), 'hold', '--check'], check=True)


def repos() -> list[Path]:
    """Main checkouts directly under ~/dev_workspace and ~/cortex."""
    found = []
    for root in (WORKSPACE, CORTEX):
        if root.is_dir():
            found += [entry for entry in sorted(root.iterdir()) if (entry / ".git").is_dir()]
    return found


def inside(path: Path, parent: Path) -> bool:
    try:
        path.resolve().relative_to(parent.resolve())
        return True
    except (OSError, ValueError):
        return False


def default_refs(repo: Path) -> list[str]:
    return [ref for ref in DEFAULT_REFS
            if git(repo, "show-ref", "--verify", "--quiet", ref).returncode == 0]


def all_contained(repo: Path, commits: set[str], refs: list[str]) -> bool:
    """True when every commit is reachable from a default ref (rev-list prints nothing)."""
    commits = {commit for commit in commits if commit}
    if not commits:
        return True
    result = git(repo, "rev-list", "--max-count=1", *sorted(commits), "--not", *refs)
    return result.returncode == 0 and not result.stdout.strip()


def reflog_commits(where: Path, ref: str) -> set[str]:
    return set(git(where, "reflog", "show", "--format=%H", ref).stdout.split())


def worktree_list(repo: Path) -> list[dict]:
    """All worktrees of a repository, main checkout first (git worktree list --porcelain)."""
    items, current = [], {}
    for line in git(repo, "worktree", "list", "--porcelain").stdout.splitlines() + [""]:
        if not line:
            if current:
                items.append(current)
            current = {}
            continue
        key, _, value = line.partition(" ")
        current[key] = value or True
    return items


def last_activity(repo: Path, path: Path, gitdir: Path, head: str) -> float:
    """Newest of: the worktree's .git file, its HEAD log (checkouts, commits) and HEAD commit.
    Not the index: plain `git status` refreshes it."""
    times = [candidate.stat().st_mtime for candidate in (path / ".git", gitdir / "logs/HEAD")
             if candidate.exists()]
    stamp = git(repo, "log", "-1", "--format=%ct", head).stdout.strip() if head else ""
    if stamp.isdigit():
        times.append(float(stamp))
    return max(times) if times else time.time()


def ref_updated(repo: Path, ref: str) -> float:
    """When the branch last moved (its newest reflog entry), else its tip commit time."""
    entry = git(repo, "reflog", "show", "-1", "--date=unix", "--format=%gd", ref).stdout.strip()
    if "@{" in entry and entry.endswith("}") and entry[entry.index("@{") + 2:-1].isdigit():
        return float(entry[entry.index("@{") + 2:-1])
    stamp = git(repo, "log", "-1", "--format=%ct", ref).stdout.strip()
    return float(stamp) if stamp.isdigit() else time.time()


def paths_in_use() -> list[Path]:
    """Working directories of running processes (an agent or editor still inside a worktree)."""
    found = []
    for proc in Path("/proc").iterdir():
        if proc.name.isdigit():
            try:
                found.append(Path(os.readlink(proc / "cwd")))
            except OSError:
                continue
    return found


def secret_looking(parts: tuple[str, ...]) -> bool:
    return any(fnmatch.fnmatch(part.lower(), pattern) for part in parts for pattern in SECRET_PATTERNS)


def secret_in(path: Path, relative: Path) -> str | None:
    """Why an ignored entry holds a secret-looking file; rebuildable caches are not scanned."""
    if any(part in REBUILDABLE for part in relative.parts):
        return None
    if secret_looking(relative.parts):
        return f"ignored file that looks like a secret: {relative}"
    full = path / relative
    if full.is_symlink() or not full.is_dir():
        return None
    for root, dirs, files in os.walk(full):
        base = Path(root).relative_to(path)
        dirs[:] = [name for name in dirs if name not in REBUILDABLE]
        for name in dirs + files:
            if secret_looking((base / name).parts):
                return f"ignored file that looks like a secret: {base / name}"
    return None


def collect_ignored(path: Path, relative: Path, found: list[Path]) -> str | None:
    """Add the files under an ignored entry to `found`; return why they cannot be archived."""
    if secret_looking(relative.parts):
        return f"ignored file that looks like a secret: {relative}"
    full = path / relative
    if full.is_symlink() or full.is_file():
        found.append(relative)
        return None
    if not full.is_dir():
        return f"ignored special file: {relative}"
    for root, dirs, files in os.walk(full):
        base = Path(root).relative_to(path)
        dirs[:] = [name for name in dirs if name not in REBUILDABLE]
        for name in sorted(dirs + files):
            child = base / name
            target = path / child
            if secret_looking(child.parts):
                return f"ignored file that looks like a secret: {child}"
            if target.is_symlink() or target.is_file():
                found.append(child)
            elif not target.is_dir():
                return f"ignored special file: {child}"
    return None


def removal_blocker(path: Path, gitdir: Path, in_use: list[Path],
                    archivable: list[Path] | None = None) -> str | None:
    """Why this worktree must not be removed, or None when removing it loses nothing.

    With `archivable`, ignored non-cache files no longer block: they are collected there for the
    caller to archive. Without it they block, as for Codex worktrees."""
    if any(inside(cwd, path) for cwd in in_use):
        return "in use by a running process"
    if any((gitdir / name).exists() for name in IN_PROGRESS):
        return "merge, rebase, cherry-pick, revert or bisect in progress"
    status = git(path, "--no-optional-locks", "-c", "status.showUntrackedFiles=all", "status",
                 "--porcelain", "-z", "--untracked-files=all", "--ignore-submodules=none",
                 "--ignored=matching")
    if status.returncode != 0:
        return "status unreadable"
    for item in status.stdout.split("\0"):
        if not item:
            continue
        parts = Path(item[3:].rstrip("/")).parts
        if item[:3] in ("!! ", "?? ") and parts and parts[0] == ".claude":
            # session-local settings and transcripts are disposable, unless they hold a secret
            problem = secret_in(path, Path(*parts)) if item.startswith("!! ") else None
            if problem:
                return problem
            continue
        if not item.startswith("!! "):
            return "uncommitted or untracked changes"
        if parts and parts[0] == ".work":
            problem = secret_in(path, Path(*parts))   # .work is archived whole
            if problem:
                return problem
            continue
        if any(part in REBUILDABLE for part in parts):
            continue
        if archivable is None:
            return f"ignored file that is not a rebuildable cache: {item[3:]}"
        problem = collect_ignored(path, Path(*parts), archivable)
        if problem:
            return problem
    flags = git(path, "ls-files", "-v").stdout.splitlines()
    sparse = git(path, "config", "--bool", "core.sparseCheckout").stdout.strip() == "true"
    if any(line[:1].islower() or (line[:1] == "S" and not sparse) for line in flags):
        return "files marked assume-unchanged or skip-worktree"
    return None


def archive_helpers():
    tool = Path(__file__).with_name("task")
    if not tool.is_file():
        tool = Path(__file__).with_name("executable_task")
    return runpy.run_path(str(tool), run_name="workspace_tidy_archive")


def archive_work(repo, path, report):
    """Use task merge's archive implementation before discarding ignored evidence."""
    try:
        task = archive_helpers()
        task["preserve_work"](repo, path.name, path, strict=True)
    except Exception as error:
        report.append(f"{repo.name}: kept {path}: cannot archive .work: {error}")
        return False
    return True


def archive_ignored(repo, path, files, report):
    """Copy ignored non-cache files, relative paths preserved, next to the .work archive."""
    base = HOME / ".local/state/task/archive" / repo.name / path.name
    pending = None
    try:
        base.mkdir(parents=True, exist_ok=True)
        pending = Path(tempfile.mkdtemp(prefix=".pending-", dir=base))
        task, skipped, excluded = archive_helpers(), [], set()
        for relative in files:
            if any(parent in excluded for parent in (relative, *relative.parents)):
                continue
            for parent in reversed(relative.parents):
                if parent == Path('.'):
                    continue
                directory = path / parent
                omission = task['archive_exclusion'](directory, directory.lstat())
                if omission:
                    _, sizes, _ = task['archive_inventory'](directory)
                    skipped.append(dict(omission, path=str(parent), size=sizes[directory]))
                    excluded.add(parent)
                    break
            else:
                omission = None
            if omission:
                continue
            source = path / relative
            omission = task['archive_exclusion'](source, source.lstat())
            if omission:
                skipped.append(dict(omission, path=str(relative)))
                continue
            target = pending / 'ignored' / relative
            target.parent.mkdir(parents=True, exist_ok=True)
            if (path / relative).is_symlink():
                target.symlink_to(os.readlink(path / relative))
            else:
                shutil.copy2(path / relative, target)
        with tempfile.NamedTemporaryFile(mode='w', dir=pending, delete=False) as stream:
            json.dump({'skipped': skipped}, stream, indent=2, sort_keys=True)
            stream.write('\n')
        Path(stream.name).replace(pending / 'manifest.json')
        destination = base / f"{path.name}-ignored-{pending.name.removeprefix('.pending-')}"
        pending.rename(destination)
    except OSError as error:
        if pending:
            admit()
            shutil.rmtree(pending, ignore_errors=True)
        report.append(f"{repo.name}: kept {path}: cannot archive ignored files: {error}")
        return None
    return destination


def tidy_codex_worktree(repo: Path, entry: dict, path: Path, refs: list[str], apply: bool,
                        now: float,
                        in_use: list[Path], report: list[str], done: list[str]) -> None:
    branch = entry.get("branch") if isinstance(entry.get("branch"), str) else None
    label = branch[len("refs/heads/"):] if branch else "detached"
    prefix = f"{repo.name}: Codex worktree {path} ({label})"
    if "prunable" in entry or not path.is_dir():
        report.append(f"{prefix} kept: worktree folder missing or prunable")
        return
    if "locked" in entry:
        report.append(f"{prefix} kept: worktree is locked{idle_note(repo, entry, refs, now)}")
        return
    head = entry.get("HEAD") if isinstance(entry.get("HEAD"), str) else ""
    if not head:
        report.append(f"{prefix} kept: HEAD is missing")
        return
    if not refs:
        report.append(f"{prefix} kept: repository default branch could not be identified")
        return
    default_branches = {ref.removeprefix("refs/heads/") for ref in refs
                        if ref.startswith("refs/heads/")}
    if branch and label in default_branches:
        report.append(f"{prefix} kept: it is a default-branch checkout")
        return
    if branch:
        commits = {head} | reflog_commits(path, "HEAD")
        finished = all_contained(repo, commits, refs)
    else:
        finished = all_contained(repo, {head}, refs)
    if not finished:
        report.append(f"{prefix} kept: branch is not merged or detached commit is outside the default branch"
                      f"{idle_note(repo, entry, refs, now)}")
        return
    gitdir = Path(git(path, "rev-parse", "--absolute-git-dir").stdout.strip() or "/nonexistent")
    age = now - last_activity(repo, path, gitdir, head)
    if age <= GRACE:
        report.append(f"{prefix} kept: within one-day grace period (idle {max(0, int(age // 3600))} hours)")
        return
    blocker = removal_blocker(path, gitdir, in_use)
    if blocker:
        report.append(f"{prefix} kept: {blocker}")
    elif not apply:
        archive = " (would archive .work first)" if (path / ".work").exists() else ""
        report.append(f"{prefix} is finished and clean; would be removed{archive}")
    else:
        source = path / ".work"
        if (source.exists() or source.is_symlink()) and not archive_work(repo, path, report):
            return
        # The blocker checked all changes; --force also discards disposable session files.
        admit()
        result = git(repo, "worktree", "remove", "--force", str(path))
        if result.returncode == 0:
            done.append(f"{repo.name}: removed finished Codex worktree {path} ({label})")
        else:
            report.append(f"{prefix} could not be removed: {result.stderr.strip()}")


def worktree_state(repo: Path, entry: dict, refs: list[str], now: float) -> tuple[Path, bool, float]:
    """The git directory, whether every commit is in the default branch, and idle seconds."""
    path = Path(entry["worktree"])
    gitdir = Path(git(path, "rev-parse", "--absolute-git-dir").stdout.strip() or "/nonexistent")
    head = entry.get("HEAD") if isinstance(entry.get("HEAD"), str) else ""
    age = now - last_activity(repo, path, gitdir, head)
    merged = bool(refs) and all_contained(repo, {head} | reflog_commits(path, "HEAD"), refs)
    return gitdir, merged, age


def lock_note(entry: dict) -> str:
    """Empty when the worktree is not locked, else ", locked: <reason>" (", locked" without one)."""
    if "locked" not in entry:
        return ""
    reason = entry["locked"] if isinstance(entry["locked"], str) else ""
    return f", locked: {reason}" if reason else ", locked"


def idle_note(repo: Path, entry: dict, refs: list[str], now: float) -> str:
    """For an unmerged worktree idle past STALE_DAYS: "; idle N days; finish, adopt or delete", else empty."""
    if not entry.get("HEAD") or not refs:
        return ""
    _, merged, age = worktree_state(repo, entry, refs, now)
    if merged or age <= STALE_DAYS * 86400:
        return ""
    return f"; idle {int(age // 86400)} days; finish, adopt or delete"


def stale_unmerged(repo: Path, now: float) -> list[dict]:
    """Every unmerged worktree git has registered, wherever it lives (Codex app ones included), idle for more than
    STALE_DAYS, locked ones included."""
    refs = default_refs(repo)
    found = []
    for entry in worktree_list(repo)[1:]:
        path = Path(entry["worktree"])
        if "prunable" in entry:
            continue
        _, merged, age = worktree_state(repo, entry, refs, now)
        if not merged and age > STALE_DAYS * 86400:
            branch = entry.get("branch") if isinstance(entry.get("branch"), str) else None
            found.append({"path": path, "branch": branch[len("refs/heads/"):] if branch else "detached",
                          "days": int(age // 86400), "locked": lock_note(entry)})
    return found


def tidy_repo(repo: Path, apply: bool, now: float, in_use: list[Path], report: list[str],
              done: list[str], seen_codex: set[Path]) -> None:
    refs = default_refs(repo)
    entries = worktree_list(repo)
    checked_out = {entry["branch"] for entry in entries if isinstance(entry.get("branch"), str)}
    for entry in entries[1:]:               # the first entry is the main checkout
        path = Path(entry["worktree"])
        branch = entry.get("branch") if isinstance(entry.get("branch"), str) else None
        label = branch[len("refs/heads/"):] if branch else "detached"
        if inside(path, CODEX_WORKTREES):
            seen_codex.add(path.resolve())
            tidy_codex_worktree(repo, entry, path, refs, apply, now, in_use, report, done)
            continue
        if "locked" in entry:                # a running Claude Code session; never removed
            if "prunable" not in entry:
                _, merged, age = worktree_state(repo, entry, refs, now)
                if not merged and age > STALE_DAYS * 86400:
                    report.append(f"{repo.name}: open worktree {path} ({label}, unmerged work, "
                                  f"idle {int(age // 86400)} days{lock_note(entry)}); finish, adopt or delete")
            continue
        if "prunable" in entry:
            report.append(f"{repo.name}: worktree folder missing: {path} ({label}); if it was moved, "
                          f"run `git -C {repo} worktree repair <new path>`; if deleted, check, then prune")
            continue
        if not any(inside(path, repo / place) for place in TIDY_DIRS):
            note = idle_note(repo, entry, refs, now)
            report.append(f"{repo.name}: worktree outside the repository: {path} ({label}){note}; when idle: "
                          f"git -C {repo} worktree move {path} {repo}/.worktrees/{path.name}")
            continue
        gitdir, merged, age = worktree_state(repo, entry, refs, now)
        if not merged or age <= GRACE:
            if not merged and age > STALE_DAYS * 86400:
                report.append(f"{repo.name}: open worktree {path} ({label}, unmerged work, "
                              f"idle {int(age // 86400)} days); finish, adopt or delete")
            continue
        ignored = []
        blocker = removal_blocker(path, gitdir, in_use, ignored)
        if blocker:
            report.append(f"{repo.name}: finished worktree kept: {path} ({label}): {blocker}")
        elif not apply:
            parts = [name for name, present in ((".work", (path / ".work").exists()),
                                                (f"{len(ignored)} ignored files", bool(ignored))) if present]
            archive = f"would archive {' and '.join(parts)} and " if parts else ""
            report.append(f"{repo.name}: finished worktree {path} ({label}) {archive}would be removed")
        else:
            source = path / ".work"
            if (source.exists() or source.is_symlink()) and not archive_work(repo, path, report):
                continue
            saved = archive_ignored(repo, path, ignored, report) if ignored else None
            if ignored and not saved:
                continue
            # The blocker checked all changes; --force also discards disposable session files.
            admit()
            result = git(repo, "worktree", "remove", "--force", str(path))
            if result.returncode == 0:
                kept = f"; archived {len(ignored)} ignored files to {saved}" if saved else ""
                done.append(f"{repo.name}: removed finished worktree {path} ({label}){kept}")
                checked_out.discard(branch)
            else:
                report.append(f"{repo.name}: could not remove {path}: {result.stderr.strip()}")
    if not refs:
        return
    for ref in git(repo, "for-each-ref", "--format=%(refname)", "refs/heads/").stdout.split():
        short = ref[len("refs/heads/"):]
        if ref in checked_out or short in ("main", "master") or now - ref_updated(repo, ref) <= GRACE:
            continue
        tip = git(repo, "rev-parse", ref).stdout.strip()
        if not all_contained(repo, {tip} | reflog_commits(repo, ref), refs):
            continue
        if not apply:
            report.append(f"{repo.name}: merged branch {short} would be deleted")
            continue
        # Safe: the tip and every commit in the branch's reflog are reachable from a default ref.
        admit()
        result = git(repo, "branch", "-D", short)
        if result.returncode == 0:
            done.append(f"{repo.name}: deleted merged branch {short}")
        else:
            report.append(f"{repo.name}: could not delete branch {short}: {result.stderr.strip()}")


def check_folders(report: list[str]) -> None:
    """Only repositories belong in ~/dev_workspace and ~/cortex; a second clone of a local repo is a stray copy."""
    for root in (WORKSPACE, CORTEX):
        if not root.is_dir():
            continue
        for entry in sorted(root.iterdir()):
            if (entry / ".git").is_file():
                continue                     # a worktree; reported with its repository
            if not (entry / ".git").is_dir():
                report.append(f"{root.name}/{entry.name}: not a project repository; scratch belongs in "
                              f"/tmp/claude-1001/scratch, project files in the project's repo")
                continue
            origin = git(entry, "remote", "get-url", "origin").stdout.strip()
            if origin and "://" not in origin and ":" not in origin and Path(origin).is_dir():
                report.append(f"{root.name}/{entry.name}: second checkout of {origin}; use a worktree "
                              f"inside that repository instead")


def check_project_data(report: list[str]) -> None:
    """Every ~/project-data path must be declared, with a reason, in some repo's .project-data file."""
    if not PROJECT_DATA.is_dir():
        return
    declared: set[str] = set()
    for repo in repos():
        file = repo / DECLARATION
        if file.is_file():
            for line in file.read_text().splitlines():
                path = line.split("#", 1)[0].strip().strip("/")
                if path:
                    declared.add(path)
    seen_file = STATE / "project-data-seen.json"
    seen = set(json.loads(seen_file.read_text())) if seen_file.exists() else set()
    current = set()
    for top in sorted(PROJECT_DATA.iterdir()):
        if top.name in declared:
            continue
        children = sorted(top.iterdir()) if top.is_dir() else []
        missing = [child.name for child in children if f"{top.name}/{child.name}" not in declared]
        if not children or len(missing) == len(children):
            current.add(top.name)
            if top.name not in seen:
                report.append(f"project-data/{top.name}: not declared by any project")
        elif missing:
            fresh = [name for name in missing if f"{top.name}/{name}" not in seen]
            current.update(f"{top.name}/{name}" for name in missing)
            if fresh:
                report.append(f"project-data/{top.name}: undeclared {', '.join(fresh)}")
    STATE.mkdir(parents=True, exist_ok=True)
    seen_file.write_text(json.dumps(sorted(current)) + "\n")


def check_codex_orphans(seen: set[Path], report: list[str]) -> None:
    """Report Codex worktree directories not registered by any repository we inspected."""
    if not CODEX_WORKTREES.is_dir():
        return
    for marker in CODEX_WORKTREES.rglob(".git"):
        path = marker.parent.resolve()
        if path not in seen:
            report.append(f"Codex worktree kept: {path}: not registered to a repository under the managed roots")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.epilog = ("Archives skip databases, files over 50 MB and caches; report archive pruning, or prune with --apply. "
                     "Databases and big files inside caches are included in the cache entry without individual hashes.")
    parser.add_argument("--apply", action="store_true",
                        help="remove finished worktrees and merged branches (otherwise report only)")
    args = parser.parse_args()
    if args.apply: admit()
    now, report, done = time.time(), [], []
    archive_helpers()['prune_evidence_archive'](HOME / '.local/state/task/archive', args.apply, report, admit=admit)
    in_use = paths_in_use()
    seen_codex = set()
    for repo in repos():
        tidy_repo(repo, args.apply, now, in_use, report, done, seen_codex)
    check_codex_orphans(seen_codex, report)
    check_folders(report)
    check_project_data(report)
    lines = [f"workspace-tidy {time.strftime('%Y-%m-%d %H:%M')} ({'apply' if args.apply else 'report'})"]
    lines += [f"done: {item}" for item in done] + [f"check: {item}" for item in report]
    if not done and not report:
        lines.append("all tidy")
    text = "\n".join(lines) + "\n"
    print(text, end="")
    try:
        STATE.mkdir(parents=True, exist_ok=True)
        (STATE / "report.txt").write_text(text)
    except OSError as error:
        print(f"workspace-tidy: cannot write the report: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    try: sys.exit(main())
    except (OSError, subprocess.CalledProcessError) as error:
        print(f'workspace-tidy: refused: hold: {error}', file=sys.stderr); sys.exit(1)
