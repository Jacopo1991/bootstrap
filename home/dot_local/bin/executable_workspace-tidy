#!/usr/bin/env python3
"""workspace-tidy: keep every project to its two repositories (code and cortex-kb).

Removes only what is provably finished: linked worktrees that are clean, unlocked,
older than a day and already contained in the default branch, and local branches
whose commits are all in it. Reports everything else for the PM. Never touches
~/project-data, plain folders, locked worktrees or the Codex app's own worktrees
($CODEX_HOME/worktrees, which the app snapshots and cleans itself).

Usage: workspace-tidy            report only
       workspace-tidy --apply    also remove finished worktrees and merged branches
The report is also written to ~/.local/state/workspace-tidy/report.txt.
"""
import argparse
import os
import subprocess
import sys
import time
from pathlib import Path

HOME = Path(os.environ.get("HOME", "/home/agent"))
WORKSPACE = HOME / "dev_workspace"
CORTEX = HOME / "cortex"
PROJECT_DATA = HOME / "project-data"
CODEX_WORKTREES = Path(os.environ.get("CODEX_HOME") or HOME / ".codex") / "worktrees"
STATE = HOME / ".local/state/workspace-tidy"
DECLARATION = ".project-data"
GRACE = 24 * 3600          # never touch anything created or moved in the last day
STALE_DAYS = 7             # report open worktrees idle longer than this
DEFAULT_REFS = ("refs/heads/main", "refs/heads/master",
                "refs/remotes/origin/main", "refs/remotes/origin/master")


def git(repo: Path, *args: str) -> subprocess.CompletedProcess:
    return subprocess.run(["git", "-C", str(repo), *args], capture_output=True, text=True,
                          timeout=120, stdin=subprocess.DEVNULL)


def repos() -> list[Path]:
    """Main checkouts directly under ~/dev_workspace and ~/cortex."""
    found = []
    for root in (WORKSPACE, CORTEX):
        if root.is_dir():
            found += [entry for entry in sorted(root.iterdir()) if (entry / ".git").is_dir()]
    return found


def inside(path: Path, parent: Path) -> bool:
    try:
        path.resolve().relative_to(parent.resolve())
        return True
    except ValueError:
        return False


def default_refs(repo: Path) -> list[str]:
    return [ref for ref in DEFAULT_REFS
            if git(repo, "show-ref", "--verify", "--quiet", ref).returncode == 0]


def merged(repo: Path, commit: str, refs: list[str]) -> bool:
    return bool(commit) and any(
        git(repo, "merge-base", "--is-ancestor", commit, ref).returncode == 0 for ref in refs)


def worktree_list(repo: Path) -> list[dict]:
    """All worktrees of a repository, main checkout first (git worktree list --porcelain)."""
    items, current = [], {}
    for line in git(repo, "worktree", "list", "--porcelain").stdout.splitlines() + [""]:
        if not line:
            if current:
                items.append(current)
            current = {}
            continue
        key, _, value = line.partition(" ")
        current[key] = value or True
    return items


def last_activity(repo: Path, path: Path, head: str) -> float:
    """Newest of: the worktree's creation (.git file), its HEAD log (checkouts, commits) and HEAD commit.
    Not the index: plain `git status` refreshes it."""
    times = []
    for candidate in (path / ".git",):
        if candidate.exists():
            times.append(candidate.stat().st_mtime)
    gitdir = git(path, "rev-parse", "--absolute-git-dir").stdout.strip()
    if gitdir and (Path(gitdir) / "logs/HEAD").exists():
        times.append((Path(gitdir) / "logs/HEAD").stat().st_mtime)
    stamp = git(repo, "log", "-1", "--format=%ct", head).stdout.strip()
    if stamp.isdigit():
        times.append(float(stamp))
    return max(times) if times else time.time()


def ref_updated(repo: Path, ref: str) -> float:
    """When the branch last moved (its reflog), else its tip commit time."""
    line = git(repo, "reflog", "show", "--date=unix", "-1", ref).stdout
    for token in line.replace("{", " ").replace("}", " ").split():
        if token.isdigit() and len(token) >= 9:
            return float(token)
    stamp = git(repo, "log", "-1", "--format=%ct", ref).stdout.strip()
    return float(stamp) if stamp.isdigit() else time.time()


def tidy_repo(repo: Path, apply: bool, now: float, report: list[str], done: list[str]) -> None:
    git(repo, "worktree", "prune")          # forget worktrees whose folder is already gone
    refs = default_refs(repo)
    checked_out: set[str] = set()
    entries = worktree_list(repo)
    for entry in entries:
        if isinstance(entry.get("branch"), str):
            checked_out.add(entry["branch"])
    for entry in entries[1:]:               # the first entry is the main checkout
        path = Path(entry["worktree"])
        branch = entry.get("branch") if isinstance(entry.get("branch"), str) else None
        label = branch[len("refs/heads/"):] if branch else "detached"
        if inside(path, CODEX_WORKTREES):
            continue                         # the Codex app manages these itself
        if "locked" in entry or "prunable" in entry:
            continue                         # Claude Code locks worktrees while a session runs
        status = git(path, "--no-optional-locks", "status", "--porcelain")
        if status.returncode != 0:
            report.append(f"{repo.name}: cannot read worktree {path}")
            continue
        dirty = bool(status.stdout.strip())
        head = entry.get("HEAD", "") if isinstance(entry.get("HEAD"), str) else ""
        age = now - last_activity(repo, path, head)
        finished = refs and not dirty and merged(repo, head, refs)
        if finished and age > GRACE:
            if apply:
                result = git(repo, "worktree", "remove", str(path))
                if result.returncode == 0:
                    done.append(f"{repo.name}: removed finished worktree {path} ({label})")
                    if branch:
                        checked_out.discard(branch)
                else:
                    report.append(f"{repo.name}: could not remove {path}: {result.stderr.strip()}")
            else:
                report.append(f"{repo.name}: finished worktree {path} ({label}) would be removed")
            continue
        state = "dirty" if dirty else ("unmerged" if not finished else "finished, active in the last day")
        if not inside(path, repo):
            report.append(f"{repo.name}: worktree outside the repository: {path} ({label}, {state}); "
                          f"when idle: git -C {repo} worktree move {path} {repo}/.worktrees/{path.name}")
        elif age > STALE_DAYS * 86400:
            report.append(f"{repo.name}: open worktree {path} ({label}, {state}, idle {int(age // 86400)} days)")
    if not refs:
        return
    for ref in git(repo, "for-each-ref", "--format=%(refname)", "refs/heads/").stdout.split():
        short = ref[len("refs/heads/"):]
        if ref in checked_out or short in ("main", "master"):
            continue
        tip = git(repo, "rev-parse", ref).stdout.strip()
        if not merged(repo, tip, refs) or now - ref_updated(repo, ref) <= GRACE:
            continue
        if apply:
            # Safe: every commit on the branch is already reachable from the default branch.
            result = git(repo, "branch", "-D", short)
            if result.returncode == 0:
                done.append(f"{repo.name}: deleted merged branch {short}")
            else:
                report.append(f"{repo.name}: could not delete branch {short}: {result.stderr.strip()}")
        else:
            report.append(f"{repo.name}: merged branch {short} would be deleted")


def check_folders(report: list[str]) -> None:
    """Only repositories belong in ~/dev_workspace and ~/cortex; a second clone of a local repo is a stray copy."""
    for root in (WORKSPACE, CORTEX):
        if not root.is_dir():
            continue
        for entry in sorted(root.iterdir()):
            if (entry / ".git").is_file():
                continue                     # a worktree; reported with its repository
            if not (entry / ".git").is_dir():
                report.append(f"{root.name}/{entry.name}: not a project repository; scratch belongs in "
                              f"/tmp/claude-1001/scratch, project files in the project's repo")
                continue
            origin = git(entry, "remote", "get-url", "origin").stdout.strip()
            if origin and "://" not in origin and ":" not in origin and Path(origin).is_dir():
                report.append(f"{root.name}/{entry.name}: second checkout of {origin}; use a worktree "
                              f"inside that repository instead")


def check_project_data(report: list[str]) -> None:
    """Every ~/project-data path must be declared, with a reason, in some repo's .project-data file."""
    if not PROJECT_DATA.is_dir():
        return
    declared: set[str] = set()
    for repo in repos():
        file = repo / DECLARATION
        if file.is_file():
            for line in file.read_text().splitlines():
                path = line.split("#", 1)[0].strip().strip("/")
                if path:
                    declared.add(path)
    for top in sorted(PROJECT_DATA.iterdir()):
        if top.name in declared:
            continue
        children = sorted(top.iterdir()) if top.is_dir() else []
        missing = [child.name for child in children if f"{top.name}/{child.name}" not in declared]
        if not children or len(missing) == len(children):
            report.append(f"project-data/{top.name}: not declared by any project")
        elif missing:
            report.append(f"project-data/{top.name}: undeclared {', '.join(missing)}")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("--apply", action="store_true",
                        help="remove finished worktrees and merged branches (otherwise report only)")
    args = parser.parse_args()
    now, report, done = time.time(), [], []
    for repo in repos():
        tidy_repo(repo, args.apply, now, report, done)
    check_folders(report)
    check_project_data(report)
    lines = [f"workspace-tidy {time.strftime('%Y-%m-%d %H:%M')} ({'apply' if args.apply else 'report'})"]
    lines += [f"done: {item}" for item in done] + [f"check: {item}" for item in report]
    if not done and not report:
        lines.append("all tidy")
    text = "\n".join(lines) + "\n"
    print(text, end="")
    try:
        STATE.mkdir(parents=True, exist_ok=True)
        (STATE / "report.txt").write_text(text)
    except OSError as error:
        print(f"workspace-tidy: cannot write the report: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
